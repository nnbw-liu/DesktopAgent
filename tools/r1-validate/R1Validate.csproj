<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>SDemo.R1Validate</RootNamespace>
    <NoWarn>$(NoWarn);CA1416</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <!-- 读取 settings.json 里的 DPAPI 加密 Key（只有 live 模式需要）。 -->
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.0.1" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\App\SDemo.DesktopAgent.Core\SDemo.DesktopAgent.Core.csproj" />
    <ProjectReference Include="..\..\src\Storage\SDemo.DesktopAgent.Storage\SDemo.DesktopAgent.Storage.csproj" />
  </ItemGroup>
</Project>
