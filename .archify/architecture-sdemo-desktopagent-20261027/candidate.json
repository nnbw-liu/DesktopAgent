  "cards": [
    {
      "title": "分层依赖顺序（单向）",
      "items": [
        "Contracts → Editing / Context / Execution / Sandbox / Agents / Plugins",
        "→ Tools（各工具包）→ Storage",
        "→ Core（组合根）→ UI / Hosts"
      ]
    },
    {
      "title": "双宿主共用一套 UI",
      "items": [
        "WPF 为主入口；MAUI Windows 默认、Android 可选",
        "平台差异收敛为 5 个接口：IAppPaths / ISecureStore / ISystemThemeProvider / IFolderPickerService / IAppEnvironmentService",
        "平台实现集中在 Sandbox.Windows / Execution.Windows / Tools.Windows"
      ]
    },
    {
      "title": "Agent 与插件",
      "items": [
        "Agent 入口唯一：IAgentRuntime（src/Agents）",
        "Microsoft.Agents.AI 1.25.0 + OpenAI 兼容协议流式输出",
        "插件：Plugins.Abstractions → Plugins.Runtime（扫描/校验/注册表/提示词组装）",
        "内置插件 Translate / Summarize / QuickAsk 以嵌入资源分发"
      ]
    }
  ]
