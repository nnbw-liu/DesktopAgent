<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Windows 专属实现：WPF 与 MAUI-Windows 共用，Android 目标不引用本工程。 -->
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <RootNamespace>SDemo.DesktopAgent.Platform.Windows</RootNamespace>
    <AssemblyName>SDemo.DesktopAgent.Windows</AssemblyName>
    <!-- 命名空间刻意不写成 SDemo.DesktopAgent.Windows：
         那会创建子命名空间 Windows，遮蔽 WinRT 的 Windows.*（Windows.Storage / Windows.Foundation），
         使 MAUI-Windows 宿主里所有 SDemo.DesktopAgent.* 命名空间内的 WinRT 引用失效。 -->
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\SDemo.DesktopAgent.Core\SDemo.DesktopAgent.Core.csproj" />
    <ProjectReference Include="..\SDemo.DesktopAgent.Sandbox.Contracts\SDemo.DesktopAgent.Sandbox.Contracts.csproj" />
  </ItemGroup>

</Project>
