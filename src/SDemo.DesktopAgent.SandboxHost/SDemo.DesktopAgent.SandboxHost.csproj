<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- 沙箱内的 console helper。只引用契约，不引用 Core，保持自包含发布的体积最小。 -->
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <OutputType>Exe</OutputType>
    <RootNamespace>SDemo.DesktopAgent.SandboxHost</RootNamespace>
    <AssemblyName>SDemo.DesktopAgent.SandboxHost</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\SDemo.DesktopAgent.Sandbox.Contracts\SDemo.DesktopAgent.Sandbox.Contracts.csproj" />
  </ItemGroup>

</Project>
