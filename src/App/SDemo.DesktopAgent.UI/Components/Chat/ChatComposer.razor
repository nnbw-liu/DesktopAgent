@using System.IO
@using Microsoft.AspNetCore.Components.Forms
@using SDemo.DesktopAgent.Models
@inject IJSRuntime Js
@inject AttachmentStore AttachmentStore
@inject IComposerReferenceIndex References
@implements IAsyncDisposable

@* 组合输入框：Header（工作区 / 附件） / 文本输入 / 上传 + 技能 + 搜索 + 模型 + 发送 *@
<div class="composer">
    @if (HeaderContent is not null || _attachments.Count > 0)
    {
        <div class="composer-header">
            @HeaderContent

            @if (_attachments.Count > 0)
            {
                <div class="composer-attachments">
                    @foreach (var attachment in _attachments)
                    {
                        <span class="attachment-chip" title="@attachment.FilePath">
                            <svg class="attachment-icon" viewBox="0 0 16 16" aria-hidden="true">
                                <path d="M9.9 4.2 5.3 8.8a1.6 1.6 0 0 0 2.3 2.3l4.9-4.9a2.6 2.6 0 0 0-3.7-3.7L3.7 7.6a4 4 0 0 0 5.7 5.7l4-4"
                                      fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round" />
                            </svg>
                            <span class="attachment-name">@attachment.FileName</span>
                            <span class="attachment-size">@AttachmentStore.FormatSize(attachment.Size)</span>
                            @if (attachment.PageCount is int pageCount)
                            {
                                <span class="attachment-size" title="PDF 页数">@pageCount 页</span>
                            }
                            <button type="button" class="attachment-remove" title="移除附件" @onclick="() => RemoveAttachment(attachment)">✕</button>
                        </span>
                    }
                </div>
            }
        </div>
    }

    @if (_mention is not null && _mentionItems.Count > 0)
    {
        <div class="composer-menu" role="listbox" aria-label="文件引用">
            @for (var index = 0; index < _mentionItems.Count; index++)
            {
                var item = _mentionItems[index];
                var selected = index == _selected;

                <button type="button"
                        class="composer-menu-row @(selected ? "is-active" : null)"
                        role="option"
                        aria-selected="@(selected ? "true" : "false")"
                        @onclick="() => CommitAsync(index)">
                    <span class="composer-menu-icon" aria-hidden="true">@(item.EndsWith('/') ? "▸" : "·")</span>
                    <span class="composer-menu-label">@item</span>
                </button>
            }

            <div class="composer-menu-hint">↑↓ 选择 · Enter 插入 · Esc 关闭</div>
        </div>
    }

    <textarea @ref="_inputRef"
              class="composer-text"
              rows="1"
              placeholder="@Placeholder"
              value="@Text"
              @oninput="HandleInput"></textarea>

    <div class="composer-footer">
        <div class="composer-tools">
            <label class="composer-plus @(IsGenerating ? "is-disabled" : null)" title="上传文件（可多选）">
                <InputFile OnChange="HandleFilesSelected" multiple class="composer-file-input" />
                <svg class="icon" viewBox="0 0 16 16" aria-hidden="true">
                    <path d="M8 3.2v9.6M3.2 8h9.6" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
                </svg>
            </label>

            @if (ActiveMount is not null)
            {
                @* 插件模式：只留一个 chip + 内联参数，全局技能区整块隐藏 *@
                <span class="skill-chip is-on plugin-chip" title="@ActivePlugin?.Description">
                    <span class="plugin-chip-icon">@(ActivePlugin?.Initial ?? "◆")</span>
                    <span class="skill-chip-label">@(ActivePlugin?.Name ?? ActiveMount.Capability?.Name ?? ActiveMount.Id)</span>
                    <button type="button" class="chip-close" title="取消插件" disabled="@IsGenerating" @onclick="ClearMount">✕</button>
                </span>

                @foreach (var parameter in VisibleParameters)
                {
                    <PluginParameterControl Parameter="parameter"
                                            Value="@GetParameterValue(parameter)"
                                            Disabled="@IsGenerating"
                                            ValueChanged="value => OnParameterChanged.InvokeAsync((parameter.Key, value))" />
                }

                @if (HiddenParameterCount > 0)
                {
                    <span class="plugin-param-more" title="其余参数使用默认值">还有 @HiddenParameterCount 项参数</span>
                }
            }
            else
            {
                @if (PluginMounts.Count > 0)
                {
                    <div class="skill-list">
                        @foreach (var mount in VisibleMounts)
                        {
                            <button type="button"
                                    class="skill-chip plugin-chip"
                                    title="@mount.Capability?.Name"
                                    disabled="@IsGenerating"
                                    @onclick="() => SelectMount(mount.Key)">
                                <span class="skill-chip-icon" aria-hidden="true">
                                    @if (PluginFor(mount.PluginId) is { } plugin)
                                    {
                                        <PluginIcon Plugin="plugin" />
                                    }
                                    else
                                    {
                                        @SkillInfo.GlyphOf(mount.Capability?.Name ?? mount.Id)
                                    }
                                </span>
                                <span class="skill-chip-label">@(mount.Capability?.Name ?? mount.Id)</span>
                            </button>
                        }

                        @if (HasMoreMounts)
                        {
                            <div class="skill-more">
                                <button type="button"
                                        class="skill-chip skill-chip--more @(_pluginMoreOpen ? "is-open" : null)"
                                        title="更多插件"
                                        aria-expanded="@(_pluginMoreOpen ? "true" : "false")"
                                        @onclick="TogglePluginMore">
                                    更多 <span class="skill-more-caret">▾</span>
                                </button>

                                @if (_pluginMoreOpen)
                                {
                                    <div class="skill-backdrop" @onclick="CloseMenus"></div>
                                    <div class="skill-menu">
                                        @foreach (var mount in HiddenMounts)
                                        {
                                            <button type="button"
                                                    class="skill-menu-entry"
                                                    title="@mount.Capability?.Name"
                                                    @onclick="() => SelectMount(mount.Key)">
                                                <span class="skill-menu-icon" aria-hidden="true">
                                                    @if (PluginFor(mount.PluginId) is { } plugin)
                                                    {
                                                        <PluginIcon Plugin="plugin" />
                                                    }
                                                    else
                                                    {
                                                        @SkillInfo.GlyphOf(mount.Capability?.Name ?? mount.Id)
                                                    }
                                                </span>
                                                <span class="skill-menu-text">
                                                    <span class="skill-menu-name">@(mount.Capability?.Name ?? mount.Id)</span>
                                                    <span class="skill-menu-desc">@(mount.Capability?.SkillDescription ?? mount.PluginId)</span>
                                                </span>
                                            </button>
                                        }
                                    </div>
                                }
                            </div>
                        }
                    </div>
                }

                @if (!string.IsNullOrEmpty(SelectedSkill))
                {
                    <span class="skill-chip is-on" title="@SelectedSkill">
                        <span class="skill-chip-icon" aria-hidden="true">@GlyphOf(SelectedSkill)</span>
                        <span class="skill-chip-label">@SelectedSkill</span>
                        <button type="button" class="chip-close" title="取消技能" @onclick="ClearSkill">✕</button>
                    </span>
                }
                else if (Skills.Count > 0)
                {
                    <div class="skill-list">
                        @foreach (var skill in VisibleSkills)
                        {
                            <button type="button"
                                    class="skill-chip"
                                    title="@skill.Description"
                                    @onclick="() => ToggleSkill(skill.Name)">
                                <span class="skill-chip-icon" aria-hidden="true">@skill.Glyph</span>
                                <span class="skill-chip-label">@skill.Name</span>
                            </button>
                        }

                        @if (HasMore)
                        {
                            <div class="skill-more">
                                <button type="button"
                                        class="skill-chip skill-chip--more @(_moreOpen ? "is-open" : null)"
                                        title="更多技能"
                                        aria-expanded="@(_moreOpen ? "true" : "false")"
                                        @onclick="ToggleMore">
                                    更多 <span class="skill-more-caret">▾</span>
                                </button>

                                @if (_moreOpen)
                                {
                                    <div class="skill-backdrop" @onclick="CloseMenus"></div>
                                    <div class="skill-menu">
                                        @foreach (var skill in Skills)
                                        {
                                            <button type="button"
                                                    class="skill-menu-entry @(IsSelected(skill.Name) ? "is-active" : null)"
                                                    title="@skill.Description"
                                                    @onclick="() => SelectSkill(skill.Name)">
                                                <span class="skill-menu-icon" aria-hidden="true">@skill.Glyph</span>
                                                <span class="skill-menu-text">
                                                    <span class="skill-menu-name">@skill.Name</span>
                                                    <span class="skill-menu-desc">@skill.Description</span>
                                                </span>
                                            </button>
                                        }
                                    </div>
                                }
                            </div>
                        }
                    </div>
                }
            }

            @if (_uploadError is not null)
            {
                <span class="composer-error">@_uploadError</span>
            }
        </div>

        <div class="composer-actions">
            @* 只有可选的外部工具（例如联网搜索）需要 chip；文件 / PDF / PowerShell 由模型自行决定是否调用。 *@
            @foreach (var pack in ToolPacks)
            {
                <button type="button"
                        class="composer-tool @(pack.Enabled ? "is-on" : null) @(pack.Available ? null : "is-unavailable")"
                        title="@pack.Title"
                        aria-pressed="@(pack.Enabled ? "true" : "false")"
                        disabled="@(!pack.Available)"
                        @onclick="() => OnToggleToolPack.InvokeAsync(pack.Id)">
                    <span class="composer-tool-glyph" aria-hidden="true">
                        @if (IsSearchPack(pack))
                        {
                            @* 搜索字形「⌕」在小字号下太细，改用和输入框同一套线条的放大镜 *@
                            <svg class="composer-tool-svg" viewBox="0 0 24 24" aria-hidden="true">
                                <circle cx="10.5" cy="10.5" r="6.4"
                                        fill="none" stroke="currentColor" stroke-width="1.8" />
                                <path d="M15.3 15.3 20.8 20.8"
                                      fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" />
                            </svg>
                        }
                        else
                        {
                            @pack.Glyph
                        }
                    </span>
                    <span class="composer-tool-name">@pack.Name</span>
                </button>
            }

            @FooterContent

            <button type="button"
                    class="composer-send @(IsGenerating ? "is-stop" : null)"
                    title="@(IsGenerating ? "停止生成" : "发送")"
                    disabled="@(!CanSubmit)"
                    @onclick="HandlePrimaryAction">
                @if (IsGenerating)
                {
                    <svg class="send-icon" viewBox="0 0 24 24" aria-hidden="true">
                        <rect x="7" y="7" width="10" height="10" rx="2.5" fill="currentColor" />
                    </svg>
                }
                else
                {
                    <svg class="send-icon" viewBox="0 0 24 24" aria-hidden="true">
                        <path d="M12 19V6M12 6l-5.5 5.5M12 6l5.5 5.5"
                              fill="none"
                              stroke="currentColor"
                              stroke-width="2"
                              stroke-linecap="round"
                              stroke-linejoin="round" />
                    </svg>
                }
            </button>
        </div>
    </div>
</div>

@code {
    private const int VisibleSkillCount = 3;
    private const int MaxInlineParameters = 2;
    private const int MaxFilesPerUpload = 10;

    /// <summary>输入框内容（支持 @bind-Text 双向绑定）。</summary>
    [Parameter]
    public string Text { get; set; } = string.Empty;

    [Parameter]
    public EventCallback<string> TextChanged { get; set; }

    /// <summary>生成中：同一个按钮切换为停止。</summary>
    [Parameter]
    public bool IsGenerating { get; set; }

    /// <summary>提交：文本 + 本次附件，由外层写入会话并落库。</summary>
    [Parameter]
    public EventCallback<ComposerSubmission> OnSend { get; set; }

    [Parameter]
    public EventCallback OnStop { get; set; }

    /// <summary>顶部 Header 区域的内容；为 null 时整块不渲染、不占高度。</summary>
    [Parameter]
    public RenderFragment? HeaderContent { get; set; }

    /// <summary>底部功能区里、发送按钮左侧的内容（例如模型选择器）。</summary>
    [Parameter]
    public RenderFragment? FooterContent { get; set; }

    /// <summary>常用技能列表（来自本地技能库）。</summary>
    [Parameter]
    public IReadOnlyList<SkillInfo> Skills { get; set; } = [];

    /// <summary>当前选中的技能名；为空表示不套用技能。</summary>
    [Parameter]
    public string? SelectedSkill { get; set; }

    [Parameter]
    public EventCallback<string?> OnSelectSkill { get; set; }

    /// <summary>输入框里可选的外部工具 chip（内置能力不在这里显示）。</summary>
    [Parameter]
    public IReadOnlyList<ToolPackChip> ToolPacks { get; set; } = [];

    /// <summary>开关一个可选工具包（只切换本轮是否交给模型）。</summary>
    [Parameter]
    public EventCallback<string> OnToggleToolPack { get; set; }

    /// <summary>输入框里可用的插件入口（ChatRoom 已按可用性过滤）。</summary>
    [Parameter]
    public IReadOnlyList<PluginMount> PluginMounts { get; set; } = [];

    /// <summary>插件 id → 插件描述：列表里的插件 chip 用它画图标；缺项时退回名称首字。</summary>
    [Parameter]
    public IReadOnlyDictionary<string, PluginDescriptor> PluginById { get; set; } =
        new Dictionary<string, PluginDescriptor>();

    /// <summary>最多直接显示几个插件入口（来自设置 plugins.maxInComposer）。</summary>
    [Parameter]
    public int MaxVisiblePlugins { get; set; } = 3;

    /// <summary>当前选中的插件；为 null 表示全局模式（技能 + 插件入口都显示）。</summary>
    [Parameter]
    public PluginDescriptor? ActivePlugin { get; set; }

    /// <summary>当前选中的插件入口（与 <see cref="ActivePlugin"/> 一起由 ChatRoom 解析并传入）。</summary>
    [Parameter]
    public PluginMount? ActiveMount { get; set; }

    /// <summary>当前参数值（按会话记忆解析后的结果）。</summary>
    [Parameter]
    public IReadOnlyDictionary<string, string> ParameterValues { get; set; } =
        new Dictionary<string, string>(StringComparer.Ordinal);

    /// <summary>选中 / 取消插件入口；参数为 null 表示回到全局模式。</summary>
    [Parameter]
    public EventCallback<string?> OnSelectMount { get; set; }

    /// <summary>参数变化：(key, value)。</summary>
    [Parameter]
    public EventCallback<(string Key, string Value)> OnParameterChanged { get; set; }

    /// <summary>附件按会话存放，切换会话时清空未发送的附件。</summary>
    [Parameter]
    public string SessionId { get; set; } = string.Empty;

    /// <summary>当前工作区根目录；<c>@</c> 补全只在这个目录里找路径。</summary>
    [Parameter]
    public string? WorkspaceRoot { get; set; }

    [Parameter]
    public string Placeholder { get; set; } = "描述你的任务，Enter 发送，Shift + Enter 换行…";

    private readonly List<ChatAttachment> _attachments = [];
    private string _sessionId = string.Empty;
    private bool _moreOpen;
    private bool _pluginMoreOpen;
    private string? _uploadError;
    private DotNetObjectReference<ChatComposer>? _selfReference;
    private ElementReference _inputRef;

    /// <summary>最多显示几条 <c>@</c> 候选。</summary>
    private const int MaxMentionItems = 8;

    /// <summary>当前正在输入的 <c>@</c> token；null 表示菜单关着。</summary>
    private ComposerTrigger? _mention;

    private IReadOnlyList<string> _mentionItems = [];

    private int _selected;

    /// <summary>刚插入过一次引用：不要让紧接着的 input 事件再把菜单弹出来。</summary>
    private bool _suppressTrigger;

    private IEnumerable<SkillInfo> VisibleSkills => Skills.Take(VisibleSkillCount);

    private bool HasMore => Skills.Count > VisibleSkillCount;

    /// <summary>最多内联 N 个插件入口，其余进「更多」（N 来自设置）。</summary>
    private IEnumerable<PluginMount> VisibleMounts =>
        PluginMounts.Take(Math.Max(1, MaxVisiblePlugins));

    private IEnumerable<PluginMount> HiddenMounts =>
        PluginMounts.Skip(Math.Max(1, MaxVisiblePlugins));

    private bool HasMoreMounts => PluginMounts.Count > Math.Max(1, MaxVisiblePlugins);

    /// <summary>参数 ≤ 2 个时全部内联，其余用默认值（面板留到 M4 / 气泡的那个浮层）。</summary>
    private IEnumerable<PluginParameter> VisibleParameters =>
        ActiveMount?.Capability?.Parameters.Take(MaxInlineParameters) ?? [];

    private int HiddenParameterCount =>
        Math.Max(0, (ActiveMount?.Capability?.Parameters.Count ?? 0) - MaxInlineParameters);

    private string GetParameterValue(PluginParameter parameter) =>
        ParameterValues.TryGetValue(parameter.Key, out var value) ? value : parameter.Default ?? string.Empty;

    private async Task SelectMount(string mountKey)
    {
        _pluginMoreOpen = false;
        _moreOpen = false;
        await OnSelectMount.InvokeAsync(mountKey);
    }

    private async Task ClearMount()
    {
        _pluginMoreOpen = false;
        await OnSelectMount.InvokeAsync(null);
    }

    private void TogglePluginMore()
    {
        _pluginMoreOpen = !_pluginMoreOpen;
        _moreOpen = false;
    }

    private bool CanSubmit => IsGenerating || !string.IsNullOrWhiteSpace(Text) || _attachments.Count > 0;

    protected override void OnParametersSet()
    {
        if (_sessionId == SessionId)
        {
            return;
        }

        _sessionId = SessionId;
        ClearAttachments();
        _moreOpen = false;
        _pluginMoreOpen = false;
        _uploadError = null;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        // 键盘约定由 JS 处理（Enter 发送 / Shift、Ctrl+Enter 换行），这里注册回调。
        _selfReference = DotNetObjectReference.Create(this);
        await Js.InvokeVoidAsync("sdComposer.attach", _selfReference);
    }

    /// <summary>Enter 键触发：与点击发送按钮走同一条路径。</summary>
    [JSInvokable]
    public async Task HandleEnterAsync()
    {
        await CloseMentionAsync();
        await HandlePrimaryAction();
    }

    /// <summary>菜单方向键：在候选里上下移动。</summary>
    [JSInvokable]
    public void MenuMoveAsync(int delta)
    {
        if (_mentionItems.Count == 0)
        {
            return;
        }

        _selected = ((_selected + delta) % _mentionItems.Count + _mentionItems.Count) % _mentionItems.Count;
        StateHasChanged();
    }

    /// <summary>菜单确认：目录继续下钻，文件插入并关闭。</summary>
    [JSInvokable]
    public Task MenuCommitAsync() => CommitAsync(_selected);

    /// <summary>菜单关闭。</summary>
    [JSInvokable]
    public Task MenuDismissAsync() => CloseMentionAsync();

    private async Task CommitAsync(int index)
    {
        if (_mention is not { } trigger || index < 0 || index >= _mentionItems.Count)
        {
            return;
        }

        var item = _mentionItems[index];
        var isDirectory = item.EndsWith('/');
        var insert = isDirectory
            ? ComposerTriggers.FormatDirectoryMention(item)
            : ComposerTriggers.FormatMention(item) + " ";

        // 目录保留菜单：让 input 事件重新识别 `@"dir/`，直接进入下一层。
        _suppressTrigger = !isDirectory;

        await ReplaceRangeAsync(trigger.Start, trigger.Caret, insert);

        if (isDirectory)
        {
            // 目录：菜单内容由下一次 HandleInput 重算。
            return;
        }

        await CloseMentionAsync();
    }

    private async Task ReplaceRangeAsync(int start, int end, string text)
    {
        // 文本在 C# 里算：界面、测试、回灌都拿到同一份结果，不依赖 JS 的返回值。
        var from = Math.Clamp(start, 0, Text.Length);
        var to = Math.Clamp(end, from, Text.Length);

        Text = string.Concat(Text.AsSpan(0, from), text, Text.AsSpan(to));

        if (TextChanged.HasDelegate)
        {
            await TextChanged.InvokeAsync(Text);
        }

        try
        {
            await Js.InvokeVoidAsync("sdComposer.replaceRange", _inputRef, from, to, text);
        }
        catch (JSDisconnectedException)
        {
            // WebView 已释放：文本已经更新，DOM 同步跳过。
        }
    }

    private async Task CloseMentionAsync()
    {
        if (_mention is null && _mentionItems.Count == 0)
        {
            return;
        }

        _mention = null;
        _mentionItems = [];
        _selected = 0;
        await SetMenuOpenAsync(false);
        StateHasChanged();
    }

    private async Task SetMenuOpenAsync(bool open)
    {
        try
        {
            await Js.InvokeVoidAsync("sdComposer.setMenuOpen", open);
        }
        catch (JSDisconnectedException)
        {
            // WebView 已释放。
        }
    }

    /// <summary>按光标位置重算 <c>@</c> 候选；没有触发符就关菜单。</summary>
    private async Task RefreshMentionAsync()
    {
        if (_suppressTrigger)
        {
            _suppressTrigger = false;
            return;
        }

        int caret;

        try
        {
            caret = await Js.InvokeAsync<int>("sdComposer.caretOf", _inputRef);
        }
        catch (JSDisconnectedException)
        {
            return;
        }

        var trigger = ComposerTriggers.Detect(Text, caret);

        if (trigger is not { Kind: ComposerTriggerKind.Mention })
        {
            await CloseMentionAsync();
            return;
        }

        var candidates = References.List(WorkspaceRoot);

        // 输入里带 `/` 时按前缀下钻，别让子序列把别的目录也算进来。
        if (trigger.Query.Contains('/'))
        {
            candidates = candidates
                .Where(item => item.StartsWith(trigger.Query, StringComparison.OrdinalIgnoreCase))
                .ToArray();
        }

        var items = ComposerMatch.Rank(candidates, item => item, trigger.Query, MaxMentionItems);

        _mention = trigger;
        _mentionItems = items;
        _selected = Math.Clamp(_selected, 0, Math.Max(0, items.Count - 1));

        await SetMenuOpenAsync(items.Count > 0);
        StateHasChanged();
    }

    private async Task HandleInput(ChangeEventArgs args)
    {
        Text = args.Value?.ToString() ?? string.Empty;

        if (TextChanged.HasDelegate)
        {
            await TextChanged.InvokeAsync(Text);
        }

        await RefreshMentionAsync();
    }

    private async Task HandleFilesSelected(InputFileChangeEventArgs args)
    {
        if (IsGenerating)
        {
            return;
        }

        _uploadError = null;

        IReadOnlyList<IBrowserFile> files;
        try
        {
            files = args.GetMultipleFiles(MaxFilesPerUpload);
        }
        catch (InvalidOperationException)
        {
            _uploadError = $"一次最多上传 {MaxFilesPerUpload} 个文件";
            return;
        }

        foreach (var file in files)
        {
            try
            {
                _attachments.Add(await AttachmentStore.SaveAsync(file, SessionId));
            }
            catch (IOException)
            {
                _uploadError = $"「{file.Name}」超过 25 MB，未上传";
            }
            catch (Exception ex) when (ex is InvalidOperationException or ArgumentException)
            {
                _uploadError = $"「{file.Name}」上传失败：{ex.Message}";
            }
        }
    }

    private void RemoveAttachment(ChatAttachment attachment)
    {
        _attachments.Remove(attachment);
        AttachmentStore.Delete(attachment);
    }

    private async Task ToggleSkill(string name)
    {
        var next = string.Equals(SelectedSkill, name, StringComparison.Ordinal) ? null : name;
        _moreOpen = false;
        await OnSelectSkill.InvokeAsync(next);
    }

    private async Task SelectSkill(string name)
    {
        _moreOpen = false;
        await OnSelectSkill.InvokeAsync(name);
    }

    private async Task ClearSkill()
    {
        _moreOpen = false;
        await OnSelectSkill.InvokeAsync(null);
    }

    private void ToggleMore() => _moreOpen = !_moreOpen;

    private void CloseMenus() => _moreOpen = false;

    private void ClearAttachments()
    {
        foreach (var attachment in _attachments)
        {
            AttachmentStore.Delete(attachment);
        }

        _attachments.Clear();
    }

    private PluginDescriptor? PluginFor(string pluginId) =>
        PluginById.TryGetValue(pluginId, out var plugin) ? plugin : null;

    /// <summary>联网搜索在 UI 里用矢量放大镜；其它工具仍用工具包提供的字形。</summary>
    private static bool IsSearchPack(ToolPackChip pack) =>
        string.Equals(pack.Id, "search", StringComparison.Ordinal);

    /// <summary>已选技能的字形：优先用技能列表里的 icon；技能文件被删时退回名字首字。</summary>
    private string GlyphOf(string name) =>
        Skills.FirstOrDefault(skill => string.Equals(skill.Name, name, StringComparison.Ordinal))?.Glyph
        ?? SkillInfo.GlyphOf(name);

    private bool IsSelected(string name) =>
        string.Equals(SelectedSkill, name, StringComparison.Ordinal);

    private async Task HandlePrimaryAction()
    {
        if (IsGenerating)
        {
            await OnStop.InvokeAsync();
            return;
        }

        if (string.IsNullOrWhiteSpace(Text) && _attachments.Count == 0)
        {
            return;
        }

        // 发送前一定收起补全菜单，否则下一条消息的第一次输入会带着旧候选。
        await CloseMentionAsync();

        // 先清空附件再提交：生成期间切换会话 / 销毁组件时，不会把已发送的文件删掉。
        var submission = new ComposerSubmission(Text.Trim(), _attachments.ToList());
        _attachments.Clear();
        _moreOpen = false;
        StateHasChanged();

        await OnSend.InvokeAsync(submission);
    }

    public async ValueTask DisposeAsync()
    {
        try
        {
            await Js.InvokeVoidAsync("sdComposer.detach");
        }
        catch (JSDisconnectedException)
        {
            // WebView 已释放。
        }

        // 还没发出去的附件没有消息引用，直接删掉。
        ClearAttachments();
        _selfReference?.Dispose();
    }
}
