@using System.Diagnostics
@using System.IO
@using SDemo.DesktopAgent.Context
@using SDemo.DesktopAgent.Execution
@using SDemo.DesktopAgent.Models
@using SDemo.DesktopAgent.Sandbox
@using Microsoft.AspNetCore.Components
@inject IJSRuntime Js
@inject ISettingsService Settings
@inject IAgentSessionRunner Runner
@inject IToolApprovalService Approvals
@inject AgentToolRegistry ToolRegistry
@inject ISandboxJobService Sandbox
@inject SkillCatalog SkillCatalog
@inject PluginRegistry Registry
@inject PluginParameterResolver ParameterResolver
@inject IPluginRunner PluginRunner
@inject WorkspaceContext WorkspaceContext
@inject SessionArchiveService ArchiveService
@inject IWorkspaceMemory Memory
@implements IDisposable

@* 聊天室：空会话（欢迎语 + 输入框，垂直居中）与有记录会话（标题 / 消息区 / 输入框）共用本组件 *@
<section class="chat @(IsEmpty ? "chat--empty" : null) @(IsActive ? null : "chat--hidden")">
    @if (IsEmpty)
    {
        @* 空聊天室没有标题栏，设置入口固定在右上角。 *@
        <div class="chat-empty-actions">
            <button type="button"
                    class="chat-menu-button chat-settings-button"
                    title="聊天室设置"
                    aria-label="聊天室设置"
                    @onclick="() => OnOpenSessionSettings.InvokeAsync()">
                <svg class="icon" viewBox="0 0 16 16" aria-hidden="true">
                    <circle cx="8" cy="8" r="2.1" fill="none" stroke="currentColor" stroke-width="1.25" />
                    <path d="M8 1.9v1.5M8 12.6v1.5M1.9 8h1.5M12.6 8h1.5M3.7 3.7l1.05 1.05M11.25 11.25l1.05 1.05M12.3 3.7l-1.05 1.05M4.75 11.25 3.7 12.3"
                          stroke="currentColor" stroke-width="1.25" stroke-linecap="round" />
                </svg>
            </button>
        </div>

        <div class="welcome">
            <h1>你好，我是 SDemo DesktopAgent</h1>
            <p>描述你的任务，我会在本地工作区里帮你完成。</p>
        </div>
    }
    else
    {
        <header class="chat-header">
            <h1 class="chat-title">@Session.Title</h1>

            @* P2：会话菜单（压缩现在 / 清空摘要）+ 摘要状态。 *@
            <div class="chat-header-actions">
                @if (Session.HasSummary)
                {
                    <span class="chat-summary-badge" title="较早的历史已压缩为摘要；原文仍保留，可点击分隔线查看">
                        已压缩 @Session.SummaryThroughOrder 条
                        @if (Session.SummaryIsFallback)
                        {
                            <span class="chat-summary-badge-note">自动摘要</span>
                        }
                    </span>
                }

                <button type="button"
                        class="chat-menu-button chat-settings-button"
                        title="聊天室设置"
                        aria-label="聊天室设置"
                        @onclick="() => OnOpenSessionSettings.InvokeAsync()">
                    <svg class="icon" viewBox="0 0 16 16" aria-hidden="true">
                        <circle cx="8" cy="8" r="2.1" fill="none" stroke="currentColor" stroke-width="1.25" />
                        <path d="M8 1.9v1.5M8 12.6v1.5M1.9 8h1.5M12.6 8h1.5M3.7 3.7l1.05 1.05M11.25 11.25l1.05 1.05M12.3 3.7l-1.05 1.05M4.75 11.25 3.7 12.3"
                              stroke="currentColor" stroke-width="1.25" stroke-linecap="round" />
                    </svg>
                </button>

                <div class="chat-menu-wrap">
                    <button type="button" class="chat-menu-button" title="会话操作" aria-haspopup="true" aria-expanded="@_sessionMenuOpen"
                            @onclick="ToggleSessionMenu">
                        ⋯
                    </button>

                    @if (_sessionMenuOpen)
                    {
                        <div class="item-menu chat-menu" role="menu">
                            <button type="button" class="item-menu-entry" role="menuitem"
                                    @onclick="CompactNowAsync">
                                压缩现在
                            </button>
                            <button type="button" class="item-menu-entry" role="menuitem"
                                    disabled="@(!Session.HasSummary)"
                                    @onclick="ClearSummaryAsync">
                                清空摘要
                            </button>
                            @if (!string.IsNullOrEmpty(Session.WorkspaceId))
                            {
                                <button type="button" class="item-menu-entry" role="menuitem"
                                        @onclick="ToggleArchiveAsync">
                                    @(Session.IsArchived ? "取消归档" : "归档到知识库")
                                </button>
                            }
                        </div>
                    }
                </div>
            </div>
        </header>

        <TodosPanel Todos="Session.Todos" />
        <VerificationBadge Session="Session" />

        <div class="chat-scroll" @ref="_scrollElement">
            <div class="chat-messages">
                @for (var messageIndex = 0; messageIndex < Session.Messages.Count; messageIndex++)
                {
                    var message = Session.Messages[messageIndex];
                    var isUser = message.Role == ChatMessageRole.User;
                    var isHostPrompt = IsHostPrompt(message);
                    var isContinuation = !isHostPrompt
                        && message.Role == ChatMessageRole.Assistant
                        && PreviousRenderedIsAssistant(messageIndex);
                    var thinking = !isHostPrompt && IsThinking(message);

                    @* 摘要覆盖到这条消息之前：插入「已压缩」分隔线（P2 §3.4）。 *@
                    @if (Session.HasSummary && messageIndex == Session.SummaryThroughOrder)
                    {
                        <CompactionDivider Count="@Session.SummaryThroughOrder"
                                           Tokens="@Session.SummaryTokens"
                                           IsFallback="@Session.SummaryIsFallback"
                                           OnOpen="OpenCompactedHistory" />
                    }

                    @* 宿主自动追加的「[宿主提示]」不是用户手打的，不占一个用户气泡，压成一行过程记录。 *@
                    @if (isHostPrompt)
                    {
                        <div class="host-prompt" title="@message.Content">
                            <span class="host-prompt-label">宿主追问</span>
                            <span class="host-prompt-text">@HostPromptPreview(message.Content)</span>
                        </div>
                    }
                    else
                    {
                    @* 普通气泡；续答（msg--cont）不重复角色名，视觉上并进上一块。 *@
                    <article class="msg @(isUser ? "msg--user" : "msg--assistant") @(isContinuation ? "msg--cont" : null)">
                        @if (!isContinuation)
                        {
                            <span class="msg-role">@RoleLabel(message)</span>
                        }

                        @{
                            // 有步骤时间线就按真实顺序渲染（思考→工具→思考→…→正文）；
                            // 老消息没有步骤时回退成「思考 / 工具 / 正文」分组显示。
                            var steps = isUser ? Array.Empty<ChatStep>() : StepsFor(message);
                            var hasTimeline = !isUser && steps.Count > 0;
                            var processPolicy = ProcessDisplayPolicy.From(Settings.Current.Chat);
                        }

                        @if (hasTimeline)
                        {
                            <ChatTimeline Steps="steps"
                                          Trace="message.ToolTrace"
                                          IsLive="@(thinking && _isGenerating)"
                                          Foldable="@CanFoldProcess(message, processPolicy)"
                                          ElapsedMs="message.DurationMs"
                                          Policy="processPolicy" />
                        }
                        else
                        {
                            @* 还没收到第一个增量：在回复里也给出「思考中」，而不是只在发送区显示停止按钮。 *@
                            @if (thinking && string.IsNullOrWhiteSpace(message.Reasoning))
                            {
                                <div class="msg-thinking" role="status" aria-live="polite">
                                    <span class="msg-thinking-dot"></span>
                                    <span>思考中…</span>
                                </div>
                            }

                            @if (!string.IsNullOrWhiteSpace(message.Reasoning))
                            {
                                var reasoningOpen = IsReasoningOpen(message.Id);

                                <div class="msg-reasoning @(thinking ? "is-thinking" : null)">
                                    <button type="button"
                                            class="reasoning-toggle"
                                            aria-expanded="@(reasoningOpen ? "true" : "false")"
                                            @onclick="() => ToggleReasoning(message.Id)">
                                        <span class="reasoning-caret @(reasoningOpen ? "is-open" : null)">▸</span>
                                        <span class="reasoning-summary">@ReasoningSummary(message, thinking)</span>
                                        @if (!reasoningOpen)
                                        {
                                            <span class="reasoning-preview">@ReasoningPreview(message.Reasoning)</span>
                                        }
                                    </button>

                                    @if (reasoningOpen)
                                    {
                                        <pre class="reasoning-body">@message.Reasoning</pre>
                                    }
                                </div>
                            }

                            @* 本条回复调用过哪些工具：过程优先于结论，和 DSH 的工具行一致。 *@
                            @if (message.ToolTrace.Count > 0)
                            {
                                <ToolTracePanel Trace="message.ToolTrace" IsLive="@(thinking && _isGenerating)" />
                            }
                        }

                        @if (message.Plugin is { Segments.Count: > 0 } messagePlugin)
                        {
                            @* 插件生成的回答：段落结构存在 PluginJson 里，可切换对照 / 纯译文（纯渲染，不发请求）*@
                            <div class="msg-body msg-body--segments">
                                <SegmentedOutput Segments="messagePlugin.Segments!" Mode="@ModeFor(messagePlugin.PluginId)" />
                            </div>
                        }
                        else if (!hasTimeline && !string.IsNullOrWhiteSpace(message.Content))
                        {
                            <div class="msg-body @(isUser ? null : "msg-body--markdown")">
                                @if (isUser)
                                {
                                    @message.Content
                                }
                                else
                                {
                                    @((MarkupString)MarkdownRenderer.ToHtml(message.Content))
                                }
                            </div>
                        }

                        @if (message.Attachments.Count > 0)
                        {
                            <div class="msg-attachments">
                                @foreach (var attachment in message.Attachments)
                                {
                                    <span class="attachment-chip attachment-chip--static" title="@attachment.FilePath">
                                        <svg class="attachment-icon" viewBox="0 0 16 16" aria-hidden="true">
                                            <path d="M9.9 4.2 5.3 8.8a1.6 1.6 0 0 0 2.3 2.3l4.9-4.9a2.6 2.6 0 0 0-3.7-3.7L3.7 7.6a4 4 0 0 0 5.7 5.7l4-4"
                                                  fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round" />
                                        </svg>
                                        <span class="attachment-name">@attachment.FileName</span>
                                        <span class="attachment-size">@AttachmentStore.FormatSize(attachment.Size)</span>
                                        @if (attachment.PageCount is int pageCount)
                                        {
                                            <span class="attachment-size" title="PDF 页数">@pageCount 页</span>
                                        }
                                    </span>
                                }
                            </div>
                        }

                        @if (!isUser && message.ToolTrace.Count > 0)
                        {
                            <EditSummaryPanel Trace="message.ToolTrace" SessionId="Session.Id" />
                        }

                        @* M3：知识库引用来源。点击跳到原归档会话；引用不进入后续上下文。 *@
                        @if (message.MemoryCitations.Count > 0)
                        {
                            <div class="memory-citations">
                                <span class="memory-citations-label">引用来源</span>
                                @foreach (var citation in message.MemoryCitations)
                                {
                                    <button type="button"
                                            class="memory-citation"
                                            title="@citation.Title"
                                            @onclick="() => OpenCitedSession(citation.SessionId)">
                                        <span class="memory-citation-title">@citation.Title</span>
                                        <span class="memory-citation-date">@citation.At.ToString("yyyy-MM-dd")</span>
                                    </button>
                                }
                            </div>
                        }

                        <div class="msg-meta">
                            @if (!isContinuation)
                            {
                                <span class="msg-time">@message.CreatedAt.ToString("HH:mm")</span>
                            }

                            @if (!isUser)
                            {
                                @if (message.TotalTokens > 0)
                                {
                                    <span class="msg-stat" title="输入 @message.InputTokens.ToString("N0") / 输出 @message.OutputTokens.ToString("N0")">
                                        @message.TotalTokens.ToString("N0") tokens（输入 @message.InputTokens.ToString("N0")）
                                    </span>
                                }

                                @if (message.ToolCalls.Count > 0)
                                {
                                    <span class="msg-stat" title="@ToolTip(message)">工具 @message.ToolCalls.Values.Sum() 次</span>
                                }

                                @if (message.ApprovalCount > 0)
                                {
                                    <span class="msg-stat" title="本轮真正弹给你确认的审批次数">审批 @message.ApprovalCount 次</span>
                                }

                                @if (message.DurationMs > 0)
                                {
                                    <span class="msg-stat">耗时 @FormatDuration(message.DurationMs)</span>
                                }

                                @if (message.Plugin is { Segments.Count: > 0 } modePlugin)
                                {
                                    <span class="msg-mode" role="group" aria-label="呈现方式">
                                        <button type="button"
                                                class="mode-chip @(ModeFor(modePlugin.PluginId) == PluginOutputMode.Bilingual ? "is-active" : null)"
                                                @onclick="() => SetOutputModeAsync(modePlugin.PluginId, PluginOutputMode.Bilingual)">
                                            对照
                                        </button>
                                        <button type="button"
                                                class="mode-chip @(ModeFor(modePlugin.PluginId) == PluginOutputMode.Translation ? "is-active" : null)"
                                                @onclick="() => SetOutputModeAsync(modePlugin.PluginId, PluginOutputMode.Translation)">
                                            译文
                                        </button>
                                    </span>
                                }

                                @* 插件按钮排在复制之前；无参数点一下直接跑，有参数展开面板 *@
                                <PluginActionBar Entries="BuildMessagePluginActions()"
                                                 Busy="_isGenerating"
                                                 LimitReached="@(message.Derived.Count >= MaxArtifactsPerMessage)"
                                                 RunningMountKey="_runningMountKey"
                                                 OnRun="@(entry => RunArtifactAsync(message, entry))" />
                            }

                            @* P2：pin 后永不被淘汰 / 压缩；数量上限见设置。 *@
                            <button type="button"
                                    class="msg-action msg-action--pin @(message.IsPinned ? "is-on" : null)"
                                    title="@(message.IsPinned ? "取消 pin" : "pin（永不淘汰）")"
                                    aria-pressed="@(message.IsPinned ? "true" : "false")"
                                    @onclick="() => TogglePinAsync(message)"
                                    @onclick:stopPropagation="true">
                                <svg class="msg-action-icon pin-glyph" viewBox="0 0 16 16" aria-hidden="true">
                                    <g transform="rotate(45 8 8)">
                                        <path d="M5.1 2.4h5.8" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
                                        <path d="M6.1 3.4h3.8l-1.15 3.9H7.25z" fill="currentColor" />
                                        <path d="M8 7.3v5.4" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" />
                                    </g>
                                </svg>
                            </button>

                            <button type="button"
                                    class="msg-action"
                                    title="@(_copiedMessageId == message.Id ? "已复制" : "复制")"
                                    @onclick="() => CopyMessage(message)"
                                    @onclick:stopPropagation="true">
                                @if (_copiedMessageId == message.Id)
                                {
                                    <svg class="msg-action-icon" viewBox="0 0 16 16" aria-hidden="true">
                                        <path d="M3.2 8.4 6.3 11.4 12.8 4.6" fill="none" stroke="currentColor"
                                              stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
                                    </svg>
                                }
                                else
                                {
                                    <svg class="msg-action-icon" viewBox="0 0 16 16" aria-hidden="true">
                                        <rect x="5.6" y="5.6" width="7.8" height="7.8" rx="1.5" fill="none"
                                              stroke="currentColor" stroke-width="1.2" />
                                        <path d="M10.4 5.6V4.1A1.5 1.5 0 0 0 8.9 2.6H4.1A1.5 1.5 0 0 0 2.6 4.1v4.8a1.5 1.5 0 0 0 1.5 1.5h1.5"
                                              fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" />
                                    </svg>
                                }
                            </button>

                            <button type="button"
                                    class="msg-action msg-action--danger"
                                    title="@(_isGenerating ? "生成中不能删除消息" : "删除这条消息")"
                                    disabled="@_isGenerating"
                                    @onclick="() => RequestDeleteMessage(message)"
                                    @onclick:stopPropagation="true">
                                <svg class="msg-action-icon" viewBox="0 0 16 16" aria-hidden="true">
                                    <path d="M3 4.5h10M6.2 4.5V3.2h3.6v1.3M4.4 4.5l.5 8.1h6.2l.5-8.1M6.6 7.2v3.4M9.4 7.2v3.4"
                                          fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round" />
                                </svg>
                            </button>

                            @if (!isUser)
                            {
                                <button type="button"
                                        class="msg-action"
                                        title="从此消息创建分支"
                                        @onclick="() => OnBranch.InvokeAsync(message)"
                                        @onclick:stopPropagation="true">
                                    <svg class="msg-action-icon" viewBox="0 0 16 16" aria-hidden="true">
                                        <circle cx="4.4" cy="3.4" r="1.5" fill="none" stroke="currentColor" stroke-width="1.2" />
                                        <circle cx="4.4" cy="12.6" r="1.5" fill="none" stroke="currentColor" stroke-width="1.2" />
                                        <circle cx="11.6" cy="6.4" r="1.5" fill="none" stroke="currentColor" stroke-width="1.2" />
                                        <path d="M4.4 4.9v6.2M11.6 7.9c0 2.6-1.9 4.2-4.4 4.4"
                                              fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" />
                                    </svg>
                                </button>
                            }
                        </div>

                        @* 派生卡片：挂在原消息下，不新增对话轮，也不进入后续上下文 *@
                        @if (message.Derived.Count > 0)
                        {
                            <div class="derived-list">
                                @foreach (var artifact in message.Derived.ToList())
                                {
                                    <DerivedCard Artifact="artifact"
                                                 PluginName="@PluginDisplayName(artifact.PluginId)"
                                                 Mode="@ModeFor(artifact.PluginId)"
                                                 SegmentsExpected="@SegmentsExpected(artifact)"
                                                 OnToggleMode="@(mode => SetOutputModeAsync(artifact.PluginId, mode))"
                                                 OnRetry="@(() => RetryArtifactAsync(message, artifact))"
                                                 OnDelete="@(() => DeleteArtifactAsync(message, artifact))" />
                                }
                            </div>
                        }
                    </article>
                    }
                }

                @* 全部消息都被摘要覆盖（边界情况）：分隔线放在末尾。 *@
                @if (Session.HasSummary && Session.SummaryThroughOrder >= Session.Messages.Count)
                {
                    <CompactionDivider Count="@Session.SummaryThroughOrder"
                                       Tokens="@Session.SummaryTokens"
                                       IsFallback="@Session.SummaryIsFallback"
                                       OnOpen="OpenCompactedHistory" />
                }

                @* 宿主提示：不是模型输出，也不进入下一次请求的上下文（P1 §6：溢出 / 中途裁剪）。 *@
                @if (!string.IsNullOrWhiteSpace(_contextNotice))
                {
                    <div class="context-notice">
                        <span class="context-notice-text">@_contextNotice</span>
                        <button type="button" class="context-notice-close" title="关闭提示" @onclick="DismissContextNotice">✕</button>
                    </div>
                }
            </div>
        </div>
    }

    <SandboxChangesPanel SessionId="@Session.Id" />

    <div class="chat-composer-area">
        @if (_pluginNotice is { } notice)
        {
            <p class="plugin-notice">@notice</p>
        }

        <ChatComposer @bind-Text="_draft"
                      SessionId="@Session.Id"
                      WorkspaceRoot="@WorkspaceContext.RootPath"
                      IsGenerating="_isGenerating"
                      Skills="_skills"
                      SelectedSkill="@_selectedSkill"
                      OnSelectSkill="SelectSkill"
                      ToolPacks="_toolPacks"
                      OnToggleToolPack="ToggleToolPack"
                      PluginMounts="_composerMounts"
                      PluginById="_composerPlugins"
                      MaxVisiblePlugins="@Registry.MaxFor(PluginSurface.Composer)"
                      ActivePlugin="_activePlugin"
                      ActiveMount="_activeMount"
                      ParameterValues="_parameterValues"
                      OnSelectMount="SelectMount"
                      OnParameterChanged="ChangeParameter"
                      OnSend="HandleSend"
                      OnStop="HandleStop">
            <HeaderContent>
                @* 新聊天室（空会话）才需要归属工作区：放在 Header 里，贴左对齐输入文字 *@
                @if (IsEmpty)
                {
                    <WorkspacePicker Workspaces="Workspaces"
                                     SelectedId="@Session.WorkspaceId"
                                     OnSelect="SelectWorkspace"
                                     OnPick="() => OnPickWorkspace.InvokeAsync()" />
                }
            </HeaderContent>
            <FooterContent>
                @if (_modelOptions.Count > 0)
                {
                    <div class="model-picker @(_modelMenuOpen ? "is-open" : null)">
                        <button type="button"
                                class="model-picker-trigger"
                                title="选择模型"
                                aria-haspopup="menu"
                                aria-expanded="@(_modelMenuOpen ? "true" : "false")"
                                disabled="@_isGenerating"
                                @onclick="ToggleModelMenu">
                            <span class="model-picker-current">@CurrentModelLabel()</span>
                            <span class="model-picker-caret" aria-hidden="true">▾</span>
                        </button>

                        @if (_modelMenuOpen)
                        {
                            <div class="model-picker-backdrop" @onclick="CloseModelMenu"></div>
                            <div class="model-picker-menu" role="menu" aria-label="选择模型">
                                @foreach (var group in _modelGroups)
                                {
                                    var collapsed = _collapsedProviders.Contains(group.ProviderId);

                                    <div class="model-picker-group @(collapsed ? "is-collapsed" : null)">
                                        <button type="button"
                                                class="model-picker-group-head"
                                                aria-expanded="@(collapsed ? "false" : "true")"
                                                @onclick="() => ToggleProvider(group.ProviderId)">
                                            <span class="model-picker-group-caret" aria-hidden="true">▸</span>
                                            <span class="model-picker-group-name">@group.ProviderName</span>
                                            <span class="model-picker-group-count">@group.Options.Count</span>
                                        </button>

                                        @if (!collapsed)
                                        {
                                            @foreach (var option in group.Options)
                                            {
                                                var selected = string.Equals(option.Key, _selectedKey, StringComparison.Ordinal);

                                                <button type="button"
                                                        class="model-picker-option @(selected ? "is-selected" : null)"
                                                        role="menuitemradio"
                                                        aria-checked="@(selected ? "true" : "false")"
                                                        title="@($"{option.ProviderName} · {option.ModelName}")"
                                                        @onclick="() => SelectModel(option)">
                                                    <span class="model-picker-option-name">@option.ModelName</span>
                                                    @if (selected)
                                                    {
                                                        <span class="model-picker-check" aria-hidden="true">✓</span>
                                                    }
                                                </button>
                                            }
                                        }
                                    </div>
                                }
                            </div>
                        }
                    </div>
                }
                else
                {
                    <button type="button" class="model-picker-empty" @onclick="() => OnOpenModelSettings.InvokeAsync()">
                        未配置模型 · 去设置
                    </button>
                }
            </FooterContent>
        </ChatComposer>

        @* P1：上下文占用环移到输入框下方；新聊天室还没有内容，不显示。 *@
        @if (!IsEmpty && CurrentScope().Context.ShowContextMeter)
        {
            <div class="composer-usage">
                <ContextMeter Report="_contextPreview" />
                <span class="chat-token-total"
                      title="@($"本聊天室累计 {ContextMeter.Format(ChatTotalTokens)} tokens{Environment.NewLine}输入 {ContextMeter.Format(ChatInputTokens)} / 输出 {ContextMeter.Format(ChatOutputTokens)}")">
                    <svg class="chat-token-icon" viewBox="0 0 16 16" aria-hidden="true">
                        <ellipse cx="8" cy="4.4" rx="4.4" ry="1.7" fill="none" stroke="currentColor" stroke-width="1.1" />
                        <path d="M3.6 4.4v3.2c0 .94 1.97 1.7 4.4 1.7s4.4-.76 4.4-1.7V4.4M3.6 7.6v3.2c0 .94 1.97 1.7 4.4 1.7s4.4-.76 4.4-1.7V7.6"
                              fill="none" stroke="currentColor" stroke-width="1.1" stroke-linecap="round" />
                    </svg>
                    <span>@ContextMeter.Format(ChatTotalTokens)</span>
                </span>
            </div>
        }
    </div>

    @* 文件写入 / PowerShell 执行的确认框已移到 AppShell 顶层的 ToolApprovalHost，切换会话不会消失。 *@

    @* 已压缩原文：只读弹层；可单条 pin（pin 的消息会重新出现在后续请求里）。 *@
    @if (_showCompacted)
    {
        <div class="modal-backdrop">
            <div class="modal modal--compacted" role="dialog" aria-modal="true" aria-label="已压缩的历史">
                <h2 class="modal-title">已压缩的历史</h2>
                <p class="modal-sub">
                    这些消息仍完整保存在本机会话里；模型从摘要了解它们，不再看到原文。
                    需要保留某条时点图钉，它会重新进入后续请求（总数上限见设置）。
                </p>

                <div class="compacted-list">
                    @foreach (var item in CompactedMessages())
                    {
                        <div class="compacted-row">
                            <div class="compacted-head">
                                <span class="compacted-role">@(item.Message.Role == ChatMessageRole.User ? "你" : "SDemo")</span>
                                <span class="compacted-time">@item.Message.CreatedAt.ToString("HH:mm")</span>

                                <button type="button"
                                        class="msg-action msg-action--pin @(item.Message.IsPinned ? "is-on" : null)"
                                        title="@(item.Message.IsPinned ? "取消 pin" : "pin（永不淘汰）")"
                                        @onclick="() => TogglePinAsync(item.Message)">
                                    <svg class="msg-action-icon pin-glyph" viewBox="0 0 16 16" aria-hidden="true">
                                        <g transform="rotate(45 8 8)">
                                            <path d="M5.1 2.4h5.8" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
                                            <path d="M6.1 3.4h3.8l-1.15 3.9H7.25z" fill="currentColor" />
                                            <path d="M8 7.3v5.4" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" />
                                        </g>
                                    </svg>
                                </button>
                            </div>

                            <p class="compacted-text">@Preview(item.Message)</p>
                            @if (item.Message.IsPinned)
                            {
                                <p class="compacted-pinned-note">已 pin：下一轮会重新发送这条原文</p>
                            }
                        </div>
                    }
                </div>

                <div class="modal-actions">
                    <button type="button" class="primary-button" @onclick="CloseCompactedHistory">关闭</button>
                </div>
            </div>
        </div>
    }

    @* 隐私提示：privacy.sendsText 的插件首次使用确认一次 *@
    @if (_privacyPlugin is { } privacyPlugin)
    {
        <div class="modal-backdrop">
            <div class="modal" role="dialog" aria-modal="true">
                <h2 class="modal-title">「@privacyPlugin.Name」会把文本发送给模型服务商</h2>
                <p class="modal-sub">
                    这个插件需要把待处理的文本发给你配置的模型；插件本身只产出文本，不会读写本地文件。
                    确认后不会再提示。
                </p>
                <div class="modal-actions">
                    <button type="button" class="ghost-button" @onclick="CancelPrivacy">取消</button>
                    <button type="button" class="primary-button" @onclick="ContinueAfterPrivacyAsync">继续</button>
                </div>
            </div>
        </div>
    }

    @* 删除单条消息：不可撤销，并从后续上下文中移除。 *@
    @if (_messagePendingDelete is { } pendingDelete)
    {
        <div class="modal-backdrop">
            <div class="modal" role="dialog" aria-modal="true" aria-label="删除消息">
                <h2 class="modal-title">删除这条消息？</h2>
                <p class="modal-sub">
                    @(pendingDelete.Role == ChatMessageRole.User ? "你发送的消息" : "AI 回复")
                    会从当前聊天记录和后续上下文中移除，且无法恢复。
                </p>
                <div class="modal-actions">
                    <button type="button" class="ghost-button" @onclick="CancelDeleteMessage">取消</button>
                    <button type="button" class="danger-button" @onclick="ConfirmDeleteMessageAsync">删除</button>
                </div>
            </div>
        </div>
    }
</section>

@code {
    /// <summary>每条消息最多挂 5 张派生卡片。</summary>
    private const int MaxArtifactsPerMessage = 5;

    /// <summary>单张卡片的文本上限，超过就截断。</summary>
