    /// <summary>打开当前聊天室的设置抽屉（只影响这个会话）。</summary>
    [Parameter]
    public EventCallback OnOpenSessionSettings { get; set; }

    /// <summary>当前聊天室可选的工作区。</summary>
    [Parameter]
    public IReadOnlyList<Workspace> Workspaces { get; set; } = [];

    /// <summary>切换当前聊天室的工作区。</summary>
    [Parameter]
    public EventCallback<Workspace> OnWorkspaceChanged { get; set; }

    /// <summary>下拉框最底部的「选择工作区」（打开系统文件夹选择框）。</summary>
    [Parameter]
    public EventCallback OnPickWorkspace { get; set; }

    /// <summary>M3：知识库引用跳转；由外层按 sessionId 找到并打开会话。</summary>
    [Parameter]
    public EventCallback<string> OnOpenSessionById { get; set; }

    /// <summary>M3：归档 / 取消归档后通知外层刷新侧栏与设置页。</summary>
    [Parameter]
    public EventCallback<ChatSession> OnArchiveChanged { get; set; }

    /// <summary>
    /// 当前是否是用户正在看的聊天室。切走后组件仍保留（后台生成），
    /// 但会按设置决定是否中止；隐藏时只通过 CSS 移出视图。
    /// </summary>
    [Parameter]
    public bool IsActive { get; set; } = true;

    private string _draft = string.Empty;
    private bool _isGenerating;
    private string? _sessionId;
    private string? _workspaceId;
    private ChatSession? _currentSession;
    private ElementReference _scrollElement;

    private List<ModelOption> _modelOptions = [];
    private List<ModelGroup> _modelGroups = [];
    private string? _selectedKey;
    private bool _modelMenuOpen;

    /// <summary>模型选择器里被用户收起的提供商；默认全部展开。</summary>
    private readonly HashSet<string> _collapsedProviders = new(StringComparer.Ordinal);

    /// <summary>等待确认删除的消息。</summary>
    private ChatMessage? _messagePendingDelete;
    private CancellationTokenSource? _cts;
    private bool _autoContinued;
    private int _noEditRepromptAttempts;

    /// <summary>最近一次算出的上下文报告（预览或真实请求），驱动占用环与明细。</summary>
    private ContextReport? _contextPreview;

    /// <summary>预览版本号：异步路由返回时只应用最新一次请求，避免旧结果覆盖新结果。</summary>
    private int _previewVersion;

    /// <summary>宿主提示（溢出重试 / 需压缩 / 压缩结果）；不渲染进对话正文，也不进入后续上下文。</summary>
    private string? _contextNotice;

    /// <summary>会话菜单（压缩现在 / 清空摘要）是否展开。</summary>
    private bool _sessionMenuOpen;

    /// <summary>「查看已压缩原文」弹层是否打开。</summary>
    private bool _showCompacted;

    /// <summary>常用技能（本地技能库）。</summary>
    private IReadOnlyList<SkillInfo> _skills = [];

    /// <summary>当前选中的技能名（为空表示不套用技能）。</summary>
    private string? _selectedSkill;

    /// <summary>本轮启用的工具包 id（多选；最终仍以 chip 的可用性为准）。</summary>
    private readonly HashSet<string> _enabledToolPacks = new(StringComparer.Ordinal);

    /// <summary>输入框里的工具 chip：注册表描述 + 设置开关 + 沙箱可用性。</summary>
    private IReadOnlyList<ToolPackChip> _toolPacks = [];

    /// <summary>最近一次沙箱可用性（异步探测 + 设置变更后刷新）。</summary>
    private SandboxAvailability? _sandboxAvailability;

    /// <summary>AppContainer 单独的可用性：PDF 解析固定在 AppContainer 里跑，和首选沙箱无关。</summary>
    private SandboxAvailability? _appContainerAvailability;

    private bool _toolPackAvailabilityLoading;

    /// <summary>输入框可用的插件入口（composer 界面、可用且 show）。</summary>
    private IReadOnlyList<PluginMount> _composerMounts = [];

    /// <summary>上面这些入口对应的插件：给 chip 画图标用。</summary>
    private IReadOnlyDictionary<string, PluginDescriptor> _composerPlugins =
        new Dictionary<string, PluginDescriptor>(StringComparer.Ordinal);

    /// <summary>当前选中的插件入口组合键（<c>&lt;pluginId&gt;/&lt;mountId&gt;</c>）。</summary>
    private string? _activeMountKey;

    private PluginDescriptor? _activePlugin;

    private PluginMount? _activeMount;

    /// <summary>本轮参数值（按会话记忆解析；用户改了就写回会话记忆）。</summary>
    private Dictionary<string, string> _parameterValues = new(StringComparer.Ordinal);

    /// <summary>正在运行的派生卡片对应的入口组合键（按钮上显示转圈）。</summary>
    private string? _runningMountKey;

    /// <summary>插件被停用 / 入口被关掉时，输入框上方的一句提示。</summary>
    private string? _pluginNotice;

    /// <summary>待用户确认「文本会发给模型服务商」的插件。</summary>
    private PluginDescriptor? _privacyPlugin;

    /// <summary>确认隐私提示后要继续执行的动作。</summary>
    private Func<Task>? _pendingAfterPrivacy;

    /// <summary>刚刚复制过的消息 Id（用于短暂显示对勾）。</summary>
    private string? _copiedMessageId;

    private bool _disposed;

    /// <summary>展开了思维链的消息 Id。</summary>
    private readonly HashSet<string> _openReasoning = [];

    /// <summary>用户手动开合过思维链的消息：这一轮结束后不要替他收起来。</summary>
    private readonly HashSet<string> _manualReasoning = [];

    /// <summary>宿主动追问时，同一回合最多再生成几轮（3 次无修改回灌 + 1 次自动验证 + 余量）。</summary>
    private const int MaxHostRounds = 5;

    /// <summary>宿主自动追加的提示前缀；这类「用户消息」来自策略，不是用户手打的。</summary>
    private const string HostPromptPrefix = "[宿主提示]";

    private bool IsEmpty => Session.Messages.Count == 0;

    /// <summary>本聊天室所有助手消息累计的输入 token。</summary>
    private int ChatInputTokens => Session.Messages.Sum(message => message.InputTokens);

    /// <summary>本聊天室所有助手消息累计的输出 token。</summary>
    private int ChatOutputTokens => Session.Messages.Sum(message => message.OutputTokens);

    /// <summary>本聊天室累计 token（输入 + 输出）。</summary>
    private int ChatTotalTokens => ChatInputTokens + ChatOutputTokens;

    protected override void OnInitialized()
    {
        _skills = SkillCatalog.List();
        RefreshPluginMounts();
        RefreshModelOptions();
        RefreshToolPacks();
        Settings.Changed += OnSettingsChanged;
        Registry.Changed += OnRegistryChanged;

        // 沙箱探测可能要启动一次进程：先按“未验证”渲染 chip，后台刷新后再更新。
        _ = RefreshSandboxAvailabilityAsync();
        RefreshContextPreview();
    }

    protected override void OnParametersSet()
    {
        // 切换到另一个聊天室时清空草稿、取消上一轮生成；插件状态按会话恢复（不能一律清空）。
        if (_sessionId != Session.Id)
        {
            var previous = _currentSession;

            _sessionId = Session.Id;
            _currentSession = Session;
            _draft = string.Empty;
            _selectedSkill = null;
            _enabledToolPacks.Clear();
            _copiedMessageId = null;

            if (_isGenerating)
            {
                _cts?.Cancel();
                _isGenerating = false;
                _runningMountKey = null;

                // 旧会话的「推理中」状态必须一起收回，否则左侧列表会一直转圈。
                if (previous is not null)
                {
                    previous.IsGenerating = false;
                }
            }

            ApplyActiveMount(Session.ActiveMountId);
            RefreshToolPacks();
            _contextNotice = null;
            _sessionMenuOpen = false;
            _showCompacted = false;
            _modelMenuOpen = false;
            _messagePendingDelete = null;
            RefreshContextPreview();
        }
        else
        {
            _currentSession = Session;
        }

        // 会话换到另一个工作区时，继承的模型 / 上下文设置会跟着变。
        if (_workspaceId != Session.WorkspaceId)
        {
            _workspaceId = Session.WorkspaceId;
            RefreshModelOptions();
            RefreshContextPreview();
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // 切到别的聊天室且设置为「中断」：取消本会话的生成，并立刻把状态还给侧栏。
        if (!IsActive
            && _isGenerating
            && !Settings.Current.ContinueGenerationOnChatSwitch)
        {
            await StopForDeactivateAsync();
            return;
        }

        // 有消息后滚到底部（空态没有消息区，跳过；后台生成的隐藏实例不调 JS）。
        if (IsActive && Session.Messages.Count > 0)
        {
            await Js.InvokeVoidAsync("sdChat.scrollToBottom", _scrollElement);
        }
    }

    /// <summary>
    /// 切走后按设置中断生成：立即撤销侧栏状态，再等取消信号把已生成的部分收尾。
    /// </summary>
    private async Task StopForDeactivateAsync()
    {
        _cts?.Cancel();
        _isGenerating = false;
        _runningMountKey = null;
        Session.IsGenerating = false;
        await SetGeneratingAsync(false);

        if (!_disposed)
        {
            StateHasChanged();
        }
    }

    private void OnSettingsChanged(object? sender, EventArgs args) =>
        _ = InvokeAsync(() =>
        {
            RefreshModelOptions();
            RefreshToolPacks();
            RefreshContextPreview();
            _ = RefreshSandboxAvailabilityAsync();
            StateHasChanged();
        });

    private bool IsReasoningOpen(string messageId) => _openReasoning.Contains(messageId);

    private void ToggleReasoning(string messageId)
    {
        _manualReasoning.Add(messageId);

        if (!_openReasoning.Remove(messageId))
        {
            _openReasoning.Add(messageId);
        }
    }

    /// <summary>这条消息是宿主自动追加的提示（无修改回灌 / 自动验证），不是用户输入。</summary>
    private static bool IsHostPrompt(ChatMessage message) =>
        message.Role == ChatMessageRole.User
        && message.Content.StartsWith(HostPromptPrefix, StringComparison.Ordinal);

    /// <summary>宿主提示压成一行：去掉前缀，只留第一行前 60 字。</summary>
    private static string HostPromptPreview(string content)
    {
        var text = content.StartsWith(HostPromptPrefix, StringComparison.Ordinal)
            ? content[HostPromptPrefix.Length..].Trim()
            : content.Trim();

        var firstLine = text.Split('\n')[0].Trim();

        return firstLine.Length <= 60 ? firstLine : firstLine[..60] + "…";
    }

    /// <summary>上一条真正上屏的消息是不是助手消息（跳过往返的宿主提示），用来把续答并进同一块。</summary>
    private bool PreviousRenderedIsAssistant(int index)
    {
        for (var cursor = index - 1; cursor >= 0; cursor--)
        {
            var previous = Session.Messages[cursor];

            if (IsHostPrompt(previous))
            {
                continue;
            }

            return previous.Role == ChatMessageRole.Assistant;
        }

        return false;
    }

    /// <summary>正在生成、且就是最后一条的助手消息 → 思维链处于「思考中」状态。</summary>
    private bool IsThinking(ChatMessage message) =>
        _isGenerating
        && message.Role == ChatMessageRole.Assistant
        && Session.Messages.Count > 0
        && ReferenceEquals(Session.Messages[^1], message);

    /// <summary>DSH 风格的一行摘要：思考中显示「思考中…」，结束后收成「已思考 · N 字」。</summary>
    private static string ReasoningSummary(ChatMessage message, bool thinking) =>
        thinking
            ? "思考中…"
            : $"已思考 · {message.Reasoning.Length:N0} 字";

    /// <summary>折叠时贴出的最后一行思维链（流式时跟着最新一行走）。</summary>
    private static string ReasoningPreview(string reasoning)
    {
        var lines = reasoning.Split('\n');
        var last = lines.LastOrDefault(line => !string.IsNullOrWhiteSpace(line))?.Trim() ?? string.Empty;

        return last.Length <= 72 ? last : last[..72] + "…";
    }

    private Task SelectWorkspace(Workspace workspace) => OnWorkspaceChanged.InvokeAsync(workspace);

    private void RefreshModelOptions()
    {
        var options = new List<ModelOption>();

        foreach (var provider in Settings.Current.Providers)
        {
            foreach (var model in provider.Models)
            {
                options.Add(new ModelOption(
                    $"{provider.Id}|{model.Id}",
                    provider.Name,
                    model.Name,
                    provider,
                    model.Id));
            }
        }

        _modelOptions = options;
        _modelGroups = options
            .GroupBy(option => option.Provider.Id, StringComparer.Ordinal)
            .Select(group => new ModelGroup(
                group.Key,
                group.First().ProviderName,
                group.ToList()))
            .ToList();

        // 模型优先级：聊天室 > 工作区 > 通用；没有作用域覆盖时保留当前选择。
        var scope = CurrentScope();
        var scoped = options.FirstOrDefault(option =>
            string.Equals(option.Provider.Id, scope.ProviderId, StringComparison.Ordinal) &&
            string.Equals(option.ModelId, scope.ModelId, StringComparison.Ordinal));

        if (scoped is not null)
        {
            _selectedKey = scoped.Key;
            return;
        }

        if (_selectedKey is not null && options.Any(option => option.Key == _selectedKey))
        {
            return;
        }

        // 优先恢复上次使用的 provider + model，其次用第一个可用模型。
        var remembered = options.FirstOrDefault(option =>
            string.Equals(option.Provider.Id, Settings.Current.LastProviderId, StringComparison.Ordinal) &&
            string.Equals(option.ModelId, Settings.Current.LastModelId, StringComparison.Ordinal));

        _selectedKey = remembered?.Key ?? options.FirstOrDefault()?.Key;
    }

    private void ToggleModelMenu()
    {
        _modelMenuOpen = !_modelMenuOpen;
    }

    private void CloseModelMenu()
    {
        _modelMenuOpen = false;
    }

    private void ToggleProvider(string providerId)
    {
        if (!_collapsedProviders.Remove(providerId))
        {
            _collapsedProviders.Add(providerId);
        }
    }

    private async Task SelectModel(ModelOption option)
    {
        _selectedKey = option.Key;
        _modelMenuOpen = false;

        // 底部选择器改的是「当前聊天室」的模型；通用设置只记住最后一次选择，供新聊天室兜底。
        Session.ScopedSettings.ProviderId = option.Provider.Id;
        Session.ScopedSettings.ModelId = option.ModelId;
        RememberSelection();
        _contextNotice = null;
        await NotifySessionChangedAsync();
        RefreshContextPreview();
    }

    private string CurrentModelLabel()
    {
        var option = CurrentModelOption();
        return option is null ? "选择模型" : $"{option.ProviderName} · {option.ModelName}";
    }

    /// <summary>选择技能：再次点击同一个则取消。</summary>
    private void SelectSkill(string? name)
    {
        _selectedSkill = name;
        RefreshContextPreview();
    }

    /// <summary>
    /// 重新估算「下一次请求」的上下文占用；只读、不发对话请求。
    /// M4 起规则不确定时会先问一次小模型路由（有 2 分钟缓存），因此预览是异步的；
    /// 预算超限时把错误报告留在 <see cref="_contextPreview"/>，让占用环仍然显示真实数值。
    /// </summary>
    private void RefreshContextPreview()
    {
        var version = ++_previewVersion;
        _ = RefreshContextPreviewAsync(version);
    }

    private async Task RefreshContextPreviewAsync(int version)
    {
        var option = CurrentModelOption();

        if (option is null || Session.Messages.Count == 0)
        {
            if (version == _previewVersion)
            {
                _contextPreview = null;
            }

            return;
        }

        ContextReport? report;

        try
        {
            var plan = await Runner.PreviewAsync(new AgentRunRequest(
                Session.Messages.ToList(),
                option.Provider,
                option.ModelId,
                EffectiveToolPacks(),
                _selectedSkill,
                Session.Id,
                Session: Session,
                Scope: CurrentScope()));
            report = plan.Report;
        }
        catch (ContextBudgetException ex)
        {
            report = ex.Report;
        }
        catch (Exception)
        {
            // 预览失败不影响发送：设置页可能刚被改坏，真正发送时还会再报一次。
            report = null;
        }

        if (version != _previewVersion)
        {
            return;
        }

        _contextPreview = report;

        try
        {
            await InvokeAsync(StateHasChanged);
        }
        catch (Exception)
        {
            // 组件已释放：预览结果不再需要渲染。
        }
    }

    private ModelOption? CurrentModelOption() =>
        _modelOptions.FirstOrDefault(option => string.Equals(option.Key, _selectedKey, StringComparison.Ordinal));

    /// <summary>当前聊天室归属的工作区；没有归属返回 null。</summary>
    private Workspace? CurrentWorkspace() =>
        string.IsNullOrWhiteSpace(Session.WorkspaceId)
            ? null
            : Settings.Current.Workspaces.FirstOrDefault(workspace =>
                string.Equals(workspace.Id, Session.WorkspaceId, StringComparison.Ordinal));

    /// <summary>通用 → 工作区 → 聊天室 合并后的有效设置。</summary>
    private EffectiveSettings CurrentScope() =>
        EffectiveSettings.Resolve(Settings.Current, CurrentWorkspace(), Session);

    private void DismissContextNotice() => _contextNotice = null;

    private void ToggleSessionMenu() => _sessionMenuOpen = !_sessionMenuOpen;

    /// <summary>只读查看被摘要覆盖的原文（不改变摘要、不影响发送）。</summary>
    private void OpenCompactedHistory()
    {
        _sessionMenuOpen = false;
        _showCompacted = true;
    }

    private void CloseCompactedHistory() => _showCompacted = false;

    private IEnumerable<(ChatMessage Message, int Index)> CompactedMessages()
    {
        var count = Math.Min(Session.SummaryThroughOrder, Session.Messages.Count);

        for (var index = 0; index < count; index++)
        {
            yield return (Session.Messages[index], index);
        }
    }

    private static string Preview(ChatMessage message)
    {
        var text = message.Content?.Trim() ?? string.Empty;

        if (text.Length == 0)
        {
            return message.Attachments.Count > 0
                ? $"[附件] {string.Join("、", message.Attachments.Select(attachment => attachment.FileName))}"
                : "（无正文）";
        }

        return text.Length <= 400 ? text : string.Concat(text.AsSpan(0, 400), "…");
    }

    /// <summary>手动压缩：走与自动压缩相同的增量逻辑，失败走兜底并提示。</summary>
    private async Task CompactNowAsync()
    {
        _sessionMenuOpen = false;

        if (_isGenerating)
        {
            return;
        }

        var option = CurrentModelOption();
        if (option is null)
        {
            _contextNotice = "还没有可用模型，无法压缩。";
            StateHasChanged();
            return;
        }

        try
        {
            var outcome = await Runner.CompactAsync(new AgentCompactRequest(
                Session,
                option.Provider,
                option.ModelId,
                Session.Id,
                CurrentScope()));

            _contextNotice = outcome.Message;

            if (outcome.Compacted)
            {
                RefreshContextPreview();
                await NotifySessionChangedAsync();
            }
        }
        catch (Exception ex)
        {
            _contextNotice = $"压缩失败：{ex.Message}";
        }

        StateHasChanged();
    }

    /// <summary>清空摘要：下一轮超预算时重新生成；原文与 pin 不受影响。</summary>
    private async Task ClearSummaryAsync()
    {
        _sessionMenuOpen = false;

        if (_isGenerating)
        {
            return;
        }

        Session.Summary = null;
        Session.SummaryThroughOrder = 0;
        Session.SummaryTokens = 0;
        Session.SummaryUpdatedAt = null;
        Session.SummaryIsFallback = false;

        _contextNotice = "已清空摘要；下一轮超预算时会重新生成。";
        RefreshContextPreview();
        await NotifySessionChangedAsync();
        StateHasChanged();
    }

    /// <summary>M3：把当前会话归档到工作区知识库 / 取消归档。</summary>
    private async Task ToggleArchiveAsync()
    {
        _sessionMenuOpen = false;

        if (_isGenerating)
        {
            return;
        }

        var outcome = Session.IsArchived
            ? await ArchiveService.UnarchiveAsync(Session)
            : await ArchiveService.ArchiveAsync(Session);

        _contextNotice = outcome.Message;
        await NotifySessionChangedAsync();
        await OnArchiveChanged.InvokeAsync(Session);
        RefreshContextPreview();
        StateHasChanged();
    }

    /// <summary>M3：点击引用来源，按 sessionId 跳到原归档会话。</summary>
    private void OpenCitedSession(string sessionId) =>
        _ = OnOpenSessionById.InvokeAsync(sessionId);

    /// <summary>切换一条消息的 pin；上限由 Core 的 PinPolicy 判定（便于单测）。</summary>
    private async Task TogglePinAsync(ChatMessage message)
    {
        var limit = CurrentScope().Context.MaxPinnedMessages;
        var result = PinPolicy.Toggle(Session, message, limit);

        if (!result.Changed)
        {
            _contextNotice = result.Message;
            StateHasChanged();
            return;
        }

        await NotifySessionChangedAsync();
        RefreshContextPreview();
        StateHasChanged();
