    /// <summary>开关一个工具包（只有可用时才允许；不可用的 chip 在 UI 上已禁用）。</summary>
    private void ToggleToolPack(string packId)
    {
        var chip = _toolPacks.FirstOrDefault(item => string.Equals(item.Id, packId, StringComparison.Ordinal));
        if (chip is null || !chip.Available)
        {
            return;
        }

        if (!_enabledToolPacks.Remove(packId))
        {
            _enabledToolPacks.Add(packId);
        }

        RefreshToolPacks();
    }

    /// <summary>
    /// 重建输入框里的外部工具 chip。文件 / PDF / PowerShell 是内置能力（<c>BuiltIn</c>），
    /// 不出现在 chip 里，由模型按需调用；只有搜索这类可选工具需要用户逐轮选择。
    /// </summary>
    private void RefreshToolPacks()
    {
        // M2：技能索引 / load_skill 以技能库为准；技能目录变了（用户放了新 .md）也要刷新 chip。
        _skills = SkillCatalog.List();

        var chips = new List<ToolPackChip>();

        foreach (var descriptor in ToolRegistry.Descriptors)
        {
            if (descriptor.BuiltIn)
            {
                continue;
            }

            var unavailableReason = GetUnavailableReason(descriptor);
            var available = unavailableReason is null;

            chips.Add(new ToolPackChip(
                descriptor.Id,
                descriptor.Name,
                descriptor.Description,
                descriptor.Glyph,
                available && _enabledToolPacks.Contains(descriptor.Id),
                available,
                unavailableReason));
        }

        _toolPacks = chips;

        // 包在设置里被关掉 / 沙箱失效时，把本轮的选择也清掉，避免继续传给模型。
        _enabledToolPacks.RemoveWhere(id => chips.FirstOrDefault(chip => chip.Id == id) is not { Available: true });
    }

    /// <summary>
    /// 本轮真正交给模型的工具包：用户在 chip 里选中的外部工具 + 当前可用的内置包。
    /// 预览与发送共用它，否则占用环会低估工具 schema 的预算。
    /// </summary>
    private HashSet<string> EffectiveToolPacks()
    {
        var enabled = new HashSet<string>(_enabledToolPacks, StringComparer.Ordinal);

        foreach (var descriptor in ToolRegistry.Descriptors.Where(descriptor => descriptor.BuiltIn))
        {
            if (GetUnavailableReason(descriptor) is null)
            {
                enabled.Add(descriptor.Id);
            }
        }

        return enabled;
    }

    /// <summary>
    /// 某个工具包本轮为什么不能交给模型；null 表示可用。
    /// 内置包同样走这套判断，只是不渲染 chip。
    /// </summary>
    private string? GetUnavailableReason(AgentToolPackDescriptor descriptor)
    {
        var settings = Settings.Current;

        if (!settings.Tools.IsPackEnabled(descriptor.Id, descriptor.DefaultEnabled))
        {
            return "在「设置 → 工具设置」中启用";
        }

        // 技能工具没有素材时不必暴露：系统提示不会产生索引，load_skill 也读不到正文。
        if (descriptor.Id == "skills" && _skills.Count == 0)
        {
            return "还没有本地技能";
        }

        // M3：知识库工具只在「开关打开 ∩ 有工作区 ∩ 有归档会话」时暴露。
        if (descriptor.Id == MemoryToolPack.PackId)
        {
            if (!settings.Agent.WorkspaceMemoryEnabled)
            {
                return "工作区知识库已在设置中关闭";
            }

            if (string.IsNullOrWhiteSpace(Session.WorkspaceId))
            {
                return "当前会话不属于工作区";
            }

            try
            {
                if (Memory.CountArchived(Session.WorkspaceId) == 0)
                {
                    return "当前工作区还没有归档会话";
                }
            }
            catch (Exception)
            {
                return "工作区知识库暂不可用";
            }
        }

        if (descriptor.Id == "powershell")
        {
            if (!settings.Sandbox.Enabled)
            {
                return "执行沙箱已在设置中关闭";
            }

            if (_sandboxAvailability is not { Available: true, Verified: true })
            {
                return _toolPackAvailabilityLoading
                    ? "正在检测沙箱…"
                    : _sandboxAvailability?.Reason ?? "沙箱不可用或未验证";
            }
        }
        else if (descriptor.Id == "pdf")
        {
            // PDF helper 只在 AppContainer 里跑；不要求 PowerShell 的 Verified。
            if (!settings.Sandbox.Enabled)
            {
                return "执行沙箱已在设置中关闭";
            }

            if (_appContainerAvailability is not { Available: true })
            {
                return _toolPackAvailabilityLoading
                    ? "正在检测沙箱…"
                    : _appContainerAvailability?.Reason ?? "AppContainer 沙箱不可用";
            }
        }

        return null;
    }

    private async Task RefreshSandboxAvailabilityAsync()
    {
        if (_disposed)
        {
            return;
        }

        _toolPackAvailabilityLoading = true;

        try
        {
            // 两个查询分开：PowerShell 看策略选出的沙箱，PDF 固定看 AppContainer。
            _sandboxAvailability = await Sandbox.GetAvailabilityAsync();
            _appContainerAvailability = await Sandbox.GetAvailabilityAsync(SandboxKind.AppContainer);
        }
        catch (Exception ex) when (ex is IOException or InvalidOperationException or SystemException)
        {
            var failure = new SandboxAvailability(
                SandboxKind.None,
                Available: false,
                Verified: false,
                $"沙箱状态检测失败：{ex.Message}",
                Detail: null);
            _sandboxAvailability = failure;
            _appContainerAvailability = failure;
        }
        finally
        {
            _toolPackAvailabilityLoading = false;
        }

        await InvokeAsync(() =>
        {
            RefreshToolPacks();
            StateHasChanged();
        });
    }

    /// <summary>刷新输入框可用的插件入口（启动、重新扫描 / 设置改动后调用）。</summary>
    private void RefreshPluginMounts()
    {
        _composerMounts = Registry.Mounts(PluginSurface.Composer);
        _composerPlugins = _composerMounts
            .Select(mount => mount.PluginId)
            .Distinct(StringComparer.Ordinal)
            .Select(id => Registry.Find(id))
            .OfType<PluginDescriptor>()
            .ToDictionary(plugin => plugin.Id, StringComparer.Ordinal);
    }

    /// <summary>
    /// 按组合键恢复插件选择。插件被停用 / 删除 / 入口被关掉时退回全局模式并提示一句，
    /// 但 <see cref="ChatSession.ActiveMountId"/> 原样保留——重新启用后仍能恢复。
    /// </summary>
    private void ApplyActiveMount(string? mountKey)
    {
        _activeMountKey = mountKey;

        var mount = string.IsNullOrWhiteSpace(mountKey) ? null : Registry.FindMount(mountKey);

        if (mount?.Capability is not { } capability)
        {
            _activeMount = null;
            _activePlugin = null;
            _parameterValues = new Dictionary<string, string>(StringComparer.Ordinal);

            if (!string.IsNullOrWhiteSpace(mountKey))
            {
                var pluginId = mountKey.Split('/')[0];
                _pluginNotice = $"插件「{Registry.DisplayName(pluginId)}」当前不可用（已停用或被删除），已回到普通对话。";
            }
            else
            {
                _pluginNotice = null;
            }

            return;
        }

        _pluginNotice = null;
        _activeMount = mount;
        _activePlugin = Registry.Find(mount.PluginId);
        _parameterValues = new Dictionary<string, string>(
            ParameterResolver.Resolve(capability, mount.PluginId, mount.Id, MemoryForResolve()),
            StringComparer.Ordinal);
    }

    /// <summary>设置里关掉「记住参数值」时，解析不再读会话记忆（也不会再写）。</summary>
    private IReadOnlyDictionary<string, string> MemoryForResolve() =>
        Registry.Preferences.RememberParameterValues
            ? Session.PluginMemory
            : new Dictionary<string, string>(StringComparer.Ordinal);

    /// <summary>选中 / 取消插件入口（生成中禁止切换，避免半途换 prompt）。</summary>
    private async Task SelectMount(string? mountKey)
    {
        if (_isGenerating)
        {
            return;
        }

        _pluginNotice = null;
        Session.ActiveMountId = mountKey;
        ApplyActiveMount(mountKey);
        StateHasChanged();
        await PersistSelectionAsync();
    }

    /// <summary>参数变化：写回内存值 + 会话记忆（重开聊天室仍记得上次选的语言）。</summary>
    private async Task ChangeParameter((string Key, string Value) change)
    {
        if (_activeMount is null)
        {
            return;
        }

        _parameterValues[change.Key] = change.Value;

        // 设置里关掉「记住参数值」时只影响本次，不写会话记忆。
        if (Registry.Preferences.RememberParameterValues)
        {
            Session.PluginMemory[
                PluginParameterResolver.MemoryKey(_activeMount.PluginId, _activeMount.Id, change.Key)] = change.Value;
        }

        StateHasChanged();
        await PersistSelectionAsync();
    }

    /// <summary>空会话还没落库：选择先留在内存，等首条消息保存时一起写。</summary>
    private Task PersistSelectionAsync() =>
        Session.Messages.Count > 0 ? NotifySessionChangedAsync() : Task.CompletedTask;

    /// <summary>目录重新扫描、或用户在设置里改了开关 / 上限 / 顺序。</summary>
    private void OnRegistryChanged(object? sender, EventArgs e) =>
        _ = InvokeAsync(() =>
        {
            RefreshPluginMounts();

            // 正在用的插件被停用 / 入口被关掉时，ApplyActiveMount 会回退到全局模式并给出提示。
            ApplyActiveMount(Session.ActiveMountId);
            StateHasChanged();
        });

    /// <summary>助手消息的角色名：插件生成显示「翻译 · SDemo」，普通回答仍是 SDemo。</summary>
    private string RoleLabel(ChatMessage message)
    {
        if (message.Plugin is not { } info)
        {
            return message.Role == ChatMessageRole.User ? "你" : "SDemo";
        }

        var name = Registry.DisplayName(info.PluginId);
        return string.IsNullOrWhiteSpace(name) ? $"{info.PluginId} · SDemo" : $"{name} · SDemo";
    }

    /// <summary>点垃圾桶：先让用户确认，删除不可撤销。</summary>
    private void RequestDeleteMessage(ChatMessage message)
    {
        if (_isGenerating)
        {
            return;
        }

        _messagePendingDelete = message;
    }

    private void CancelDeleteMessage() => _messagePendingDelete = null;

    /// <summary>删除单条消息，并同步收缩摘要边界，避免后续压缩引用错位。</summary>
    private async Task ConfirmDeleteMessageAsync()
    {
        var message = _messagePendingDelete;
        _messagePendingDelete = null;

        if (message is null)
        {
            return;
        }

        var index = Session.Messages.IndexOf(message);
        if (index < 0)
        {
            return;
        }

        Session.Messages.RemoveAt(index);
        _openReasoning.Remove(message.Id);
        _manualReasoning.Remove(message.Id);

        if (Session.HasSummary && index < Session.SummaryThroughOrder)
        {
            Session.SummaryThroughOrder--;

            if (Session.SummaryThroughOrder <= 0)
            {
                Session.Summary = null;
                Session.SummaryThroughOrder = 0;
                Session.SummaryUpdatedAt = null;
                Session.SummaryTokens = 0;
                Session.SummaryIsFallback = false;
            }
        }

        await NotifySessionChangedAsync();
        RefreshContextPreview();
        StateHasChanged();
    }

    /// <summary>复制消息纯文本到剪贴板，短暂显示对勾。</summary>
    private async Task CopyMessage(ChatMessage message)
    {
        if (string.IsNullOrEmpty(message.Content))
        {
            return;
        }

        try
        {
            await Js.InvokeVoidAsync("sdChat.copyText", message.Content);
        }
        catch (JSException)
        {
            // 剪贴板不可用时仍然给出复制成功的视觉反馈没有意义，直接返回。
            return;
        }

        _copiedMessageId = message.Id;
        StateHasChanged();

        await Task.Delay(1500);

        if (_disposed || _copiedMessageId != message.Id)
        {
            return;
        }

        _copiedMessageId = null;
        StateHasChanged();
    }

    /// <summary>工具调用明细（hover 时显示）。</summary>
    private static string ToolTip(ChatMessage message)
    {
        var lines = new List<string>
        {
            $"共调用 {message.ToolCalls.Values.Sum()} 次"
        };

        lines.AddRange(message.ToolCalls
            .OrderByDescending(pair => pair.Value)
            .ThenBy(pair => pair.Key, StringComparer.OrdinalIgnoreCase)
            .Select(pair => $"{pair.Key} × {pair.Value}"));

        return string.Join('\n', lines);
    }

    private static string FormatDuration(long milliseconds) =>
        milliseconds < 1000 ? $"{milliseconds} ms" : $"{milliseconds / 1000.0:0.0} s";

    private Task SetGeneratingAsync(bool isGenerating)
    {
        // 会话状态由组件先落下，外层只负责让侧栏重渲染；这样即使回调缺失也不会一直转圈。
        Session.IsGenerating = isGenerating;

        return OnGeneratingChanged.HasDelegate
            ? OnGeneratingChanged.InvokeAsync((Session, isGenerating))
            : Task.CompletedTask;
    }

    /// <summary>把当前选择写进设置，下次启动直接选中。</summary>
    private void RememberSelection()
    {
        var option = _modelOptions.FirstOrDefault(item => item.Key == _selectedKey);
        if (option is null)
        {
            return;
        }

        if (string.Equals(Settings.Current.LastProviderId, option.Provider.Id, StringComparison.Ordinal) &&
            string.Equals(Settings.Current.LastModelId, option.ModelId, StringComparison.Ordinal))
        {
            return;
        }

        Settings.Current.LastProviderId = option.Provider.Id;
        Settings.Current.LastModelId = option.ModelId;
        Settings.Save();
    }

    private async Task HandleSend(ComposerSubmission submission)
    {
        if (_isGenerating)
        {
            return;
        }

        if (string.IsNullOrWhiteSpace(submission.Text) && submission.Attachments.Count == 0)
        {
            return;
        }

        var mount = _activeMount;

        // 插件只吃文本：只带了附件时明确提示，不产生空的 Run。
        if (mount is not null && string.IsNullOrWhiteSpace(submission.Text))
        {
            Session.Messages.Add(new ChatMessage(
                ChatMessageRole.Assistant,
                "插件模式需要输入文本；附件不会传给插件。"));
            await NotifySessionChangedAsync();
            return;
        }

        await OnSend.InvokeAsync(submission);
        _draft = string.Empty;
        RememberSelection();

        var option = _modelOptions.FirstOrDefault(item => item.Key == _selectedKey);
        if (option is null)
        {
            Session.Messages.Add(new ChatMessage(
                ChatMessageRole.Assistant,
                "还没有可用的模型。请到「设置 → 模型设置」添加模型提供商，并把模型加入目录。"));
            await NotifySessionChangedAsync();
            return;
        }

        // 插件模式下发送 = 插件 Run，不是普通对话。
        if (mount is not null)
        {
            var plugin = _activePlugin ?? Registry.Find(mount.PluginId);

            // privacy.sendsText 的插件首次使用先确认一次（只提示一次，记在设置里）。
            if (NeedsPrivacyPrompt(plugin))
            {
                _privacyPlugin = plugin;
                _pendingAfterPrivacy = () => GenerateWithPluginAsync(option, mount, submission.Text);
                StateHasChanged();
                return;
            }

            await GenerateWithPluginAsync(option, mount, submission.Text);
        }
        else
        {
            await GenerateAsync(option);
        }
    }

    /// <summary>
    /// 测试入口（R1.2）：bUnit 不渲染 WebView2 的输入框 JS 交互，
    /// 直接走同一条 HandleSend → GenerateAsync 路径，用假 Runner 验证「无修改回灌」。
    /// </summary>
    internal Task SubmitForTestAsync(ComposerSubmission submission) => HandleSend(submission);

    /// <summary>这个插件的文本会发给模型服务商，且用户还没确认过。</summary>
    private bool NeedsPrivacyPrompt(PluginDescriptor? plugin) =>
        plugin is not null
        && plugin.Capabilities.Any(capability => capability.SendsText)
        && !Settings.Current.Plugins.PrivacyAcknowledged.Contains(plugin.Id, StringComparer.Ordinal);

    /// <summary>确认隐私提示：记住这个插件已确认，然后继续被打断的动作。</summary>
    private async Task ContinueAfterPrivacyAsync()
    {
        var plugin = _privacyPlugin;
        var action = _pendingAfterPrivacy;

        _privacyPlugin = null;
        _pendingAfterPrivacy = null;

        if (plugin is not null
            && !Settings.Current.Plugins.PrivacyAcknowledged.Contains(plugin.Id, StringComparer.Ordinal))
        {
            Settings.Current.Plugins.PrivacyAcknowledged.Add(plugin.Id);
            Settings.Save();
        }

        StateHasChanged();

        if (action is not null)
        {
            await action();
        }
    }

    private void CancelPrivacy()
    {
        _privacyPlugin = null;
        _pendingAfterPrivacy = null;
    }

    /// <summary>
    /// 用 Agent Framework 流式生成回复，边生成边写入会话。
    /// <para>
    /// 宿主追问（无修改回灌 / 自动验证）不再新开一条回复：它们作为步骤插进当前回合，
    /// 用户看到的始终是「一次发送 = 一个回合」。
    /// </para>
    /// </summary>
    private async Task GenerateAsync(ModelOption option)
    {
        _autoContinued = false;
        _noEditRepromptAttempts = 0;

        _isGenerating = true;
        await SetGeneratingAsync(true);

        using var cts = new CancellationTokenSource();
        _cts = cts;

        var scope = CurrentScope();
        var userInput = Session.Messages.LastOrDefault(message => message.Role == ChatMessageRole.User)?.Content ?? string.Empty;
        var reply = new ChatMessage(ChatMessageRole.Assistant, string.Empty)
        {
            CreatedAt = DateTime.Now,
            ProviderId = option.Provider.Id,
            ModelId = option.ModelId
        };

        // 普通推理开始：清空 LastPluginId，侧栏图标回到默认。
        Session.LastPluginId = null;

        Session.Messages.Add(reply);
        _openReasoning.Add(reply.Id);
        StateHasChanged();

        // 用户刚发完消息：无论之前翻到哪儿，都跳到底部跟新内容。
        await Js.InvokeVoidAsync("sdChat.jumpToBottom", _scrollElement);

        // 搜索等外部工具按用户选择；文件 / PDF / PowerShell 是内置能力，自动交给模型。
        var enabledPacks = EffectiveToolPacks();
        var telemetry = new ContextRunTelemetry();
        _contextNotice = null;

        // 宿主提示只发给模型、不单独上屏：它作为步骤挂在当前回合里。
        var pendingPrompts = new List<ChatMessage>();
        var rounds = 0;

        try
        {
            // 一次发送 = 一个回合；宿主追问在同一回合里继续生成，不再新建回复。
            while (true)
            {
                var history = new List<ChatMessage>();

                foreach (var message in Session.Messages)
                {
                    // 第一轮不能把「空的助手消息」发给模型；后续轮次要把已生成的部分带上。
                    if (rounds == 0 && ReferenceEquals(message, reply))
                    {
                        continue;
                    }

                    history.Add(message);
                }

                history.AddRange(pendingPrompts);
                pendingPrompts.Clear();

                var metrics = new AgentRunMetrics();
                var startedAt = Stopwatch.GetTimestamp();
                var baseline = reply.ToolTrace.Count;

                await ConsumeAsync(
                    reply,
                    Runner.StreamAsync(
                        new AgentRunRequest(
                            history,
                            option.Provider,
                            option.ModelId,
                            enabledPacks,
                            _selectedSkill,
                            Session.Id,
                            metrics,
                            Session: Session,
                            Scope: scope),
                        telemetry,
                        cts.Token),
                    telemetry,
                    metrics,
                    baseline,
                    rounds);

                ApplyMetrics(reply, metrics, startedAt, baseline, accumulate: rounds > 0, rounds);
                rounds++;

                if (rounds > MaxHostRounds || cts.IsCancellationRequested)
                {
                    break;
                }

                var noEdit = NoEditRepromptPolicy.Decide(
                    metrics,
                    userInput,
                    reply.Content,
                    _noEditRepromptAttempts,
                    Settings.Current.Agent.Mode == AgentModePreference.Compact);

                if (noEdit.Continue && noEdit.Prompt is { } noEditPrompt)
                {
                    _noEditRepromptAttempts++;
                    pendingPrompts.Add(new ChatMessage(ChatMessageRole.User, noEditPrompt));
                    await AppendHostPromptAsync(reply, noEditPrompt, rounds);
                    continue;
                }

                var auto = BuildAutoContinueDecision(metrics);
                if (auto.Continue && !_autoContinued && auto.Prompt is { } autoPrompt)
                {
                    _autoContinued = true;
                    pendingPrompts.Add(new ChatMessage(ChatMessageRole.User, autoPrompt));
                    await AppendHostPromptAsync(reply, autoPrompt, rounds);
                    continue;
                }

                break;
            }
        }
        finally
        {
            // 对标 DSH：思考结束后默认收起思维链，只留一行摘要；用户自己点开过的不动。
            if (!_manualReasoning.Contains(reply.Id))
            {
                _openReasoning.Remove(reply.Id);
            }

            _isGenerating = false;
            _cts = null;
            _contextPreview = telemetry.Report ?? _contextPreview;
            _contextNotice = telemetry.ContextNotice;
            await SetGeneratingAsync(false);

            if (!_disposed)
            {
                StateHasChanged();
            }

            await NotifySessionChangedAsync();

            // M3：归档会话继续对话时同步刷新索引，避免检索到旧内容。
            if (Session.IsArchived && !string.IsNullOrWhiteSpace(Session.WorkspaceId))
            {
                try
                {
                    Memory.Index(Session.WorkspaceId, Session.Id);
                }
                catch (Exception)
                {
                    // 索引失败不影响本轮；下次检索前的 EnsureIndexed 会重建。
                }
            }
        }
    }

    private AutoContinueDecision BuildAutoContinueDecision(AgentRunMetrics metrics)
    {
        var workspace = Settings.Current.Workspaces.FirstOrDefault(item =>
            !string.IsNullOrWhiteSpace(item.Path)
            && string.Equals(
                Path.TrimEndingDirectorySeparator(Path.GetFullPath(item.Path)),
                Path.TrimEndingDirectorySeparator(Path.GetFullPath(WorkspaceContext.RootPath)),
                StringComparison.OrdinalIgnoreCase));

        var suggestion = WorkspaceCommandDetector.Detect(WorkspaceContext.RootPath);
        var build = workspace?.BuildCommand ?? suggestion.BuildCommand;
        var test = workspace?.TestCommand ?? suggestion.TestCommand;

        return AutoContinuePolicy.Decide(
            Session,
            build,
            test,
            Settings.Current.Verification,
            _autoContinued ? 1 : 0,
            // 只有本轮真的改了文件才追问构建 / 测试；历史遗留的 dirty 不应该把聊天轮变成任务轮。
            hasNewEdits: NoEditRepromptPolicy.HasSuccessfulEdit(metrics.ToolTrace));
    }

    /// <summary>插件 Run：单轮、默认无历史、无全局技能；产物是一条带 Plugin 归属的普通助手消息。</summary>
    private async Task GenerateWithPluginAsync(ModelOption option, PluginMount mount, string text)
    {
        if (mount.Capability is not { } capability)
        {
            return;
        }

        var plugin = _activePlugin ?? Registry.Find(mount.PluginId);
        if (plugin is null || !plugin.IsUsable)
        {
            Session.Messages.Add(new ChatMessage(
                ChatMessageRole.Assistant,
                "这个插件当前不可用（可能被删除、禁用，或能力加载失败），请重新扫描或换一个插件。"));
            await NotifySessionChangedAsync();
            return;
        }

        _isGenerating = true;
        await SetGeneratingAsync(true);

        using var cts = new CancellationTokenSource();
        _cts = cts;

        var values = new Dictionary<string, string>(_parameterValues, StringComparer.Ordinal);
        var metrics = new AgentRunMetrics();
        var startedAt = Stopwatch.GetTimestamp();

        var reply = new ChatMessage(ChatMessageRole.Assistant, string.Empty)
        {
            CreatedAt = DateTime.Now,
            ProviderId = option.Provider.Id,
            ModelId = option.ModelId,
            // 参数快照随消息落库：重开还能看到当时用的是什么语言。
            Plugin = new PluginMessageInfo(plugin.Id, mount.Id, capability.Id, values, null)
        };

        Session.Messages.Add(reply);
        Session.LastPluginId = plugin.Id;
        _openReasoning.Add(reply.Id);
        StateHasChanged();

        try
        {
            var request = new PluginRunRequest(
                plugin,
                mount,
                values,
                text,
                option.Provider,
                option.ModelId,
                metrics);

            await ConsumePluginAsync(reply, capability, PluginRunner.RunComposerAsync(request, cts.Token));
        }
        finally
        {
            ApplyMetrics(reply, metrics, startedAt, traceBaseline: 0, accumulate: false, stepIndex: 0);

            // 对标 DSH：思考结束后默认收起思维链，只留一行摘要；用户自己点开过的不动。
            if (!_manualReasoning.Contains(reply.Id))
            {
                _openReasoning.Remove(reply.Id);
            }

            _isGenerating = false;
            _cts = null;
            await SetGeneratingAsync(false);

            if (!_disposed)
            {
                StateHasChanged();
            }

            await NotifySessionChangedAsync();
        }
    }

    /// <summary>
    /// 插件 Run 的流式收尾：<c>output = segments</c> 的能力边收边解析成段落，其余能力按纯文本累积。
    /// </summary>
    private async Task ConsumePluginAsync(
        ChatMessage reply,
        PluginCapability capability,
        IAsyncEnumerable<AgentDelta> stream)
    {
        var accumulator = capability.OutputFormat == PluginOutputFormat.Segments
            ? new SegmentedOutputAccumulator(MaxArtifactTextChars)
            : null;

        try
        {
            await foreach (var delta in stream)
            {
                if (delta.Text.Length > 0)
                {
                    if (accumulator is null)
                    {
                        reply.Content += delta.Text;
                    }
                    else
                    {
                        accumulator.Append(delta.Text);
                        ApplySegments(reply, accumulator.Parse());
                    }
                }

                if (delta.Reasoning.Length > 0)
                {
                    reply.Reasoning += delta.Reasoning;
                }

                StateHasChanged();
            }

            if (accumulator is not null)
            {
                ApplySegments(reply, accumulator.Parse(final: true));
            }

            if (accumulator is { Truncated: true })
            {
                AppendTruncationNote(reply);
            }
        }
        catch (OperationCanceledException)
        {
            // 用户点了停止：把已经解析出的段落收尾，保留部分结果。
            if (accumulator is not null)
            {
                ApplySegments(reply, accumulator.Parse(final: true));
            }
        }
        catch (Exception ex)
        {
            if (accumulator is not null)
            {
                ApplySegments(reply, accumulator.Parse(final: true));
            }

            var message = $"调用失败：{ex.Message}";

            if (reply.Plugin?.Segments is { Count: > 0 } segments)
            {
                // 有段落结构时把错误单独加成一段，两种呈现方式下都能看到。
                reply.Plugin = reply.Plugin with
                {
                    Segments = [.. segments, new OutputSegment(string.Empty, message)]
                };
                reply.Content = string.IsNullOrWhiteSpace(reply.Content)
                    ? message
                    : reply.Content + "\n\n" + message;
            }
            else
            {
                var prefix = string.IsNullOrWhiteSpace(reply.Content) ? string.Empty : "\n\n";
                reply.Content += $"{prefix}{message}";
            }
        }
    }

    /// <summary>把解析结果写回消息：正文用纯译文，段落结构随 PluginJson 落库。</summary>
    private static void ApplySegments(ChatMessage reply, SegmentedParseResult parsed)
    {
        reply.Content = parsed.Text;

        if (reply.Plugin is { } info)
        {
            reply.Plugin = info with
            {
                Segments = parsed.Segments.Count > 0 ? parsed.Segments : null
            };
        }
    }

    private static void AppendTruncationNote(ChatMessage reply)
    {
        const string note = "\n\n…（结果过长，已截断）";
        reply.Content += note;

        if (reply.Plugin?.Segments is { Count: > 0 } segments)
        {
            var last = segments[^1];
            reply.Plugin = reply.Plugin with
            {
                Segments = [.. segments.Take(segments.Count - 1), last with { Target = last.Target + note }]
            };
        }
    }

    /// <summary>普通对话的流式累积：正文原样追加，出错追加可读提示。</summary>
    private async Task ConsumeAsync(
        ChatMessage reply,
        IAsyncEnumerable<AgentDelta> stream,
        ContextRunTelemetry telemetry,
        AgentRunMetrics metrics,
        int traceBaseline,
        int stepIndex)
    {
        try
        {
            await foreach (var delta in stream)
            {
                if (delta.Text.Length > 0)
                {
                    reply.Content += delta.Text;
                    AppendStep(reply, ChatStepKind.Text, delta.Text, stepIndex);
                }

                if (delta.Reasoning.Length > 0)
                {
                    reply.Reasoning += delta.Reasoning;
                    AppendStep(reply, ChatStepKind.Reasoning, delta.Reasoning, stepIndex);
                }

                // 工具轨迹边跑边同步：「工具调用 N 次」和文件改动面板在生成过程中就能看到。
                SyncTrace(reply, metrics, traceBaseline, stepIndex);

                // 中途裁剪 / 中途提示需要让用户看到，但仍不进模型上下文。
                if (!string.IsNullOrWhiteSpace(telemetry.ContextNotice))
                {
                    _contextNotice = telemetry.ContextNotice;
                }

                StateHasChanged();
            }
        }
        catch (OperationCanceledException)
        {
            // 用户点了停止。
        }
        catch (ContextBudgetException ex)
        {
            // 发送前的预算拦截：只给宿主提示，不在气泡里伪造一段「模型回复」。
            _contextPreview = ex.Report ?? _contextPreview;
            _contextNotice = ex.Message;
            if (string.IsNullOrWhiteSpace(reply.Content))
            {
                Session.Messages.Remove(reply);
            }
        }
        catch (Exception ex)
        {
            var prefix = string.IsNullOrWhiteSpace(reply.Content) ? string.Empty : "\n\n";
            var message = $"{prefix}调用失败：{ex.Message}";

            reply.Content += message;

            // 走时间线时正文是按步骤拼出来的：错误也必须落成一步，否则会被组外答案漏掉。
            AppendStep(reply, ChatStepKind.Text, message, stepIndex);
        }
    }

    private static void ApplyMetrics(
        ChatMessage reply,
        AgentRunMetrics metrics,
        long startedAt,
        int traceBaseline,
        bool accumulate,
        int stepIndex)
    {
        var duration = (long)Stopwatch.GetElapsedTime(startedAt).TotalMilliseconds;

        reply.DurationMs = accumulate ? reply.DurationMs + duration : duration;
        reply.InputTokens = accumulate ? reply.InputTokens + metrics.InputTokens : metrics.InputTokens;
        reply.OutputTokens = accumulate ? reply.OutputTokens + metrics.OutputTokens : metrics.OutputTokens;
        reply.ApprovalCount += metrics.ApprovalCount;

        // 同一回合里可能跑了几轮（宿主追问）：按轮累加，不互相覆盖。
        foreach (var pair in metrics.ToolCalls)
        {
            reply.ToolCalls[pair.Key] = reply.ToolCalls.GetValueOrDefault(pair.Key) + pair.Value;
        }

        // 回合末再同步一次：补上中途没推到的条目，并把还在 running 的轨迹收成最终状态。
        SyncTrace(reply, metrics, traceBaseline, stepIndex);

        foreach (var citation in metrics.Citations)
        {
            if (!reply.MemoryCitations.Any(item =>
                    string.Equals(item.SessionId, citation.SessionId, StringComparison.Ordinal)))
            {
                reply.MemoryCitations.Add(citation);
            }
        }
    }

    /// <summary>
    /// 完成态的消息是否把过程组默认收起来。
    /// <para>
    /// 三条规则：档位要求收起；这一轮已经不在生成（正在跑的一律展开）；收起时机是「下一条输入」时，
    /// 最后一条助手消息保持展开，直到用户又发了新消息。
    /// </para>
    /// </summary>
    private bool CanFoldProcess(ChatMessage message, ProcessDisplayPolicy policy)
    {
        if (!policy.FoldCompletedTurns || policy.Grouping != ProcessGrouping.Collapsed)
        {
            return false;
        }

        if (IsThinking(message))
        {
            return false;
        }

        if (policy.CollapseTiming == ProcessCollapseTiming.NextInput
            && ReferenceEquals(message, Session.Messages.LastOrDefault(item => item.Role == ChatMessageRole.Assistant)))
        {
            return false;
        }

        // 还在跑的工具等于「这一轮没结束」：不让进行中的过程被收起。
        return !message.ToolTrace.Any(entry =>
            string.Equals(entry.Status, ToolTraceEntry.StatusRunning, StringComparison.Ordinal));
    }

    /// <summary>
    /// 一条消息的步骤时间线：生成中的消息直接读实时步骤；
    /// 重开会话的历史消息没有实时步骤，就按工具轨迹里的字符边界还原。
    /// </summary>
    private static IReadOnlyList<ChatStep> StepsFor(ChatMessage message)
    {
        if (message.Steps.Count > 0)
        {
            return message.Steps;
        }

        return message.Role == ChatMessageRole.Assistant && message.ToolTrace.Count > 0
            ? ChatTimelineBuilder.FromTrace(message.Reasoning, message.Content, message.ToolTrace)
            : [];
    }

    /// <summary>把一段增量并进当前步骤；类型不同就开新的一步（思考 → 工具 → 思考 …）。</summary>
    private static void AppendStep(ChatMessage reply, ChatStepKind kind, string delta, int stepIndex)
    {
        if (delta.Length == 0)
        {
            return;
        }

        if (reply.Steps.Count > 0 && reply.Steps[^1].CanAppend(kind))
        {
            reply.Steps[^1] = reply.Steps[^1].Append(delta);
            return;
        }

        reply.Steps.Add(new ChatStep(kind, delta, StepIndex: stepIndex, StartedAt: DateTimeOffset.Now));
    }

    /// <summary>把本轮的实时工具轨迹同步到消息上，生成过程中就能看到调用了什么。</summary>
    /// <param name="baseline">这一轮开始时消息上已有的轨迹条数（宿主追问会开新一轮，但不该重复插步骤）。</param>
    /// <param name="stepIndex">这一轮是第几次模型请求；工具步骤按它归组。</param>
    private static void SyncTrace(ChatMessage reply, AgentRunMetrics metrics, int baseline, int stepIndex)
    {
        // 工具开始 / 结束时都会推一次增量：已有条目原地更新（running → 成功 / 失败），
        // 新条目才追加，这样「运行中」能立刻出现在时间线里。
        for (var sourceIndex = 0; sourceIndex < metrics.ToolTrace.Count; sourceIndex++)
        {
            var targetIndex = baseline + sourceIndex;
            var entry = metrics.ToolTrace[sourceIndex];

            if (targetIndex < reply.ToolTrace.Count)
            {
                if (!Equals(reply.ToolTrace[targetIndex], entry))
                {
                    reply.ToolTrace[targetIndex] = entry;
                }

                continue;
            }

            reply.ToolTrace.Add(entry);
            reply.Steps.Add(new ChatStep(
                ChatStepKind.Tool,
                string.Empty,
                reply.ToolTrace.Count - 1,
                stepIndex,
                entry.CallId,
                DateTimeOffset.Now));
        }
    }

    /// <summary>把宿主追问插进当前回合（只发给模型，不新开一条回复）。</summary>
    private async Task AppendHostPromptAsync(ChatMessage reply, string prompt, int stepIndex)
    {
        reply.Steps.Add(new ChatStep(ChatStepKind.HostPrompt, prompt, StepIndex: stepIndex));
        StateHasChanged();
        await NotifySessionChangedAsync();
    }

    /// <summary>通知外层把最新会话写回 SQLite（取消 / 出错时也保存已生成的部分）。</summary>
    private Task NotifySessionChangedAsync() =>
        OnSessionChanged.HasDelegate ? OnSessionChanged.InvokeAsync(Session) : Task.CompletedTask;

    /// <summary>用户点停止：终止生成，并拒绝所有排队中的审批（包括沙箱执行）。</summary>
    private void HandleStop()
    {
        _cts?.Cancel();
        Approvals.CancelAll();
    }

    /// <summary>气泡上可用的插件入口（message 界面、已被用户启用），参数按会话记忆解析。</summary>
    private IReadOnlyList<PluginActionEntry> BuildMessagePluginActions()
    {
        var entries = new List<PluginActionEntry>();

        foreach (var mount in Registry.Mounts(PluginSurface.Message))
        {
            var plugin = Registry.Find(mount.PluginId);
            if (plugin is null || mount.Capability is not { } capability)
            {
                continue;
            }

            entries.Add(new PluginActionEntry(
                plugin,
                mount,
                ParameterResolver.Resolve(capability, plugin.Id, mount.Id, MemoryForResolve())));
        }

        return entries;
    }

    private string PluginDisplayName(string pluginId) => Registry.DisplayName(pluginId);

    /// <summary>气泡按钮触发：新建一张派生卡片并开始流式加工（原文 = 该条消息的正文）。</summary>
    private async Task RunArtifactAsync(ChatMessage message, PluginActionEntry entry)
    {
        if (NeedsPrivacyPrompt(entry.Plugin))
        {
            _privacyPlugin = entry.Plugin;
            _pendingAfterPrivacy = () => RunArtifactCoreAsync(message, entry);
            StateHasChanged();
            return;
        }

        await RunArtifactCoreAsync(message, entry);
    }

    private async Task RunArtifactCoreAsync(ChatMessage message, PluginActionEntry entry)
    {
        // 单飞：同一会话同一时间只允许一个 Run。
        if (_isGenerating || message.Derived.Count >= MaxArtifactsPerMessage)
        {
            return;
        }

        var option = _modelOptions.FirstOrDefault(item => item.Key == _selectedKey);
        if (option is null)
        {
            message.Derived.Add(new DerivedArtifact(
                Guid.NewGuid().ToString("N"),
                entry.Plugin.Id,
                entry.Mount.Id,
                entry.Mount.CapabilityId,
                entry.Values,
                null,
                string.Empty,
                DerivedState.Failed,
                "未配置模型：请先到「设置 → 模型设置」添加模型",
                string.Empty,
                0,
                0,
                0,
                DateTime.Now));

            StateHasChanged();
            await NotifySessionChangedAsync();
            return;
        }

        // 气泡 Run 也写会话记忆：下次再点同一个插件，语言还是上次选的。
        RememberArtifactValues(entry);

        message.Derived.Add(new DerivedArtifact(
            Guid.NewGuid().ToString("N"),
            entry.Plugin.Id,
            entry.Mount.Id,
            entry.Mount.CapabilityId,
            entry.Values,
            null,
            string.Empty,
            DerivedState.Running,
            null,
            option.ModelId,
            0,
            0,
            0,
            DateTime.Now));

        await ExecuteArtifactAsync(message, message.Derived.Count - 1, entry, option);
    }

    /// <summary>重试：沿用同一插件 / 参数，把卡片重置成 Running 再跑一次。</summary>
    private async Task RetryArtifactAsync(ChatMessage message, DerivedArtifact artifact)
    {
        if (_isGenerating)
        {
            return;
        }

        var index = message.Derived.FindIndex(item => string.Equals(item.Id, artifact.Id, StringComparison.Ordinal));
        if (index < 0)
        {
            return;
        }

        var plugin = Registry.Find(artifact.PluginId);

        // 重试是对已有卡片本身的动作：只要插件还启用就允许，不要求「气泡」开关还开着
        // （关掉气泡只是不再显示新按钮，不该让旧卡片点重试就报「不可用」）。
        var mount = plugin?.Mounts.FirstOrDefault(item =>
            item.IsUsable && string.Equals(item.Id, artifact.MountId, StringComparison.Ordinal));

        if (plugin is null || mount?.Capability is null)
        {
            message.Derived[index] = artifact with { State = DerivedState.Failed, Error = "插件已被删除或不再可用" };
            StateHasChanged();
            await NotifySessionChangedAsync();
            return;
        }

        var option = _modelOptions.FirstOrDefault(item => item.Key == _selectedKey);
        if (option is null)
        {
            message.Derived[index] = artifact with { State = DerivedState.Failed, Error = "未配置模型：请先到「设置 → 模型设置」添加模型" };
            StateHasChanged();
            await NotifySessionChangedAsync();
            return;
        }

        message.Derived[index] = artifact with
        {
            State = DerivedState.Running,
            Error = null,
            Text = string.Empty,
            DurationMs = 0,
            InputTokens = 0,
            OutputTokens = 0,
            ModelId = option.ModelId
        };

        await ExecuteArtifactAsync(message, index, new PluginActionEntry(plugin, mount, artifact.Values), option);
    }

    /// <summary>跑一次派生卡片：流式写入 Text，收尾时写状态与指标。</summary>
    private async Task ExecuteArtifactAsync(
        ChatMessage message,
        int index,
        PluginActionEntry entry,
        ModelOption option)
    {
        _isGenerating = true;
        _runningMountKey = entry.Mount.Key;

        // 插件 Run 开始：会话图标跟随这个插件。
        Session.LastPluginId = entry.Plugin.Id;
        await SetGeneratingAsync(true);

        using var cts = new CancellationTokenSource();
        _cts = cts;

        var metrics = new AgentRunMetrics();
        var startedAt = Stopwatch.GetTimestamp();
        StateHasChanged();

        var capability = entry.Mount.Capability;
        var accumulator = capability?.OutputFormat == PluginOutputFormat.Segments
            ? new SegmentedOutputAccumulator(MaxArtifactTextChars)
            : null;

        try
        {
            var request = new PluginRunRequest(
                entry.Plugin,
                entry.Mount,
                entry.Values,
                message.Content,
                option.Provider,
                option.ModelId,
                metrics);

            await foreach (var delta in PluginRunner.RunArtifactAsync(request, cts.Token))
            {
                if (delta.Text.Length == 0)
                {
                    continue;
                }

                var current = message.Derived[index];

                if (accumulator is not null)
                {
                    accumulator.Append(delta.Text);
                    var parsed = accumulator.Parse();
                    message.Derived[index] = current with
                    {
                        Text = parsed.Text,
                        Segments = parsed.Segments.Count > 0 ? parsed.Segments : null
                    };
                }
                else
                {
                    var text = current.Text + delta.Text;
                    if (text.Length > MaxArtifactTextChars)
                    {
                        text = string.Concat(text.AsSpan(0, MaxArtifactTextChars), "\n\n…（结果过长，已截断）");
                    }

                    message.Derived[index] = current with { Text = text };
                }

                StateHasChanged();
            }

            if (accumulator is not null)
            {
                FinalizeArtifactSegments(message, index, accumulator);
            }

            if (accumulator is { Truncated: true })
            {
                AppendArtifactTruncationNote(message, index);
            }

            message.Derived[index] = message.Derived[index] with { State = DerivedState.Done };
        }
        catch (OperationCanceledException)
        {
            if (accumulator is not null)
            {
                FinalizeArtifactSegments(message, index, accumulator);
            }

            message.Derived[index] = message.Derived[index] with { State = DerivedState.Canceled };
        }
        catch (Exception ex)
        {
            if (accumulator is not null)
            {
                FinalizeArtifactSegments(message, index, accumulator);
            }

            message.Derived[index] = message.Derived[index] with { State = DerivedState.Failed, Error = ex.Message };
        }
        finally
        {
            message.Derived[index] = message.Derived[index] with
            {
                DurationMs = (long)Stopwatch.GetElapsedTime(startedAt).TotalMilliseconds,
                InputTokens = metrics.InputTokens,
                OutputTokens = metrics.OutputTokens
            };

            _isGenerating = false;
            _runningMountKey = null;
            _cts = null;
            await SetGeneratingAsync(false);

            if (!_disposed)
            {
                StateHasChanged();
            }

            await NotifySessionChangedAsync();
        }
    }

    private static void FinalizeArtifactSegments(
        ChatMessage message,
        int index,
        SegmentedOutputAccumulator accumulator)
    {
        var parsed = accumulator.Parse(final: true);
        var current = message.Derived[index];
        message.Derived[index] = current with
        {
            Text = parsed.Text,
            Segments = parsed.Segments.Count > 0 ? parsed.Segments : null
        };
    }

    private static void AppendArtifactTruncationNote(ChatMessage message, int index)
    {
        const string note = "\n\n…（结果过长，已截断）";
        var current = message.Derived[index];
        var segments = current.Segments;

        if (segments is { Count: > 0 })
        {
            var last = segments[^1];
            segments = [.. segments.Take(segments.Count - 1), last with { Target = last.Target + note }];
        }

        message.Derived[index] = current with
        {
            Text = current.Text + note,
            Segments = segments
        };
    }

    private async Task DeleteArtifactAsync(ChatMessage message, DerivedArtifact artifact)
    {
        if (artifact.IsRunning)
        {
            return;
        }

        var index = message.Derived.FindIndex(item => string.Equals(item.Id, artifact.Id, StringComparison.Ordinal));
        if (index < 0)
        {
            return;
        }

        message.Derived.RemoveAt(index);
        StateHasChanged();
        await NotifySessionChangedAsync();
    }

    private void RememberArtifactValues(PluginActionEntry entry)
    {
        // 设置里关掉「记住参数值」时不写会话记忆。
        if (!Registry.Preferences.RememberParameterValues)
        {
            return;
        }

        foreach (var pair in entry.Values)
        {
            Session.PluginMemory[PluginParameterResolver.MemoryKey(entry.Plugin.Id, entry.Mount.Id, pair.Key)] = pair.Value;
        }
    }

    /// <summary>呈现方式（对照 / 纯译文）的记忆键：按插件记，三个入口共用。</summary>
    private static string ModeMemoryKey(string pluginId) =>
        $"{pluginId}/{PluginParameterResolver.OutputModeKey}";

    /// <summary>当前呈现方式：会话记忆优先，没有就用设置里的新会话默认值。</summary>
    private PluginOutputMode ModeFor(string pluginId)
    {
        if (Session.PluginMemory.TryGetValue(ModeMemoryKey(pluginId), out var value))
        {
            return string.Equals(value, "translation", StringComparison.OrdinalIgnoreCase)
                ? PluginOutputMode.Translation
                : PluginOutputMode.Bilingual;
        }

        return Registry.Preferences.DefaultOutputMode;
    }

    /// <summary>切换呈现方式：纯渲染，不重新请求模型；状态按会话记忆。</summary>
    private async Task SetOutputModeAsync(string pluginId, PluginOutputMode mode)
    {
        Session.PluginMemory[ModeMemoryKey(pluginId)] =
            mode == PluginOutputMode.Translation ? "translation" : "bilingual";

        StateHasChanged();
        await PersistSelectionAsync();
    }

    /// <summary>这个产物本来是不是要按段落返回（用来区分「纯文本能力」与「模型没按格式返回」）。</summary>
    private bool SegmentsExpected(DerivedArtifact artifact) =>
        Registry.Find(artifact.PluginId)?.FindCapability(artifact.CapabilityId)?.OutputFormat
        == PluginOutputFormat.Segments;

    public void Dispose()
    {
        _disposed = true;
        Settings.Changed -= OnSettingsChanged;
        Registry.Changed -= OnRegistryChanged;

        // 组件被整体移除（关窗 / 页面切换）时别留下一个孤儿生成：
        // 取消流并把侧栏状态收回。审批宿主在 AppShell 顶层，不受这里影响。
        if (_cts is not null)
        {
            _cts.Cancel();
            _cts = null;
        }

        if (_isGenerating)
        {
            _isGenerating = false;
            Session.IsGenerating = false;
        }
    }
}
