@using SDemo.DesktopAgent.Context
@using SDemo.DesktopAgent.Models
@using SDemo.DesktopAgent.Services

@* 按真实顺序排列的过程，以及永远在组外的答案。
   过程组只装「思考 / 工具 / 宿主追问」；正文（答案）永远渲染在组外，折叠不会藏掉回答。 *@
@if (Steps.Count > 0)
{
    var processSteps = Steps.Where(step => step.Part == ChatGroupPart.Process).ToList();
    var answerText = string.Concat(Steps.Where(step => step.Part == ChatGroupPart.Answer).Select(step => step.Text));

    <div class="timeline">
        @if (Policy.Grouping == ProcessGrouping.None)
        {
            @* 完全展开：不分组，按真实顺序平铺（正文也留在原位）。 *@
            @for (var index = 0; index < Steps.Count; index++)
            {
                var step = Steps[index];

                <ChatStepRow Step="step"
                             Trace="Trace"
                             IsThinking="@(IsLive && index == Steps.Count - 1)"
                             PreviewEnabled="Policy.SettledReasoningPreview" />
            }
        }
        else
        {
            @if (processSteps.Count > 0)
            {
                <div class="process-group @(Expanded ? "is-open" : null)">
                    <button type="button"
                            class="process-head"
                            aria-expanded="@(Expanded ? "true" : "false")"
                            @onclick="Toggle">
                        <span class="process-caret @(Expanded ? "is-open" : null)">▸</span>
                        <span class="process-title">@Title</span>
                        <span class="process-meta">@Meta</span>
                        @if (!Expanded && Preview is { Length: > 0 } preview)
                        {
                            <span class="process-preview">@preview</span>
                        }
                    </button>

                    @if (Expanded)
                    {
                        <div class="process-body">
                            @for (var index = 0; index < processSteps.Count; index++)
                            {
                                var step = processSteps[index];

                                <ChatStepRow Step="step"
                                             Trace="Trace"
                                             IsThinking="@(IsLive && !HasRunningTool && index == processSteps.Count - 1)"
                                             PreviewEnabled="Policy.SettledReasoningPreview" />
                            }
                        </div>
                    }
                </div>
            }

            @if (!string.IsNullOrWhiteSpace(answerText))
            {
                <div class="msg-body msg-body--markdown timeline-answer">
                    @((MarkupString)MarkdownRenderer.ToHtml(answerText))
                </div>
            }
        }
    </div>
}

@code {
    /// <summary>步骤时间线；由 ChatRoom 按实时事件或历史边界还原。</summary>
    [Parameter] public IReadOnlyList<ChatStep> Steps { get; set; } = [];

    /// <summary>步骤里的 Tool 步骤按索引取这里的条目。</summary>
    [Parameter] public IReadOnlyList<ToolTraceEntry> Trace { get; set; } = [];

    /// <summary>还在生成：最后一步是思考时显示「思考中…」，组头显示运行状态。</summary>
    [Parameter] public bool IsLive { get; set; }

    /// <summary>完成态是否默认收起（由档位与收起时机决定，ChatRoom 算好传进来）。</summary>
    [Parameter] public bool Foldable { get; set; }

    /// <summary>本回合耗时（毫秒）；0 表示未知。</summary>
    [Parameter] public long ElapsedMs { get; set; }

    /// <summary>过程展示策略。</summary>
    [Parameter] public ProcessDisplayPolicy Policy { get; set; } = ProcessDisplayPolicy.For(ProcessDisplayMode.Standard);

    /// <summary>用户手动开合过：自动收起不再覆盖他。</summary>
    private bool? _manual;

    private bool HasRunningTool =>
        Trace.Any(entry => string.Equals(entry.Status, ToolTraceEntry.StatusRunning, StringComparison.Ordinal));

    private bool Running => IsLive || HasRunningTool;

    /// <summary>展开 = 手动选择，否则由「能否收起」和「是否正在跑」决定。</summary>
    private bool Expanded => _manual ?? !(Foldable && !Running);

    private int ToolCount => Trace.Count;

    private int FailureCount => Trace.Count(entry => ToolPresentation.IsFailure(entry.Status));

    private string Title => Running
        ? (HasRunningTool ? "运行工具中…" : "思考中…")
        : ElapsedMs > 0 ? $"过程 · {FormatDuration(ElapsedMs)}" : "过程";

    private string Meta
    {
        get
        {
            var parts = new List<string>(3)
            {
                $"{Steps.Count(step => step.Part == ChatGroupPart.Process)} 步"
            };

            if (ToolCount > 0)
            {
                parts.Add($"{ToolCount} 次工具");
            }

            if (FailureCount > 0)
            {
                parts.Add($"失败 {FailureCount}");
            }

            return string.Join(" · ", parts);
        }
    }

    /// <summary>收起时贴一行「最近在想什么」：优先最新思考的最后一行，其次最后一条工具摘要。</summary>
    private string? Preview
    {
        get
        {
            if (!Policy.SettledReasoningPreview)
            {
                return null;
            }

            var reasoning = Steps.LastOrDefault(step =>
                step.Part == ChatGroupPart.Process
                && step.Kind == ChatStepKind.Reasoning
                && !string.IsNullOrWhiteSpace(step.Text));

            if (reasoning is not null)
            {
                var lastLine = LastNonEmptyLine(reasoning.Text);

                if (lastLine.Length > 0)
                {
                    return Clip(lastLine);
                }
            }

            return Trace.LastOrDefault()?.Summary is { Length: > 0 } summary
                ? Clip(summary.ReplaceLineEndings(" ").Trim())
                : null;
        }
    }

    private void Toggle() => _manual = !Expanded;

    /// <summary>
    /// 每帧都渲染：流式期间 <see cref="Steps"/> 与 <see cref="Trace"/> 的**引用不变**、只有内容在变
    /// （轨迹条目按 CallId 原地替换），Blazor 的参数比较会认为没变而跳过整个子树。
    /// </summary>
    protected override bool ShouldRender() => true;

    private static string LastNonEmptyLine(string text) =>
        text.Split('\n').LastOrDefault(line => !string.IsNullOrWhiteSpace(line))?.Trim() ?? string.Empty;

    private static string Clip(string text) =>
        text.Length <= 72 ? text : string.Concat(text.AsSpan(0, 72), "…");

    private static string FormatDuration(long milliseconds) =>
        milliseconds < 1000 ? $"{milliseconds} ms" : $"{milliseconds / 1000.0:0.0} s";
}
