@using SDemo.DesktopAgent.Models
@using SDemo.DesktopAgent.Execution
@using SDemo.DesktopAgent.Sandbox
@inject ISettingsService Settings
@inject ISearchService Search
@inject ISandboxJobService Sandbox
@inject ISandboxMaintenance Maintenance
@inject IAppEnvironmentService Environment
@inject IAppPaths Paths
@inject AgentToolRegistry ToolRegistry
@inject SessionGrantStore Grants

@* 工具设置：联网搜索后端 + 文件写入确认 *@
<div class="settings-pane">
    <section class="settings-section">
        <h2 class="settings-section-title">联网搜索</h2>
        <p class="settings-section-hint">默认使用必应 RSS（免密钥）；也可以填自己的搜索接口地址与 Key。</p>

        <div class="segmented">
            <button type="button"
                    class="segmented-item @(Settings.Current.Search.Backend == SearchBackend.Bing ? "is-active" : null)"
                    @onclick="() => SetBackend(SearchBackend.Bing)">
                必应 RSS
            </button>
            <button type="button"
                    class="segmented-item @(Settings.Current.Search.Backend == SearchBackend.Custom ? "is-active" : null)"
                    @onclick="() => SetBackend(SearchBackend.Custom)">
                自定义 API
            </button>
        </div>

        @if (Settings.Current.Search.Backend == SearchBackend.Custom)
        {
            <div class="field field--wide">
                <span class="field-label">接口地址</span>
                <input class="field-input"
                       @bind="_endpoint"
                       @bind:event="oninput"
                       placeholder="https://open.feedcoopapi.com/search_api/global_search" />
                <span class="field-hint">按 POST 提交 JSON（query / top_k），返回 JSON 即可。</span>
            </div>

            <div class="field field--wide">
                <span class="field-label">API Key</span>
                <span class="field-secret">
                    <input class="field-input"
                           type="@(_showKey ? "text" : "password")"
                           @bind="_apiKey"
                           @bind:event="oninput"
                           autocomplete="off"
                           placeholder="可留空" />
                    <button type="button" class="field-secret-toggle" @onclick="() => _showKey = !_showKey">
                        @(_showKey ? "隐藏" : "显示")
                    </button>
                </span>
            </div>

            <div class="editor-footer">
                <button type="button" class="ghost-button" disabled="@_isTesting" @onclick="TestSearchAsync">
                    @(_isTesting ? "测试中…" : "测试搜索")
                </button>
                <button type="button" class="primary-button" @onclick="SaveSearch">保存</button>
            </div>
        }
        else
        {
            <div class="editor-footer">
                <button type="button" class="ghost-button" disabled="@_isTesting" @onclick="TestSearchAsync">
                    @(_isTesting ? "测试中…" : "测试搜索")
                </button>
            </div>
        }

        @if (_message is not null)
        {
            <p class="settings-message">@_message</p>
        }

        @if (_searchResult is not null)
        {
            <pre class="search-preview">@_searchResult</pre>
        }
    </section>

    <section class="settings-section">
        <h2 class="settings-section-title">代码编辑</h2>
        <p class="settings-section-hint">
            文件工具拆成只读与写入两个包。只读包提供按行读取、搜索、glob 与目录树；
            写入包提供 apply_patch 与 write_file。写入前默认需要确认。
        </p>

        <label class="settings-row settings-row--toggle">
            <span class="settings-row-text">
                <span class="settings-row-title">文件读取与搜索（默认开启）</span>
                <span class="settings-row-hint">read_file / search_files / glob_files / list_tree / list_files。</span>
            </span>
            <input type="checkbox"
                   class="switch"
                   checked="@IsPackEnabled("files")"
                   @onchange="ToggleFiles" />
        </label>

        <label class="settings-row settings-row--toggle">
            <span class="settings-row-text">
                <span class="settings-row-title">代码编辑（默认开启）</span>
                <span class="settings-row-hint">apply_patch / write_file；改已有文件前必须先读。</span>
            </span>
            <input type="checkbox"
                   class="switch"
                   checked="@IsPackEnabled("edits")"
                   @onchange="ToggleEdits" />
        </label>
    </section>

    <section class="settings-section">
        <h2 class="settings-section-title">工具预算与路由</h2>
        <p class="settings-section-hint">
            每轮只把「核心集 + 按需工具包」交给模型，其余工具按关键词路由；
            工具 schema 单独占一段预算（8K 窗口上限 1.5K token）。
        </p>

        <div class="settings-grid">
            <label class="field">
                <span class="field-label">每轮最多暴露工具数</span>
                <input class="field-input"
                       type="number"
                       min="0"
                       max="24"
                       value="@Settings.Current.Agent.MaxExposedTools"
                       @onchange="ChangeMaxExposedTools" />
                <span class="field-hint">0 = 自动（8K 6 个、32K 12 个）；1–24 手动覆盖。</span>
            </label>
        </div>

        <label class="settings-row settings-row--toggle">
            <span class="settings-row-text">
                <span class="settings-row-title">临时全量暴露（排障用）</span>
                <span class="settings-row-hint">
                    路由漏工具时切回旧行为：所有启用工具都交给模型，仍受窗口工具段预算限制。
                </span>
            </span>
            <input type="checkbox"
                   class="switch"
                   checked="@Settings.Current.Agent.ExposeAllTools"
                   @onchange="ToggleExposeAll" />
        </label>

        <label class="settings-row settings-row--toggle">
            <span class="settings-row-text">
                <span class="settings-row-title">内置工具循环（P1a，实验）</span>
                <span class="settings-row-hint">
                    宿主自己跑「请求 → 工具 → 结果回灌 → 再请求」：工具调用与结果按真实消息进历史，
                    界面能按「第几步」归组；关闭时仍走 MAF 的 FunctionInvokingChatClient。
                </span>
            </span>
            <input type="checkbox"
                   class="switch"
                   checked="@Settings.Current.Agent.NativeLoop"
                   @onchange="ToggleNativeLoop" />
        </label>

        <label class="settings-row settings-row--toggle">
            <span class="settings-row-text">
                <span class="settings-row-title">提供 search_capabilities 兜底入口</span>
                <span class="settings-row-hint">模型可自查当前会话可用的工具；默认开启，只影响 Full 模式。</span>
            </span>
            <input type="checkbox"
                   class="switch"
                   checked="@Settings.Current.Agent.SearchCapabilitiesEnabled"
                   @onchange="ToggleSearchCapabilities" />
        </label>

        <label class="settings-row settings-row--toggle">
            <span class="settings-row-text">
                <span class="settings-row-title">系统提示注入技能索引</span>
                <span class="settings-row-hint">
                    只放「名字 · 一句话 · 何时用」（20 个技能约 400 token）；正文由 load_skill 按需读取，手选技能仍全文注入。
                </span>
            </span>
            <input type="checkbox"
                   class="switch"
                   checked="@Settings.Current.Agent.SkillIndexEnabled"
                   @onchange="ToggleSkillIndex" />
        </label>

        <label class="settings-row settings-row--toggle">
            <span class="settings-row-text">
                <span class="settings-row-title">规则不确定时用小模型辅助路由</span>
                <span class="settings-row-hint">
                    只影响 Full 模式：规则看不出意图、多意图或命中不到工具时，发一次 JSON 路由请求；
                    超时 / 失败自动回落规则。路由模型复用摘要模型，未配置时用当前会话模型。
                </span>
            </span>
            <input type="checkbox"
                   class="switch"
                   checked="@Settings.Current.Agent.SmallModelRoutingEnabled"
                   @onchange="ToggleSmallModelRouting" />
        </label>

        <div class="settings-grid">
            <label class="field">
                <span class="field-label">小模型路由超时（秒）</span>
                <input class="field-input"
                       type="number"
                       min="1"
                       max="60"
                       value="@Settings.Current.Agent.RoutingTimeoutSeconds"
                       @onchange="ChangeRoutingTimeout" />
                <span class="field-hint">超时直接回落规则，不阻塞对话；默认 8 秒。</span>
            </label>
        </div>
    </section>

    <section class="settings-section">
        <h2 class="settings-section-title">知识库默认值</h2>
        <p class="settings-section-hint">
            工作区 / 聊天室设置未覆盖时使用这个全局默认；归档列表与重建索引在对应工作区的设置里。
        </p>

        <label class="settings-row settings-row--toggle">
            <span class="settings-row-text">
                <span class="settings-row-title">默认启用工作区知识库</span>
                <span class="settings-row-hint">开启后系统提示只多一句「本工作区有 N 条归档会话」。</span>
            </span>
            <input type="checkbox"
                   class="switch"
                   checked="@Settings.Current.Agent.WorkspaceMemoryEnabled"
                   @onchange="ToggleWorkspaceMemory" />
        </label>
    </section>

    <section class="settings-section">
        <h2 class="settings-section-title">内循环（直跑）</h2>
        <p class="settings-section-hint">
            构建 / 测试可以走宿主直跑，跳过沙箱复制的等待；参数不经过 shell，只放行白名单命令。
            技能包脚本（<code>run_skill_script</code>）也走这条通道：只允许技能包 <code>bin/</code>、<code>scripts/</code>
            下的 <code>.mjs</code> / <code>.js</code>，需要 Node 20+，首跑 / 脚本变化会请求审批。
        </p>
        <p class="settings-message is-danger">
            直跑不受沙箱网络隔离，可以访问网络与真实工作区。默认关闭；打开后每次仍先请求审批，安全命令可本会话授权。
        </p>

        <label class="settings-row settings-row--toggle">
            <span class="settings-row-text">
                <span class="settings-row-title">启用直跑命令（run_command / run_skill_script）</span>
                <span class="settings-row-hint">dotnet build / dotnet test 与技能包脚本；run_powershell 始终留在沙箱。</span>
            </span>
            <input type="checkbox"
                   class="switch"
                   checked="@Settings.Current.Execution.DirectRunEnabled"
                   @onchange="ToggleDirectRun" />
        </label>

        <label class="field">
            <span class="field-label">小模型模式</span>
            <select class="field-input" value="@Settings.Current.Agent.Mode" @onchange="ChangeAgentMode">
                <option value="Auto">自动（按窗口 / 模型名判断）</option>
                <option value="Full">完整</option>
                <option value="Compact">精简（≤4 个工具、短提示）</option>
            </select>
            <span class="field-hint">8K / 无工具 / 名称含 3b、4b、7b 等默认走精简；手动覆盖优先。</span>
        </label>

        <div class="field field--wide">
            <span class="field-label">白名单（逗号分隔）</span>
            <input class="field-input" @bind="_allowlistText" @bind:event="oninput" />
            <span class="field-hint">默认 dotnet / npm / pnpm / node / git / python / cargo / go；git 只允许只读子命令。</span>
        </div>

        <div class="settings-grid">
            <label class="field">
                <span class="field-label">默认超时（秒）</span>
                <input class="field-input" type="number" min="1" max="600"
                       value="@Settings.Current.Execution.DefaultTimeoutSeconds"
                       @onchange="ChangeExecutionTimeout" />
            </label>
            <label class="field">
                <span class="field-label">构建 / 测试超时（秒）</span>
                <input class="field-input" type="number" min="1" max="900"
                       value="@Settings.Current.Execution.BuildTimeoutSeconds"
                       @onchange="ChangeBuildTimeout" />
            </label>
        </div>

        <div class="editor-footer">
            <button type="button" class="primary-button" @onclick="SaveExecutionPolicy">保存直跑设置</button>
        </div>

        <label class="settings-row settings-row--toggle">
            <span class="settings-row-text">
                <span class="settings-row-title">改动后自动提示验证（最多续跑 1 次）</span>
                <span class="settings-row-hint">有编辑但没有成功验证时，宿主追加一条 user 提示；不会伪造 tool 消息。</span>
            </span>
            <input type="checkbox" class="switch"
                   checked="@Settings.Current.Verification.AutoVerifyAfterEdit"
                   @onchange="ToggleAutoVerify" />
        </label>

        <label class="settings-row settings-row--toggle">
            <span class="settings-row-text">
                <span class="settings-row-title">编辑前创建检查点（可撤销最近一次改动）</span>
                <span class="settings-row-hint">每个 turn 一个 checkpoint，保留最近 20 个；撤销前会检查 hash 冲突。</span>
            </span>
            <input type="checkbox" class="switch"
                   checked="@Settings.Current.Checkpoints.Enabled"
                   @onchange="ToggleCheckpoints" />
        </label>

        @if (Grants.List().Count > 0)
        {
            <div class="settings-subsection">
                <span class="field-label">已授权的直跑命令（重启失效）</span>
                @foreach (var grant in Grants.List())
                {
                    <div class="settings-row">
                        <span class="settings-row-text">
                            <span class="settings-row-title">@grant.Prefix</span>
                            <span class="settings-row-hint">会话 @grant.SessionId；@grant.GrantedAt.ToString("HH:mm")</span>
                        </span>
                        <button type="button" class="ghost-button" @onclick="() => RevokeGrant(grant)">
                            撤销
                        </button>
                    </div>
                }
            </div>
        }

        @if (_executionMessage is not null)
        {
            <p class="settings-message">@_executionMessage</p>
        }
    </section>

    <section class="settings-section">
        <h2 class="settings-section-title">文件写入</h2>
        <p class="settings-section-hint">工作区里的文件由模型读写；写入前可以要求确认。</p>

        <label class="settings-row settings-row--toggle">
            <span class="settings-row-text">
                <span class="settings-row-title">写入前需要确认</span>
                <span class="settings-row-hint">关闭后模型可以直接覆盖工作区文件。</span>
            </span>
            <input type="checkbox"
                   class="switch"
                   checked="@Settings.Current.ConfirmFileWrite"
                   @onchange="ToggleConfirmWrite" />
        </label>

        <label class="settings-row settings-row--toggle">
            <span class="settings-row-text">
                <span class="settings-row-title">拒绝明显缩水的整文件覆盖</span>
                <span class="settings-row-hint">
                    默认开启：新内容不到原文 70% 时拒绝 write_file，避免模型只写回片段把源文件截断；
                    确实要合法大段删减时可临时关闭。
                </span>
            </span>
            <input type="checkbox"
                   class="switch"
                   checked="@Settings.Current.Agent.WriteFileShrinkGuard"
                   @onchange="ToggleWriteShrinkGuard" />
        </label>
    </section>

    @if (PowerShellDescriptor is not null)
    {
        <section class="settings-section">
            <h2 class="settings-section-title">PowerShell</h2>
            <p class="settings-section-hint">
                PowerShell 默认只在沙箱内执行（默认 AppContainer，也可以选 Windows Sandbox 虚拟机）：无网络，
                只能读写工作区副本；改动需要你在变更面板确认后才写回。
                沙箱不可用时工具直接不可用，不会自动退回直跑；在聊天室输入框里关掉沙箱，那一间才会改成
                直接在工作区执行。
            </p>

        <label class="settings-row settings-row--toggle">
            <span class="settings-row-text">
                <span class="settings-row-title">允许模型使用 PowerShell（默认开启）</span>
                <span class="settings-row-hint">
                    @(PowerShellAvailable
                        ? "内置能力：不需要在输入框里选 chip，模型需要时会自行调用；每次执行仍需审批。"
                        : PowerShellUnavailableReason)
                </span>
            </span>
            <input type="checkbox"
                   class="switch"
                   checked="@PowerShellEnabled"
                   disabled="@(!PowerShellAvailable)"
                   @onchange="TogglePowerShell" />
        </label>

        <div class="settings-grid">
            <label class="field">
                <span class="field-label">超时（秒）</span>
                <input class="field-input"
                       type="number"
                       min="1"
                       max="120"
                       value="@Settings.Current.Sandbox.TimeoutSeconds"
                       @onchange="ChangeTimeout" />
                <span class="field-hint">1–120；模型请求的超时也受这个范围约束。</span>
            </label>

            <label class="field">
                <span class="field-label">内存上限（MB）</span>
                <input class="field-input"
                       type="number"
                       min="64"
                       max="8192"
                       value="@Settings.Current.Sandbox.MemoryLimitMB"
                       @onchange="ChangeMemory" />
                <span class="field-hint">单个沙箱进程的上限；整个 Job 另有 2 倍上限。</span>
            </label>
        </div>

        <div class="settings-subsection">
            <span class="field-label">沙箱模式</span>
            <div class="segmented">
                <button type="button"
                        class="segmented-item @(IsSandboxMode(SandboxRequirement.Preferred) ? "is-active" : null)"
                        @onclick="() => SetSandboxMode(SandboxRequirement.Preferred)">
                    自动
                </button>
                <button type="button"
                        class="segmented-item @(IsSandboxMode(SandboxRequirement.Required) ? "is-active" : null)"
                        @onclick="() => SetSandboxMode(SandboxRequirement.Required)">
                    强制
                </button>
                @if (IsDebugBuild && !Settings.Current.Sandbox.Enabled)
                {
                    <button type="button" class="segmented-item is-active is-danger" disabled>
                        关闭（仅开发）
                    </button>
                }
            </div>
            <span class="field-hint">
                自动 = 首选沙箱不可用时允许换用其他可用沙箱；强制 = 只用首选沙箱，首选不可用就拒绝。
                两者都不会自动换成无沙箱执行；只有你在聊天室输入框里明确关掉沙箱，那一间才会直跑。
            </span>
        </div>

        <label class="settings-row settings-row--toggle">
            <span class="settings-row-text">
                <span class="settings-row-title">每次执行都需要确认（固定开启）</span>
                <span class="settings-row-hint">
                    审批框会展示完整脚本；批准一次只对这一次执行有效，不支持“同脚本本会话自动批准”。
                </span>
            </span>
            <input type="checkbox" class="switch" checked disabled />
        </label>

        @if (IsDebugBuild)
        {
            <div class="editor-footer">
                <button type="button"
                        class="ghost-button"
                        @onclick="() => SetSandboxEnabled(!Settings.Current.Sandbox.Enabled)">
                    @(Settings.Current.Sandbox.Enabled ? "关闭执行沙箱（仅开发）" : "重新启用执行沙箱")
                </button>
            </div>

            @if (!Settings.Current.Sandbox.Enabled)
            {
                <p class="settings-message is-danger">
                    执行沙箱已关闭：PowerShell 改为直接在工作区运行（不改副本、不等写回确认），PDF 不可用。
                    此选项只在调试构建里提供，正常情况下请在聊天室输入框里按需切换。
                </p>
            }
        }
        </section>
    }

    @if (PdfDescriptor is not null)
    {
        <section class="settings-section">
            <h2 class="settings-section-title">PDF</h2>
            <p class="settings-section-hint">
                PDF 在沙箱里解析（固定 AppContainer，不开虚拟机）：不能联网，只能读工作区和当前会话的附件。
                解析器崩溃只影响沙箱内的 helper 进程，不会拖垮应用；加密文件、扫描件会明确告诉你原因。
            </p>

            <label class="settings-row settings-row--toggle">
                <span class="settings-row-text">
                    <span class="settings-row-title">允许模型使用 PDF（默认开启）</span>
                    <span class="settings-row-hint">
                        @(PdfAvailable
                            ? "内置能力：不需要在输入框里选 chip，模型需要时会自行调用 pdf_read / pdf_info。"
                            : PdfUnavailableReason)
                    </span>
                </span>
                <input type="checkbox"
                       class="switch"
                       checked="@PdfEnabled"
                       disabled="@(!PdfAvailable)"
                       @onchange="TogglePdf" />
            </label>

            <label class="settings-row settings-row--toggle">
                <span class="settings-row-text">
                    <span class="settings-row-title">上传 PDF 时自动提取前 3 页</span>
                    <span class="settings-row-hint">
                        提取结果只用于聊天上下文；关闭后附件仍可用 pdf_read 按需读取。
                    </span>
                </span>
                <input type="checkbox"
                       class="switch"
                       checked="@Settings.Current.Sandbox.PdfAutoExtract"
                       disabled="@(!Settings.Current.Sandbox.Enabled)"
                       @onchange="TogglePdfAutoExtract" />
            </label>

            <ul class="sandbox-checks">
                <li class="@KindClass(_appContainerAvailability)">
                    PDF 解析沙箱（AppContainer）：@KindText(_appContainerAvailability)
                </li>
            </ul>

            <p class="settings-message">
                上限：单次 50 页 / 40,000 字符；工作区文件 50MB，上传附件 25MB。
                扫描件没有文本层，当前不启用 OCR。
            </p>
        </section>
    }

    <section class="settings-section">
        <h2 class="settings-section-title">执行沙箱</h2>
        <p class="settings-section-hint">
            PowerShell 与 PDF 解析都在沙箱中运行；沙箱不可用时直接拒绝执行，不会退回无沙箱直跑。
            AppContainer 启动快、全版本可用；Windows Sandbox 是虚拟机级强隔离，仅 Pro / Enterprise / Education 可用，
            每次启动约 10–30 秒。
        </p>

        <div class="settings-subsection">
            <span class="field-label">首选沙箱</span>
            <div class="segmented">
                <button type="button"
                        class="segmented-item @(Settings.Current.Sandbox.Preferred == SandboxKind.AppContainer ? "is-active" : null)"
                        @onclick="() => SetPreferredSandboxAsync(SandboxKind.AppContainer)">
                    AppContainer
                </button>
                <button type="button"
                        class="segmented-item @(Settings.Current.Sandbox.Preferred == SandboxKind.WindowsSandbox ? "is-active" : null)"
                        @onclick="() => SetPreferredSandboxAsync(SandboxKind.WindowsSandbox)">
                    Windows Sandbox
                </button>
            </div>
            <span class="field-hint">
                自动模式：首选不可用时允许换用另一种沙箱；强制模式：只用首选，不可用就拒绝。
                两者都不会回退到无沙箱执行。
            </span>
        </div>

        <div class="sandbox-status">
            <span class="sandbox-badge @SandboxBadgeClass">@SandboxBadgeText</span>
            <span class="settings-message">@EffectiveAvailabilityText</span>
        </div>

        <ul class="sandbox-checks">
            <li class="@KindClass(_appContainerAvailability)">
                AppContainer：@KindText(_appContainerAvailability)
            </li>
            <li class="@KindClass(_windowsSandboxAvailability)">
                Windows Sandbox：@KindText(_windowsSandboxAvailability)
            </li>
        </ul>

        @if (_windowsSandboxAvailability is { Available: true, Verified: false })
        {
            <p class="settings-message">
                Windows Sandbox 还没通过自检：点「测试 Windows Sandbox」启动一次虚拟机（约 10–30 秒）后才能启用 PowerShell。
            </p>
        }

        <div class="settings-grid">
            <label class="field">
                <span class="field-label">Windows Sandbox 内存（MB）</span>
                <input class="field-input"
                       type="number"
                       min="2048"
                       max="16384"
                       value="@Settings.Current.Sandbox.WindowsSandboxMemoryMB"
                       @onchange="ChangeWindowsSandboxMemory" />
                <span class="field-hint">仅虚拟机模式使用；下限 2048 由系统规定。</span>
            </label>
        </div>

        <div class="editor-footer">
            <button type="button" class="ghost-button" disabled="@_isSandboxTesting" @onclick="RunSandboxSelfTestAsync">
                @(_isSandboxTesting ? "自检中…（会启动真实进程）" : "执行沙箱自检")
            </button>
            <button type="button"
                    class="ghost-button"
                    disabled="@(_isWindowsSandboxTesting || _windowsSandboxAvailability is not { Available: true })"
                    @onclick="RunWindowsSandboxSelfTestAsync">
                @(_isWindowsSandboxTesting ? "启动虚拟机自检中…（约 10–30 秒）" : "测试 Windows Sandbox")
            </button>
        </div>

        @if (_sandboxMessage is not null)
        {
            <p class="settings-message">@_sandboxMessage</p>
        }

        @if (_sandboxReport is not null)
        {
            <ul class="sandbox-checks">
                <li class="@CheckClass(_sandboxReport.CmdOk)">基本进程：能在沙箱内启动 cmd</li>
                <li class="@CheckClass(_sandboxReport.PowerShellOk)">PowerShell：能执行脚本并正确输出 UTF-8 中文</li>
                <li class="@CheckClass(_sandboxReport.CannotReadUserProfile)">隔离：不能读取用户目录里的文件</li>
                <li class="@CheckClass(_sandboxReport.CannotWriteWorkspace)">隔离：不能写入工作区</li>
                <li class="@CheckClass(_sandboxReport.NoNetwork)">隔离：没有网络访问</li>
                <li class="@CheckClass(_sandboxReport.SubprocessOk)">子进程：允许在 Job 内启动</li>
                <li class="@CheckClass(_sandboxReport.TimeoutOk)">超时：到点终止整棵进程树</li>
            </ul>

            @if (!string.IsNullOrWhiteSpace(_sandboxReport.Detail))
            {
                <pre class="search-preview">@_sandboxReport.Detail</pre>
            }
        }

        @if (_windowsSandboxMessage is not null)
        {
            <p class="settings-message">@_windowsSandboxMessage</p>
        }

        @if (_windowsSandboxReport is not null)
        {
            <ul class="sandbox-checks">
                <li class="@CheckClass(_windowsSandboxReport.Launched)">启动：能启动 Windows Sandbox 虚拟机并跑完 run.ps1</li>
                <li class="@CheckClass(_windowsSandboxReport.PowerShellOk)">PowerShell：能在虚拟机内执行脚本</li>
                <li class="@CheckClass(_windowsSandboxReport.NoNetwork)">网络：虚拟机没有网络访问</li>
            </ul>

            @if (!string.IsNullOrWhiteSpace(_windowsSandboxReport.Detail))
            {
                <pre class="search-preview">@_windowsSandboxReport.Detail</pre>
            }
        }

        @if (_windowsSandboxReport is { AllPassed: false } && _appContainerAvailability is { Available: true })
        {
            <div class="editor-footer">
                <button type="button"
                        class="ghost-button"
                        @onclick="() => SetPreferredSandboxAsync(SandboxKind.AppContainer)">
                    改用 AppContainer
                </button>
            </div>
        }
    </section>

    <section class="settings-section">
        <h2 class="settings-section-title">审计与数据</h2>
        <p class="settings-section-hint">
            工具审计日志每天一个 JSONL 文件，只记录工具、job、沙箱类型、脚本 hash / 长度、退出码与审批结果；
            默认不写脚本正文，也不写 stdout / stderr 内容。
        </p>

        <label class="settings-row settings-row--toggle">
            <span class="settings-row-text">
                <span class="settings-row-title">在审计日志中保留脚本正文（前 4KB）</span>
                <span class="settings-row-hint">默认关闭；打开后脚本内容会落盘，敏感脚本请勿开启。</span>
            </span>
            <input type="checkbox"
                   class="switch"
                   checked="@Settings.Current.Sandbox.RetainScriptsInAuditLog"
                   @onchange="ToggleRetainScripts" />
        </label>

        <div class="settings-grid">
            <label class="field">
                <span class="field-label">审计日志保留天数</span>
                <input class="field-input"
                       type="number"
                       min="1"
                       max="365"
                       value="@Settings.Current.Sandbox.AuditRetentionDays"
                       @onchange="ChangeAuditRetention" />
                <span class="field-hint">默认 7 天；下次启动写日志时清理更早的文件，单文件超过 10MB 会轮转。</span>
            </label>
        </div>

        <div class="editor-footer">
            <button type="button" class="ghost-button" @onclick="OpenAuditFolder">打开日志目录</button>
        </div>
        <p class="settings-message">@AuditDirectory</p>

        <div class="settings-subsection">
            <span class="field-label">沙箱数据</span>
            <span class="field-hint">
                启动时自动清理超过 24 小时的作业、残留 <code>*.tmp</code> / <code>*.wsb</code> 与 7 天前的回收站条目；
                有未应用变更的作业会保留，等你确认后再清。
            </span>
            <div class="editor-footer">
                <button type="button" class="ghost-button" disabled="@_isMaintaining" @onclick="RunCleanupAsync">
                    @(_isMaintaining ? "清理中…" : "清理过期数据")
                </button>
                @if (!_confirmingPurge)
                {
                    <button type="button" class="ghost-button" disabled="@_isMaintaining" @onclick="() => _confirmingPurge = true">
                        清理沙箱数据…
                    </button>
                }
            </div>

            @if (_confirmingPurge)
            {
                <p class="settings-message is-danger">
                    确定清空所有沙箱作业与回收站，并删除 AppContainer profile？未应用的变更也会丢失；
                    host 程序会保留，下次使用沙箱时重新创建 profile。
                </p>
                <div class="editor-footer">
                    <button type="button" class="ghost-button" disabled="@_isMaintaining" @onclick="() => _confirmingPurge = false">
                        取消
                    </button>
                    <button type="button" class="ghost-button" disabled="@_isMaintaining" @onclick="PurgeAsync">
                        @(_isMaintaining ? "清理中…" : "确认清理")
                    </button>
                </div>
            }

            @if (_maintenanceMessage is not null)
            {
                <p class="settings-message">@_maintenanceMessage</p>
            }
        </div>
    </section>
</div>

@code {
    private string _endpoint = string.Empty;
    private string _apiKey = string.Empty;
    private bool _showKey;
    private bool _isTesting;
    private string? _message;
    private string? _searchResult;
    private SandboxAvailability? _availability;
    private SandboxAvailability? _appContainerAvailability;
    private SandboxAvailability? _windowsSandboxAvailability;
    private SandboxProbeReport? _sandboxReport;
    private string? _sandboxMessage;
    private bool _isSandboxTesting;
    private WindowsSandboxSelfTestReport? _windowsSandboxReport;
    private string? _windowsSandboxMessage;
    private bool _isWindowsSandboxTesting;
    private bool _isMaintaining;
    private bool _confirmingPurge;
    private string? _maintenanceMessage;
    private string _allowlistText = string.Empty;
    private string? _executionMessage;

    private string AuditDirectory => Path.Combine(Paths.DataRoot, "logs");

    protected override async Task OnInitializedAsync()
    {
        _endpoint = Settings.Current.Search.Endpoint;
        _apiKey = Settings.Current.Search.ApiKey;
        _allowlistText = string.Join(", ", Settings.Current.Execution.Allowlist);

        // 启动清理是后台任务；如果它已经跳过某些 job，这里直接把“待处理”展示出来。
        if (Maintenance.LastReport is { PendingJobs: > 0 } report)
        {
            _maintenanceMessage =
                $"启动清理跳过了 {report.PendingJobs} 个作业（还有未应用的变更）："
                + string.Join("、", report.PendingJobIds) + "。";
        }

        await RefreshAvailabilityAsync();
    }

    /// <summary>刷新“当前策略下的可用性”与两种沙箱各自的状态。</summary>
    private async Task RefreshAvailabilityAsync()
    {
        _availability = await Sandbox.GetAvailabilityAsync();
        _appContainerAvailability = await Sandbox.GetAvailabilityAsync(SandboxKind.AppContainer);
        _windowsSandboxAvailability = await Sandbox.GetAvailabilityAsync(SandboxKind.WindowsSandbox);
    }

    private static string KindText(SandboxAvailability? availability) => availability switch
    {
        null => "检测中…",
        { Available: true, Verified: true } => "可用（已验证）",
        { Available: true } => "可用（未验证）",
        _ => string.IsNullOrWhiteSpace(availability.Reason)
            ? "不可用"
            : $"不可用：{availability.Reason}"
    };

    private static string KindClass(SandboxAvailability? availability) => availability switch
    {
        { Available: true, Verified: true } => "sandbox-check is-pass",
        { Available: true } => "sandbox-check is-warn",
        _ => "sandbox-check is-fail"
    };

    private string EffectiveAvailabilityText => _availability switch
    {
        null => "正在检测沙箱…",
        { Available: true, Verified: true } => "当前策略下沙箱可用，PowerShell 可以使用。",
        { Reason: not null } => _availability.Reason!,
        _ => "沙箱不可用。"
    };

    private string SandboxBadgeClass => _availability switch
    {
        { Available: true, Verified: true } => "sandbox-badge--ok",
        { Available: true } => "sandbox-badge--warn",
        _ => "sandbox-badge--off"
    };

    private AgentToolPackDescriptor? PowerShellDescriptor => ToolRegistry.Find("powershell");

    /// <summary>PowerShell 工具包的用户开关；没有记录时按描述里的默认值（关闭）。</summary>
    private bool PowerShellEnabled => Settings.Current.Tools.IsPackEnabled(
        "powershell",
        PowerShellDescriptor?.DefaultEnabled ?? false);

    /// <summary>可用 = 沙箱实测通过；沙箱关闭时 PowerShell 改为宿主直跑，也不再依赖沙箱。</summary>
    private bool PowerShellAvailable =>
        !Settings.Current.Sandbox.Enabled || _availability is { Available: true, Verified: true };

    private string PowerShellUnavailableReason => !Settings.Current.Sandbox.Enabled
        ? "沙箱已关闭：PowerShell 会直接在工作区运行，改动立即生效、不隔离网络。"
        : _availability switch
        {
            null => "正在检测沙箱…",
            { Available: false } => _availability.Reason ?? "沙箱不可用。",
            { Verified: false } => _availability.Reason ?? "PowerShell 尚未通过沙箱自检。",
            _ => "沙箱可用。"
        };

    private bool IsSandboxMode(SandboxRequirement requirement) =>
        Settings.Current.Sandbox.Enabled && Settings.Current.Sandbox.Requirement == requirement;

    private AgentToolPackDescriptor? PdfDescriptor => ToolRegistry.Find("pdf");

    /// <summary>PDF 工具包的用户开关；没有记录时按描述里的默认值（开启，只读）。</summary>
    private bool PdfEnabled => Settings.Current.Tools.IsPackEnabled(
        "pdf",
        PdfDescriptor?.DefaultEnabled ?? true);

    /// <summary>PDF 解析固定在 AppContainer：只要它能启动进程即可，不要求 PowerShell 自检通过。</summary>
    private bool PdfAvailable =>
        Settings.Current.Sandbox.Enabled && _appContainerAvailability is { Available: true };

    private string PdfUnavailableReason => !Settings.Current.Sandbox.Enabled
        ? "沙箱已关闭：PDF 解析只能在沙箱里跑。"
        : _appContainerAvailability switch
        {
            null => "正在检测沙箱…",
            { Available: false } => _appContainerAvailability.Reason ?? "AppContainer 沙箱不可用。",
            _ => "沙箱可用。"
        };

    private void TogglePdf(ChangeEventArgs args)
    {
        Settings.Current.Tools.SetPackEnabled("pdf", args.Value is true);
        Settings.Save();
    }

    private bool IsPackEnabled(string packId) =>
        Settings.Current.Tools.IsPackEnabled(
            packId,
            ToolRegistry.Find(packId)?.DefaultEnabled ?? true);

    private void TogglePack(string packId, ChangeEventArgs args)
    {
        Settings.Current.Tools.SetPackEnabled(packId, args.Value is true);
        Settings.Save();
    }

    private void ToggleFiles(ChangeEventArgs args) => TogglePack("files", args);

    private void ToggleEdits(ChangeEventArgs args) => TogglePack("edits", args);

    private void ToggleDirectRun(ChangeEventArgs args)
    {
        var enabled = args.Value is true;
        Settings.Current.Execution.DirectRunEnabled = enabled;
        Settings.Current.Execution.Mode = enabled ? ExecutionMode.AllowlistDirect : ExecutionMode.SandboxFirst;

        if (enabled)
        {
            Settings.Current.Tools.SetPackEnabled("command", true);
        }

        Settings.Save();
        _executionMessage = enabled ? "直跑已开启；下次运行命令会请求审批。" : "直跑已关闭，命令回到沙箱。";
    }

    private void SaveExecutionPolicy()
    {
        var allowlist = _allowlistText
            .Split([',', ';', ' ', '\t'], StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .ToList();

        if (allowlist.Count == 0)
        {
            _executionMessage = "白名单不能为空；至少保留 dotnet。";
            return;
        }

        Settings.Current.Execution.Allowlist = allowlist;
        Settings.Save();
        _allowlistText = string.Join(", ", allowlist);
        _executionMessage = "直跑设置已保存。";
    }

    private void ChangeAgentMode(ChangeEventArgs args)
    {
        if (Enum.TryParse<SDemo.DesktopAgent.Context.AgentModePreference>(
                args.Value?.ToString(), true, out var mode))
        {
            Settings.Current.Agent.Mode = mode;
            Settings.Save();
        }
    }

    private void ChangeMaxExposedTools(ChangeEventArgs args)
    {
        if (int.TryParse(args.Value?.ToString(), out var max))
        {
            Settings.Current.Agent.MaxExposedTools = max <= 0 ? 0 : Math.Clamp(max, 1, 24);
            Settings.Save();
        }
    }

    private void ToggleExposeAll(ChangeEventArgs args)
    {
        Settings.Current.Agent.ExposeAllTools = args.Value is true;
        Settings.Save();
    }

    private void ToggleSearchCapabilities(ChangeEventArgs args)
    {
        Settings.Current.Agent.SearchCapabilitiesEnabled = args.Value is true;
        Settings.Save();
    }

    /// <summary>P1a：切到内置工具循环；默认关闭，评测对比后再决定是否改默认。</summary>
    private void ToggleNativeLoop(ChangeEventArgs args)
    {
        Settings.Current.Agent.NativeLoop = args.Value is true;
        Settings.Save();
    }

    private void ToggleSkillIndex(ChangeEventArgs args)
    {
        Settings.Current.Agent.SkillIndexEnabled = args.Value is true;
        Settings.Save();
    }

    private void ToggleSmallModelRouting(ChangeEventArgs args)
    {
        Settings.Current.Agent.SmallModelRoutingEnabled = args.Value is true;
        Settings.Save();
    }

    private void ChangeRoutingTimeout(ChangeEventArgs args)
    {
        if (int.TryParse(args.Value?.ToString(), out var seconds))
        {
            Settings.Current.Agent.RoutingTimeoutSeconds = Math.Clamp(seconds, 1, 60);
            Settings.Save();
        }
    }

    private void ToggleWorkspaceMemory(ChangeEventArgs args)
    {
        Settings.Current.Agent.WorkspaceMemoryEnabled = args.Value is true;
        Settings.Save();
    }

    private void ToggleAutoVerify(ChangeEventArgs args)    {
        Settings.Current.Verification.AutoVerifyAfterEdit = args.Value is true;
        Settings.Save();
    }

    private void ToggleCheckpoints(ChangeEventArgs args)
    {
        Settings.Current.Checkpoints.Enabled = args.Value is true;
        Settings.Save();
    }

    private void ChangeExecutionTimeout(ChangeEventArgs args)
    {
        if (int.TryParse(args.Value?.ToString(), out var seconds))
        {
            Settings.Current.Execution.DefaultTimeoutSeconds = Math.Clamp(seconds, 1, 600);
            Settings.Save();
        }
    }

    private void ChangeBuildTimeout(ChangeEventArgs args)
    {
        if (int.TryParse(args.Value?.ToString(), out var seconds))
        {
            Settings.Current.Execution.BuildTimeoutSeconds = Math.Clamp(seconds, 1, 900);
            Settings.Save();
        }
    }

    private void RevokeGrant(SessionGrant grant)
    {
        Grants.Revoke(grant.SessionId, grant.Prefix);
        _executionMessage = $"已撤销：{grant.Prefix}";
    }

    private void TogglePdfAutoExtract(ChangeEventArgs args)
    {
        Settings.Current.Sandbox.PdfAutoExtract = args.Value is true;
        Settings.Save();
    }

#if DEBUG
    private static readonly bool IsDebugBuild = true;
#else
    private static readonly bool IsDebugBuild = false;
#endif

    private void TogglePowerShell(ChangeEventArgs args)
    {
        Settings.Current.Tools.SetPackEnabled("powershell", args.Value is true);
        Settings.Save();
    }

    private void ChangeTimeout(ChangeEventArgs args)
    {
        if (int.TryParse(args.Value?.ToString(), out var seconds))
        {
            Settings.Current.Sandbox.TimeoutSeconds = Math.Clamp(seconds, 1, 120);
            Settings.Save();
        }
    }

    private void ChangeMemory(ChangeEventArgs args)
    {
        if (int.TryParse(args.Value?.ToString(), out var megabytes))
        {
            Settings.Current.Sandbox.MemoryLimitMB = Math.Clamp(megabytes, 64, 8192);
            Settings.Current.Sandbox.JobMemoryLimitMB = Math.Max(1024, Settings.Current.Sandbox.MemoryLimitMB * 2);
            Settings.Save();
        }
    }

    private void SetSandboxMode(SandboxRequirement requirement)
    {
        Settings.Current.Sandbox.Enabled = true;
        Settings.Current.Sandbox.Requirement = requirement;
        Settings.Save();
    }

    private void SetSandboxEnabled(bool enabled)
    {
        Settings.Current.Sandbox.Enabled = enabled;
        Settings.Save();
    }

    private async Task SetPreferredSandboxAsync(SandboxKind kind)
    {
        Settings.Current.Sandbox.Preferred = kind;
        Settings.Save();
        await RefreshAvailabilityAsync();
    }

    private void ChangeWindowsSandboxMemory(ChangeEventArgs args)
    {
        if (int.TryParse(args.Value?.ToString(), out var megabytes))
        {
            Settings.Current.Sandbox.WindowsSandboxMemoryMB = Math.Clamp(megabytes, 2048, 16384);
            Settings.Save();
        }
    }

    private string SandboxBadgeText => _availability switch
    {
        { Available: true, Verified: true } => "已就绪",
        { Available: true } => "仅基本进程可用",
        _ => "不可用"
    };

    private static string CheckClass(bool passed) => passed ? "sandbox-check is-pass" : "sandbox-check is-fail";

    private async Task RunSandboxSelfTestAsync()
    {
        _isSandboxTesting = true;
        _sandboxReport = null;
        _sandboxMessage = null;

        try
        {
            _sandboxReport = await Sandbox.RunSelfTestAsync();
            await RefreshAvailabilityAsync();
            _sandboxMessage = _sandboxReport.AllPassed ? "自检全部通过。" : "自检未全部通过，详见下方。";
        }
        catch (Exception ex)
        {
            _sandboxMessage = $"自检执行失败：{ex.Message}";
        }
        finally
        {
            _isSandboxTesting = false;
        }
    }

    /// <summary>Windows Sandbox 自检会真的启动一次虚拟机，失败不影响 AppContainer。</summary>
    private async Task RunWindowsSandboxSelfTestAsync()
    {
        _isWindowsSandboxTesting = true;
        _windowsSandboxReport = null;
        _windowsSandboxMessage = null;

        try
        {
            _windowsSandboxReport = await Sandbox.RunWindowsSandboxSelfTestAsync();
            await RefreshAvailabilityAsync();
            _windowsSandboxMessage = _windowsSandboxReport.AllPassed
                ? $"Windows Sandbox 自检通过（耗时 {_windowsSandboxReport.Duration.TotalSeconds:0.#} 秒）。"
                : "Windows Sandbox 自检未通过；PowerShell 不会使用它。";
        }
        catch (Exception ex)
        {
            _windowsSandboxMessage = $"Windows Sandbox 自检执行失败：{ex.Message}";
        }
        finally
        {
            _isWindowsSandboxTesting = false;
        }
    }

    private void SetBackend(SearchBackend backend)
    {
        Settings.Current.Search.Backend = backend;
        Settings.Save();
        _message = null;
        _searchResult = null;
    }

    private void SaveSearch()
    {
        Settings.Current.Search.Endpoint = _endpoint.Trim();
        Settings.Current.Search.ApiKey = _apiKey.Trim();
        Settings.Save();
        _message = "已保存。";
    }

    private async Task TestSearchAsync()
    {
        // 测试前先落库，确保测的是当前填写的配置。
        SaveSearch();

        _isTesting = true;
        _searchResult = null;
        _message = null;

        try
        {
            _searchResult = await Search.SearchAsync("火山方舟");
        }
        finally
        {
            _isTesting = false;
        }
    }

    private void ToggleConfirmWrite(ChangeEventArgs args)
    {
        Settings.Current.ConfirmFileWrite = args.Value is true;
        Settings.Save();
    }

    private void ToggleWriteShrinkGuard(ChangeEventArgs args)
    {
        Settings.Current.Agent.WriteFileShrinkGuard = args.Value is true;
        Settings.Save();
    }

    private void ToggleRetainScripts(ChangeEventArgs args)
    {
        Settings.Current.Sandbox.RetainScriptsInAuditLog = args.Value is true;
        Settings.Save();
    }

    private void ChangeAuditRetention(ChangeEventArgs args)
    {
        if (int.TryParse(args.Value?.ToString(), out var days))
        {
            Settings.Current.Sandbox.AuditRetentionDays = Math.Clamp(days, 1, 365);
            Settings.Save();
        }
    }

    private void OpenAuditFolder()
    {
        try
        {
            Environment.OpenFolder(AuditDirectory);
            _maintenanceMessage = null;
        }
        catch (Exception ex)
        {
            _maintenanceMessage = $"打开日志目录失败：{ex.Message}";
        }
    }

    private async Task RunCleanupAsync()
    {
        _isMaintaining = true;
        _maintenanceMessage = null;

        try
        {
            var report = await Maintenance.CleanupAsync();
            _maintenanceMessage = $"已清理 {report.DeletedJobs} 个过期作业、{report.DeletedTrashEntries} 个回收站条目、"
                                  + $"{report.DeletedTempFiles} 个临时文件。"
                                  + (report.PendingJobs > 0
                                      ? $" 有 {report.PendingJobs} 个作业还有未应用的变更，已跳过：{string.Join("、", report.PendingJobIds)}。"
                                      : string.Empty);
        }
        catch (Exception ex)
        {
            _maintenanceMessage = $"清理失败：{ex.Message}";
        }
        finally
        {
            _isMaintaining = false;
        }
    }

    private async Task PurgeAsync()
    {
        _isMaintaining = true;
        _maintenanceMessage = null;

        try
        {
            var report = await Maintenance.PurgeAsync();
            _confirmingPurge = false;
            _maintenanceMessage = $"已清空沙箱数据：{report.DeletedJobs} 个作业、{report.DeletedTrashEntries} 个回收站条目、"
                                  + $"{report.DeletedTempFiles} 个临时文件；"
                                  + (report.ProfileDeleted == false
                                      ? "AppContainer profile 删除失败（可能被占用），下次使用会自动重建。"
                                      : "AppContainer profile 已删除。");
            await RefreshAvailabilityAsync();
        }
        catch (Exception ex)
        {
            _maintenanceMessage = $"清理沙箱数据失败：{ex.Message}";
        }
        finally
        {
            _isMaintaining = false;
        }
    }
}
