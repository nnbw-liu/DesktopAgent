@using SDemo.DesktopAgent.Models
@using SDemo.DesktopAgent.Execution
@inject ISettingsService Settings
@inject ISearchService Search
@inject AgentToolRegistry ToolRegistry

@* 工具设置：联网搜索 / 代码与文件工具 / 工具暴露与路由 / 工作区知识库。执行相关的在「执行与沙箱」。 *@
<div class="settings-pane">
    <details class="settings-section settings-collapsible" open="open">
        <summary class="settings-fold-head">
            <span class="settings-fold-caret" aria-hidden="true">▸</span>
            <div class="settings-fold-text">
                <span class="settings-section-title">联网搜索</span>
                <p class="settings-section-hint">默认使用必应 RSS（免密钥）；也可以填自己的搜索接口地址与 Key。</p>
            </div>
        </summary>

        <div class="settings-section-body">
            <div class="segmented">
                <button type="button"
                        class="segmented-item @(Settings.Current.Search.Backend == SearchBackend.Bing ? "is-active" : null)"
                        @onclick="() => SetBackend(SearchBackend.Bing)">
                    必应 RSS
                </button>
                <button type="button"
                        class="segmented-item @(Settings.Current.Search.Backend == SearchBackend.Custom ? "is-active" : null)"
                        @onclick="() => SetBackend(SearchBackend.Custom)">
                    自定义 API
                </button>
            </div>

            @if (Settings.Current.Search.Backend == SearchBackend.Custom)
            {
                <div class="field field--wide">
                    <span class="field-label">接口地址</span>
                    <input class="field-input"
                           @bind="_endpoint"
                           @bind:event="oninput"
                           placeholder="https://open.feedcoopapi.com/search_api/global_search" />
                    <span class="field-hint">按 POST 提交 JSON（query / top_k），返回 JSON 即可。</span>
                </div>

                <div class="field field--wide">
                    <span class="field-label">API Key</span>
                    <span class="field-secret">
                        <input class="field-input"
                               type="@(_showKey ? "text" : "password")"
                               @bind="_apiKey"
                               @bind:event="oninput"
                               autocomplete="off"
                               placeholder="可留空" />
                        <button type="button" class="field-secret-toggle" @onclick="() => _showKey = !_showKey">
                            @(_showKey ? "隐藏" : "显示")
                        </button>
                    </span>
                </div>

                <div class="editor-footer">
                    <button type="button" class="ghost-button" disabled="@_isTesting" @onclick="TestSearchAsync">
                        @(_isTesting ? "测试中…" : "测试搜索")
                    </button>
                    <button type="button" class="primary-button" @onclick="SaveSearch">保存</button>
                </div>
            }
            else
            {
                <div class="editor-footer">
                    <button type="button" class="ghost-button" disabled="@_isTesting" @onclick="TestSearchAsync">
                        @(_isTesting ? "测试中…" : "测试搜索")
                    </button>
                </div>
            }

            @if (_message is not null)
            {
                <p class="settings-message">@_message</p>
            }

            @if (_searchResult is not null)
            {
                <pre class="search-preview">@_searchResult</pre>
            }
        </div>
    </details>

    <details class="settings-section settings-collapsible" open="open">
        <summary class="settings-fold-head">
            <span class="settings-fold-caret" aria-hidden="true">▸</span>
            <div class="settings-fold-text">
                <span class="settings-section-title">代码与文件工具</span>
                <p class="settings-section-hint">
                文件工具拆成只读与写入两个包；写入前可以要求确认，并拦掉明显缩水的整文件覆盖。
                </p>
            </div>
        </summary>

        <div class="settings-section-body">
            <label class="settings-row settings-row--toggle">
                <span class="settings-row-text">
                    <span class="settings-row-title">文件读取与搜索（默认开启）</span>
                    <span class="settings-row-hint">read_file / search_files / glob_files / list_tree / list_files。</span>
                </span>
                <input type="checkbox"
                       class="switch"
                       checked="@IsPackEnabled("files")"
                       @onchange="ToggleFiles" />
            </label>

            <label class="settings-row settings-row--toggle">
                <span class="settings-row-text">
                    <span class="settings-row-title">代码编辑（默认开启）</span>
                    <span class="settings-row-hint">apply_patch / write_file；改已有文件前必须先读。</span>
                </span>
                <input type="checkbox"
                       class="switch"
                       checked="@IsPackEnabled("edits")"
                       @onchange="ToggleEdits" />
            </label>

            <label class="settings-row settings-row--toggle">
                <span class="settings-row-text">
                    <span class="settings-row-title">Office 文档（默认开启）</span>
                    <span class="settings-row-hint">office_info / office_read / office_write；写入走审批，覆盖需要显式 overwrite。</span>
                </span>
                <input type="checkbox"
                       class="switch"
                       checked="@IsPackEnabled("office")"
                       @onchange="ToggleOffice" />
            </label>

            <label class="settings-row settings-row--toggle">
                <span class="settings-row-text">
                    <span class="settings-row-title">写入前需要确认</span>
                    <span class="settings-row-hint">关闭后模型可以直接覆盖工作区文件。</span>
                </span>
                <input type="checkbox"
                       class="switch"
                       checked="@Settings.Current.ConfirmFileWrite"
                       @onchange="ToggleConfirmWrite" />
            </label>

            <label class="settings-row settings-row--toggle">
                <span class="settings-row-text">
                    <span class="settings-row-title">拒绝明显缩水的整文件覆盖</span>
                    <span class="settings-row-hint">
                        新内容不到原文 70% 时拒绝 write_file，避免模型只写回片段把源文件截断；
                        确实要合法大段删减时可临时关闭。
                    </span>
                </span>
                <input type="checkbox"
                       class="switch"
                       checked="@Settings.Current.Agent.WriteFileShrinkGuard"
                       @onchange="ToggleWriteShrinkGuard" />
            </label>
        </div>
    </details>

    <details class="settings-section settings-collapsible" open="open">
        <summary class="settings-fold-head">
            <span class="settings-fold-caret" aria-hidden="true">▸</span>
            <div class="settings-fold-text">
                <span class="settings-section-title">验证与检查点</span>
                <p class="settings-section-hint">改动后是否自动提醒验证，以及编辑前是否留一份可撤销的检查点。</p>
            </div>
        </summary>

        <div class="settings-section-body">
            <label class="settings-row settings-row--toggle">
                <span class="settings-row-text">
                    <span class="settings-row-title">改动后自动提示验证（最多续跑 1 次）</span>
                    <span class="settings-row-hint">有编辑但没有成功验证时，宿主追加一条 user 提示；不会伪造 tool 消息。</span>
                </span>
                <input type="checkbox" class="switch"
                       checked="@Settings.Current.Verification.AutoVerifyAfterEdit"
                       @onchange="ToggleAutoVerify" />
            </label>

            <label class="settings-row settings-row--toggle">
                <span class="settings-row-text">
                    <span class="settings-row-title">编辑前创建检查点（可撤销最近一次改动）</span>
                    <span class="settings-row-hint">每个 turn 一个 checkpoint，保留最近 20 个；撤销前会检查 hash 冲突。</span>
                </span>
                <input type="checkbox" class="switch"
                       checked="@Settings.Current.Checkpoints.Enabled"
                       @onchange="ToggleCheckpoints" />
            </label>
        </div>
    </details>

    <details class="settings-section settings-collapsible" open="open">
        <summary class="settings-fold-head">
            <span class="settings-fold-caret" aria-hidden="true">▸</span>
            <div class="settings-fold-text">
                <span class="settings-section-title">工具暴露与路由</span>
                <p class="settings-section-hint">
                每轮只把「核心集 + 按需工具包」交给模型，其余按关键词路由；工具 schema 单独占一段预算（8K 窗口上限 1.5K token）。
                </p>
            </div>
        </summary>

        <div class="settings-section-body">
            <div class="settings-grid">
                <label class="field">
                    <span class="field-label">每轮最多暴露工具数</span>
                    <input class="field-input"
                           type="number"
                           min="0"
                           max="24"
                           value="@Settings.Current.Agent.MaxExposedTools"
                           @onchange="ChangeMaxExposedTools" />
                    <span class="field-hint">0 = 自动（8K 6 个、32K 12 个）；1–24 手动覆盖。</span>
                </label>

                <label class="field">
                    <span class="field-label">小模型模式</span>
                    <select class="field-input" value="@Settings.Current.Agent.Mode" @onchange="ChangeAgentMode">
                        <option value="Auto">自动（按窗口 / 模型名判断）</option>
                        <option value="Full">完整</option>
                        <option value="Compact">精简（≤4 个工具、短提示）</option>
                    </select>
                    <span class="field-hint">8K / 无工具 / 名称含 3b、4b、7b 等默认走精简；手动覆盖优先。</span>
                </label>
            </div>

            <label class="settings-row settings-row--toggle">
                <span class="settings-row-text">
                    <span class="settings-row-title">临时全量暴露（排障用）</span>
                    <span class="settings-row-hint">
                        路由漏工具时切回旧行为：所有启用工具都交给模型，仍受窗口工具段预算限制。
                    </span>
                </span>
                <input type="checkbox"
                       class="switch"
                       checked="@Settings.Current.Agent.ExposeAllTools"
                       @onchange="ToggleExposeAll" />
            </label>

            <label class="settings-row settings-row--toggle">
                <span class="settings-row-text">
                    <span class="settings-row-title">内置工具循环（P1a，实验）</span>
                    <span class="settings-row-hint">
                        宿主自己跑「请求 → 工具 → 结果回灌 → 再请求」：工具调用与结果按真实消息进历史，
                        界面能按「第几步」归组；关闭时仍走 MAF 的 FunctionInvokingChatClient。
                    </span>
                </span>
                <input type="checkbox"
                       class="switch"
                       checked="@Settings.Current.Agent.NativeLoop"
                       @onchange="ToggleNativeLoop" />
            </label>

            <label class="settings-row settings-row--toggle">
                <span class="settings-row-text">
                    <span class="settings-row-title">提供 search_capabilities 兜底入口</span>
                    <span class="settings-row-hint">模型可自查当前会话可用的工具；默认开启，只影响 Full 模式。</span>
                </span>
                <input type="checkbox"
                       class="switch"
                       checked="@Settings.Current.Agent.SearchCapabilitiesEnabled"
                       @onchange="ToggleSearchCapabilities" />
            </label>

            <label class="settings-row settings-row--toggle">
                <span class="settings-row-text">
                    <span class="settings-row-title">系统提示注入技能索引</span>
                    <span class="settings-row-hint">
                        只放「名字 · 一句话 · 何时用」（20 个技能约 400 token）；正文由 load_skill 按需读取，手选技能仍全文注入。
                    </span>
                </span>
                <input type="checkbox"
                       class="switch"
                       checked="@Settings.Current.Agent.SkillIndexEnabled"
                       @onchange="ToggleSkillIndex" />
            </label>
        </div>
    </details>

    <details class="settings-section settings-collapsible" open="open">
        <summary class="settings-fold-head">
            <span class="settings-fold-caret" aria-hidden="true">▸</span>
            <div class="settings-fold-text">
                <span class="settings-section-title">工作区知识库</span>
                <p class="settings-section-hint">
                全局默认值；工作区 / 聊天室设置未覆盖时生效。归档列表与重建索引在对应工作区的设置里。
                </p>
            </div>
        </summary>

        <div class="settings-section-body">
            <label class="settings-row settings-row--toggle">
                <span class="settings-row-text">
                    <span class="settings-row-title">默认启用工作区知识库</span>
                    <span class="settings-row-hint">开启后系统提示只多一句「本工作区有 N 条归档会话」。</span>
                </span>
                <input type="checkbox"
                       class="switch"
                       checked="@Settings.Current.Agent.WorkspaceMemoryEnabled"
                       @onchange="ToggleWorkspaceMemory" />
            </label>
        </div>
    </details>
</div>

@code {
    private string _endpoint = string.Empty;
    private string _apiKey = string.Empty;
    private bool _showKey;
    private bool _isTesting;
    private string? _message;
    private string? _searchResult;

    protected override void OnInitialized()
    {
        _endpoint = Settings.Current.Search.Endpoint;
        _apiKey = Settings.Current.Search.ApiKey;
    }

    private bool IsPackEnabled(string packId) =>
        Settings.Current.Tools.IsPackEnabled(
            packId,
            ToolRegistry.Find(packId)?.DefaultEnabled ?? true);

    private void TogglePack(string packId, ChangeEventArgs args)
    {
        Settings.Current.Tools.SetPackEnabled(packId, args.Value is true);
        Settings.Save();
    }

    private void ToggleFiles(ChangeEventArgs args) => TogglePack("files", args);

    private void ToggleEdits(ChangeEventArgs args) => TogglePack("edits", args);

    private void ToggleOffice(ChangeEventArgs args) => TogglePack("office", args);

    private void ChangeAgentMode(ChangeEventArgs args)
    {
        if (Enum.TryParse<SDemo.DesktopAgent.Context.AgentModePreference>(
                args.Value?.ToString(), true, out var mode))
        {
            Settings.Current.Agent.Mode = mode;
            Settings.Save();
        }
    }

    private void ChangeMaxExposedTools(ChangeEventArgs args)
    {
        if (int.TryParse(args.Value?.ToString(), out var max))
        {
            Settings.Current.Agent.MaxExposedTools = max <= 0 ? 0 : Math.Clamp(max, 1, 24);
            Settings.Save();
        }
    }

    private void ToggleExposeAll(ChangeEventArgs args)
    {
        Settings.Current.Agent.ExposeAllTools = args.Value is true;
        Settings.Save();
    }

    private void ToggleSearchCapabilities(ChangeEventArgs args)
    {
        Settings.Current.Agent.SearchCapabilitiesEnabled = args.Value is true;
        Settings.Save();
    }

    /// <summary>P1a：切到内置工具循环；默认关闭，评测对比后再决定是否改默认。</summary>
    private void ToggleNativeLoop(ChangeEventArgs args)
    {
        Settings.Current.Agent.NativeLoop = args.Value is true;
        Settings.Save();
    }

    private void ToggleSkillIndex(ChangeEventArgs args)
    {
        Settings.Current.Agent.SkillIndexEnabled = args.Value is true;
        Settings.Save();
    }

    private void ToggleWorkspaceMemory(ChangeEventArgs args)
    {
        Settings.Current.Agent.WorkspaceMemoryEnabled = args.Value is true;
        Settings.Save();
    }

    private void ToggleConfirmWrite(ChangeEventArgs args)
    {
        Settings.Current.ConfirmFileWrite = args.Value is true;
        Settings.Save();
    }

    private void ToggleAutoVerify(ChangeEventArgs args)
    {
        Settings.Current.Verification.AutoVerifyAfterEdit = args.Value is true;
        Settings.Save();
    }

    private void ToggleCheckpoints(ChangeEventArgs args)
    {
        Settings.Current.Checkpoints.Enabled = args.Value is true;
        Settings.Save();
    }

    private void ToggleWriteShrinkGuard(ChangeEventArgs args)
    {
        Settings.Current.Agent.WriteFileShrinkGuard = args.Value is true;
        Settings.Save();
    }

    private void SetBackend(SearchBackend backend)
    {
        Settings.Current.Search.Backend = backend;
        Settings.Save();
        _message = null;
        _searchResult = null;
    }

    private void SaveSearch()
    {
        Settings.Current.Search.Endpoint = _endpoint.Trim();
        Settings.Current.Search.ApiKey = _apiKey.Trim();
        Settings.Save();
        _message = "已保存。";
    }

    private async Task TestSearchAsync()
    {
        // 测试前先落库，确保测的是当前填写的配置。
        SaveSearch();

        _isTesting = true;
        _searchResult = null;
        _message = null;

        try
        {
            _searchResult = await Search.SearchAsync("火山方舟");
        }
        finally
        {
            _isTesting = false;
        }
    }
}
