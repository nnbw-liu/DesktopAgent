@using System.IO
@implements IDisposable
@inject SkillCatalog Catalog
@inject IFileLauncherService Launcher
@inject ISkillScriptRunner ScriptRunner
@inject IArchifyInstaller ArchifyInstaller
@inject IFolderPickerService FolderPicker
@inject ISettingsService Settings

@* 技能库设置：目录包与旧式单文件的发现结果、版本 / 来源 / 目录哈希，以及打开技能目录。 *@
<div class="settings-pane">
    <section class="settings-section">
        <h2 class="settings-section-title">技能库</h2>
        <p class="settings-section-hint">
            支持 Agent Skills 目录包（<code>skills/&lt;name&gt;/SKILL.md</code>）与旧式单文件（<code>skills/&lt;name&gt;.md</code>）。
            同名时目录包优先；包里的 references / schemas 由 <code>read_skill_file</code> 按需读取，不会整包进上下文。
        </p>

        <p class="settings-section-hint">
            包内 <code>bin/</code>、<code>scripts/</code> 下的 <code>.mjs</code> / <code>.js</code>
            可由 <code>run_skill_script</code> 在宿主直跑；需先在「工具设置 → 内循环」打开直跑，
            每次首跑 / 脚本变化都会请求审批。@ScriptHostText
        </p>

        <div class="plugin-root">
            <span class="field-label">技能目录</span>
            <code class="plugin-path">@Catalog.Root</code>
        </div>

        <div class="plugin-toolbar">
            <span class="settings-message">@_status</span>
            <span class="plugin-toolbar-actions">
                <button type="button" class="ghost-button" @onclick="OpenRootAsync">打开技能目录</button>
                <button type="button" class="ghost-button" @onclick="Refresh">重新扫描</button>
                <button type="button"
                        class="primary-button"
                        disabled="@_installing"
                        @onclick="InstallArchifyAsync">
                    @(_installing ? "正在安装 Archify…" : "安装 Archify 3.2.0")
                </button>
            </span>
        </div>

        <p class="settings-section-hint">
            安装会选一个上游目录（仓库根或 <code>archify/</code> 技能包），复制到技能库并写入 DesktopAgent
            适配版入口；上游正文保留在 <code>references/upstream-SKILL.md</code>，示例 HTML 不复制。
            许可与 NOTICE 随包保留；重复安装会覆盖技能库里的 <code>archify/</code>。
        </p>

        <p class="settings-message">
            技能正文会进入上下文；引用文件只是参考资料，不是指令。只安装你信任的技能包。
        </p>
    </section>

    @if (_skills.Count == 0)
    {
        <section class="settings-section">
            <p class="plugin-empty">
                还没有发现技能。把包含 SKILL.md 的目录放进上面的技能目录，或放一个 name.md，再点「重新扫描」。
            </p>
        </section>
    }
    else
    {
        <section class="settings-section">
            <h2 class="settings-section-title">已发现 @_skills.Count 个技能</h2>

            @foreach (var skill in _skills)
            {
                <article class="plugin-item">
                    <div class="plugin-item-head">
                        <span class="plugin-icon">@skill.Glyph</span>
                        <span class="plugin-name">@skill.Name</span>
                        <span class="plugin-badge">@(skill.Kind == SkillKind.Package ? "目录包" : "单文件")</span>
                        @if (!string.IsNullOrWhiteSpace(skill.Version))
                        {
                            <span class="plugin-version">v@skill.Version</span>
                        }
                    </div>

                    @if (!string.IsNullOrWhiteSpace(skill.Description))
                    {
                        <p class="plugin-desc">@skill.Description</p>
                    }

                    <p class="plugin-meta">@MetaOf(skill)</p>
                    <p class="plugin-meta">@skill.RootPath</p>

                    @if (!string.IsNullOrWhiteSpace(skill.Source))
                    {
                        <p class="plugin-meta">来源 @skill.Source</p>
                    }

                    @if (_hashes.TryGetValue(skill.Name, out var snapshot))
                    {
                        <p class="plugin-meta" title="@snapshot.Hash">
                            sha256 @Short(snapshot.Hash) · @snapshot.LastWriteUtc.ToLocalTime():yyyy-MM-dd HH:mm
                        </p>
                    }
                    else if (_hashing)
                    {
                        <p class="plugin-meta">sha256 计算中…</p>
                    }

                    @if (OperatingSystem.IsWindows())
                    {
                        <div class="plugin-controls">
                            <button type="button"
                                    class="ghost-button"
                                    @onclick="() => OpenSkillAsync(skill)">
                                打开目录
                            </button>
                        </div>
                    }

                    <div class="plugin-controls">
                        <label class="plugin-control"
                               title="关掉后这个技能不再在输入框里固定占一个 chip；仍然可以输入 /技能名 或从 / 菜单调用。">
                            <input type="checkbox"
                                   class="switch switch--sm"
                                   checked="@Settings.Current.Skills.IsComposerVisible(skill.Name)"
                                   @onchange="args => SetComposerVisible(skill, args)" />
                            <span>在输入框显示</span>
                        </label>
                    </div>
                </article>
            }
        </section>
    }
</div>

@code {
    private IReadOnlyList<SkillInfo> _skills = [];
    private readonly Dictionary<string, string?> _summaries = new(StringComparer.OrdinalIgnoreCase);
    private readonly Dictionary<string, SkillSnapshot> _hashes = new(StringComparer.OrdinalIgnoreCase);
    private string _status = string.Empty;
    private bool _hashing;
    private bool _installing;
    private bool _disposed;
    private int _generation;
    private CancellationTokenSource? _hashCts;

    protected override void OnInitialized() => Refresh();

    private void Refresh()
    {
        _hashCts?.Cancel();
        _hashCts?.Dispose();
        _hashCts = new CancellationTokenSource();
        var generation = ++_generation;

        _skills = Catalog.List();
        _summaries.Clear();
        _hashes.Clear();
        _hashing = _skills.Count > 0;

        foreach (var skill in _skills)
        {
            _summaries[skill.Name] = Catalog.Summary(skill.Name);
        }

        var packages = _skills.Count(skill => skill.Kind == SkillKind.Package);
        _status = $"扫描于 {DateTime.Now:HH:mm:ss} · {_skills.Count} 个技能（{packages} 个目录包）";

        _ = ComputeHashesAsync(generation, _hashCts.Token);
    }

    /// <summary>目录哈希在后台算：大包第一次读可能被磁盘 / 杀毒拖慢，不能卡设置页。</summary>
    private async Task ComputeHashesAsync(int generation, CancellationToken cancellationToken)
    {
        var names = _skills.Select(skill => skill.Name).ToArray();

        try
        {
            var results = await Task.Run(
                () =>
                {
                    var snapshots = new List<(string Name, SkillSnapshot? Snapshot)>(names.Length);

                    foreach (var name in names)
                    {
                        cancellationToken.ThrowIfCancellationRequested();
                        snapshots.Add((name, Catalog.Snapshot(name)));
                    }

                    return snapshots;
                },
                cancellationToken);

            if (_disposed || generation != _generation)
            {
                return;
            }

            await InvokeAsync(() =>
            {
                if (generation != _generation)
                {
                    return;
                }

                foreach (var (name, snapshot) in results)
                {
                    if (snapshot is not null)
                    {
                        _hashes[name] = snapshot;
                    }
                }

                _hashing = false;
                StateHasChanged();
            });
        }
        catch (OperationCanceledException)
        {
            // 重新扫描 / 组件卸载：新任务会接手。
        }
        catch (Exception)
        {
            // 哈希失败不该影响「技能已发现」这个事实；卡片上保留“计算中”以外的信息即可。
            if (!_disposed)
            {
                await InvokeAsync(() =>
                {
                    _hashing = false;
                    StateHasChanged();
                });
            }
        }
    }

    private string MetaOf(SkillInfo skill) =>
        _summaries.TryGetValue(skill.Name, out var summary) && !string.IsNullOrWhiteSpace(summary)
            ? summary!
            : skill.Kind == SkillKind.Package ? "目录包" : "单文件";

    private string ScriptHostText
    {
        get
        {
            var host = ScriptRunner.Host;

            if (!host.NodeAvailable)
            {
                return string.IsNullOrWhiteSpace(host.Detail)
                    ? "脚本运行器未就绪。"
                    : host.Detail;
            }

            var node = string.IsNullOrWhiteSpace(host.NodeVersion)
                ? "Node 已找到"
                : $"Node {host.NodeVersion}";

            return host.ChromePath is null
                ? $"{node}；未找到 Edge / Chrome，Archify browser-check 可能失败。"
                : $"{node}；浏览器已找到。";
        }
    }

    private static string Short(string hash) => hash[..Math.Min(12, hash.Length)];

    private async Task InstallArchifyAsync()
    {
        if (_installing)
        {
            return;
        }

        string? source;

        try
        {
            source = await FolderPicker.PickFolderAsync(
                "选择 Archify 3.2.0 目录（仓库根或技能包目录）");
        }
        catch (Exception ex)
        {
            _status = $"选择目录失败：{ex.Message}";
            return;
        }

        if (string.IsNullOrWhiteSpace(source))
        {
            _status = "已取消安装。";
            return;
        }

        _installing = true;
        _status = "正在安装 Archify 3.2.0…";
        StateHasChanged();

        string message = "安装失败。";

        try
        {
            message = (await ArchifyInstaller.InstallAsync(source)).Message;
        }
        catch (Exception ex)
        {
            message = $"安装失败：{ex.Message}";
        }
        finally
        {
            _installing = false;
            Refresh();
            _status = message;
            StateHasChanged();
        }
    }

    /// <summary>
    /// 「在输入框显示」开关：只写显示偏好，不动技能文件。
    /// 关掉的技能仍在技能库里，<c>/技能名</c> 与 <c>/</c> 菜单照常可用。
    /// </summary>
    private void SetComposerVisible(SkillInfo skill, ChangeEventArgs args)
    {
        var visible = args.Value is true;

        Settings.Current.Skills.SetComposerVisible(skill.Name, visible);
        Settings.Save();

        _status = visible
            ? $"「{skill.Name}」已显示在输入框。"
            : $"「{skill.Name}」已从输入框收起，仍可用 /{skill.Name} 调用。";

        StateHasChanged();
    }

    private async Task OpenRootAsync()
    {
        try
        {
            Directory.CreateDirectory(Catalog.Root);
            _status = await Launcher.OpenFileAsync(Catalog.Root)
                ? "已打开技能目录。"
                : "当前环境不支持打开目录。";
        }
        catch (Exception ex) when (ex is IOException or UnauthorizedAccessException)
        {
            _status = $"打开目录失败：{ex.Message}";
        }
    }

    private async Task OpenSkillAsync(SkillInfo skill)
    {
        _status = await Launcher.OpenFileAsync(skill.RootPath)
            ? $"已打开「{skill.Name}」的目录。"
            : "当前环境不支持打开目录。";
    }

    public void Dispose()
    {
        _disposed = true;
        _hashCts?.Cancel();
        _hashCts?.Dispose();
    }
}
