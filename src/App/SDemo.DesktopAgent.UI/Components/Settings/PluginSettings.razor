@using System.Diagnostics
@using System.IO
@using SDemo.DesktopAgent.Models
@using SDemo.DesktopAgent.Plugins
@inject PluginCatalog Catalog
@inject PluginRegistry Registry
@inject ISettingsService Settings

@* 插件设置：全局开关 / 显示上限 / 参数记忆 / 默认呈现，以及每个插件的启用、入口与顺序。 *@
<div class="settings-pane">
    <section class="settings-section">
        <h2 class="settings-section-title">插件</h2>
        <p class="settings-section-hint">
            插件是「plugin.json + skill 文件」组成的声明式能力包，把文件夹放进插件目录就能生效，不需要编译。
            开关、上限与顺序改完立即生效，不需要重启。
        </p>

        <label class="settings-row settings-row--toggle">
            <span class="settings-row-text">
                <span class="settings-row-title">启用插件</span>
                <span class="settings-row-hint">关掉后侧栏、输入框、气泡都不显示插件；已打开的会话会回到普通对话。</span>
            </span>
            <input type="checkbox" class="switch" checked="@Prefs.Enabled" @onchange="ToggleGlobal" />
        </label>

        <div class="plugin-limits">
            <label class="plugin-limit">
                <span class="plugin-limit-label">输入框最多显示</span>
                <input type="number"
                       class="field-input plugin-limit-input"
                       min="1"
                       max="20"
                       value="@Prefs.MaxInComposer"
                       @onchange="args => SaveLimit(args, composer: true)" />
                <span class="plugin-limit-unit">个</span>
            </label>

            <label class="plugin-limit">
                <span class="plugin-limit-label">侧栏最多显示</span>
                <input type="number"
                       class="field-input plugin-limit-input"
                       min="1"
                       max="20"
                       value="@Prefs.MaxInSidebar"
                       @onchange="args => SaveLimit(args, composer: false)" />
                <span class="plugin-limit-unit">个</span>
            </label>
        </div>

        <label class="settings-row settings-row--toggle">
            <span class="settings-row-text">
                <span class="settings-row-title">记住每个会话上次选中的参数</span>
                <span class="settings-row-hint">关掉后，每次都用插件清单里的默认值（例如系统语言）。</span>
            </span>
            <input type="checkbox"
                   class="switch"
                   checked="@Prefs.RememberParameterValues"
                   @onchange="ToggleRemember" />
        </label>

        <div class="settings-row">
            <span class="settings-row-text">
                <span class="settings-row-title">新会话译文默认呈现</span>
                <span class="settings-row-hint">新会话（还没手动切换过对照 / 译文）的默认呈现方式。</span>
            </span>

            <div class="segmented plugin-mode-segmented">
                <button type="button"
                        class="segmented-item @(Prefs.DefaultOutputMode == PluginOutputMode.Bilingual ? "is-active" : null)"
                        @onclick="() => SetOutputMode(PluginOutputMode.Bilingual)">
                    对照
                </button>
                <button type="button"
                        class="segmented-item @(Prefs.DefaultOutputMode == PluginOutputMode.Translation ? "is-active" : null)"
                        @onclick="() => SetOutputMode(PluginOutputMode.Translation)">
                    纯译文
                </button>
            </div>
        </div>

        <div class="plugin-roots">
            <div class="plugin-root">
                <span class="field-label">本地插件目录</span>
                <code class="plugin-path">@Catalog.LocalRoot</code>
            </div>
            <div class="plugin-root">
                <span class="field-label">内置插件</span>
                <code class="plugin-path">随应用编译（@Catalog.BuiltinPackageCount 个，不需要目录）</code>
            </div>
        </div>

        <div class="plugin-toolbar">
            <span class="settings-message">@_status</span>
            <span class="plugin-toolbar-actions">
                @if (OperatingSystem.IsWindows())
                {
                    <button type="button" class="ghost-button" @onclick="OpenDirectory">打开插件目录</button>
                }
                <button type="button" class="ghost-button" @onclick="Rescan">重新扫描</button>
            </span>
        </div>

        <p class="settings-message">
            本地插件的内容会进入系统提示词，只安装你信任的插件。
        </p>
    </section>

    @if (_result.IsEmpty)
    {
        <section class="settings-section">
            <p class="plugin-empty">
                还没有发现插件。在上面的「本地插件目录」里新建一个文件夹，写入 plugin.json 和 skills/xxx.md，
                再点「重新扫描」。
            </p>
        </section>
    }

    @if (_result.Plugins.Count > 0)
    {
        <section class="settings-section">
            <h2 class="settings-section-title">已加载</h2>

            @foreach (var plugin in _result.Plugins)
            {
                <article class="plugin-item @(plugin.IsUsable ? null : "is-inactive") @(plugin.HasErrors ? "is-error" : null)">
                    <div class="plugin-item-head">
                        <span class="plugin-icon">@plugin.Initial</span>
                        <span class="plugin-name">@plugin.Name</span>
                        <span class="plugin-version">@plugin.Version</span>
                        <span class="plugin-badge">@(plugin.Source == PluginSource.Builtin ? "内置" : "本地")</span>
                        @if (plugin.IsOverridden)
                        {
                            <span class="plugin-badge plugin-badge--warn">已覆盖</span>
                        }
                        @if (plugin.StateText is { } stateText)
                        {
                            <span class="plugin-badge plugin-badge--warn">@stateText</span>
                        }
                        @if (!IsPluginEnabled(plugin))
                        {
                            <span class="plugin-badge plugin-badge--warn">已停用</span>
                        }
                    </div>

                    @if (!string.IsNullOrWhiteSpace(plugin.Description))
                    {
                        <p class="plugin-desc">@plugin.Description</p>
                    }

                    <p class="plugin-meta">
                        入口：@SurfaceSummary(plugin) · @plugin.Capabilities.Count 个能力 · 目录 @plugin.DirectoryName
                    </p>

                    <div class="plugin-controls">
                        <label class="plugin-control" title="停用后所有入口都不显示">
                            <input type="checkbox"
                                   class="switch switch--sm"
                                   checked="@IsPluginEnabled(plugin)"
                                   @onchange="args => SetPluginEnabled(plugin, args)" />
                            <span>启用</span>
                        </label>

                        <label class="plugin-control @(HasComposer(plugin) ? null : "is-disabled")"
                               title="@(HasComposer(plugin) ? "在输入框显示 chip" : "这个插件没有输入框入口")">
                            <input type="checkbox"
                                   class="switch switch--sm"
                                   checked="@InComposer(plugin)"
                                   disabled="@(!HasComposer(plugin))"
                                   @onchange="args => SetInComposer(plugin, args)" />
                            <span>输入框</span>
                        </label>

                        <label class="plugin-control @(CanUseSidebar(plugin) ? null : "is-disabled")"
                               title="@SidebarHint(plugin)">
                            <input type="checkbox"
                                   class="switch switch--sm"
                                   checked="@IsSidebarOn(plugin)"
                                   disabled="@(!CanUseSidebar(plugin))"
                                   @onchange="args => SetInSidebar(plugin, args)" />
                            <span>侧栏</span>
                        </label>

                        <label class="plugin-control @(HasMessage(plugin) ? null : "is-disabled")"
                               title="@(HasMessage(plugin) ? "在助手消息底部显示插件按钮" : "这个插件没有气泡入口")">
                            <input type="checkbox"
                                   class="switch switch--sm"
                                   checked="@InMessage(plugin)"
                                   disabled="@(!HasMessage(plugin))"
                                   @onchange="args => SetInMessage(plugin, args)" />
                            <span>气泡</span>
                        </label>

                        <label class="plugin-control plugin-control--order" title="数字小的排前面；清空表示用插件清单里的顺序">
                            <span>顺序</span>
                            <input type="number"
                                   class="field-input plugin-order-input"
                                   min="0"
                                   max="999"
                                   value="@OrderOf(plugin)"
                                   @onchange="args => SetOrder(plugin, args)" />
                        </label>
                    </div>

                    @if (plugin.DisabledReason is { } reason)
                    {
                        <p class="plugin-issue">@reason</p>
                    }

                    @foreach (var issue in AllIssues(plugin))
                    {
                        <p class="plugin-issue @(issue.IsError ? "plugin-issue--error" : null)">@issue.ToDisplayString()</p>
                    }
                </article>
            }
        </section>
    }

    @if (_result.Failures.Count > 0)
    {
        <section class="settings-section">
            <h2 class="settings-section-title">加载失败</h2>

            @foreach (var failure in _result.Failures)
            {
                <article class="plugin-item is-error">
                    <div class="plugin-item-head">
                        <span class="plugin-icon">!</span>
                        <span class="plugin-name">@failure.DisplayName</span>
                        <span class="plugin-badge">@(failure.Source == PluginSource.Builtin ? "内置" : "本地")</span>
                    </div>
                    <p class="plugin-meta">目录 @failure.DirectoryPath</p>
                    @foreach (var issue in failure.Issues)
                    {
                        <p class="plugin-issue @(issue.IsError ? "plugin-issue--error" : null)">@issue.ToDisplayString()</p>
                    }
                </article>
            }
        </section>
    }
</div>

@code {
    private PluginLoadResult _result = PluginLoadResult.Empty;
    private string _status = string.Empty;

    private PluginPreferences Prefs => Settings.Current.Plugins;

    protected override void OnInitialized() => Show(Catalog.Result, "扫描于");

    private void Rescan() => Show(Catalog.Scan(), "重新扫描于");

    private void Show(PluginLoadResult result, string verb)
    {
        _result = result;
        _status = $"{verb} {result.ScannedAt:HH:mm:ss} · 可用 {result.Usable.Count} 个，加载失败 {result.Failures.Count} 个";
    }

    private void OpenDirectory()
    {
        try
        {
            Directory.CreateDirectory(Catalog.LocalRoot);
            Process.Start(new ProcessStartInfo(Catalog.LocalRoot) { UseShellExecute = true });
        }
        catch (Exception ex) when (ex is IOException or UnauthorizedAccessException or System.ComponentModel.Win32Exception)
        {
            _status = $"打开目录失败：{ex.Message}";
        }
    }

    private void ToggleGlobal(ChangeEventArgs args)
    {
        Prefs.Enabled = args.Value is true;
        Settings.Save();
    }

    private void ToggleRemember(ChangeEventArgs args)
    {
        Prefs.RememberParameterValues = args.Value is true;
        Settings.Save();
    }

    private void SetOutputMode(PluginOutputMode mode)
    {
        Prefs.DefaultOutputMode = mode;
        Settings.Save();
    }

    private void SaveLimit(ChangeEventArgs args, bool composer)
    {
        if (!int.TryParse(args.Value?.ToString(), out var value))
        {
            return;
        }

        value = PluginPreferences.ClampLimit(value);
        if (composer)
        {
            Prefs.MaxInComposer = value;
        }
        else
        {
            Prefs.MaxInSidebar = value;
        }

        Settings.Save();
    }

    private void SetPluginEnabled(PluginDescriptor plugin, ChangeEventArgs args)
    {
        Prefs.GetOrAddEntry(plugin.Id).Enabled = args.Value is true;
        Settings.Save();
    }

    private void SetInSidebar(PluginDescriptor plugin, ChangeEventArgs args)
    {
        Prefs.GetOrAddEntry(plugin.Id).InSidebar = args.Value is true;
        Settings.Save();
    }

    private void SetInComposer(PluginDescriptor plugin, ChangeEventArgs args)
    {
        Prefs.GetOrAddEntry(plugin.Id).InComposer = args.Value is true;
        Settings.Save();
    }

    private void SetInMessage(PluginDescriptor plugin, ChangeEventArgs args)
    {
        Prefs.GetOrAddEntry(plugin.Id).InMessage = args.Value is true;
        Settings.Save();
    }

    private void SetOrder(PluginDescriptor plugin, ChangeEventArgs args)
    {
        var text = args.Value?.ToString();
        var entry = Prefs.GetOrAddEntry(plugin.Id);

        if (string.IsNullOrWhiteSpace(text) || !int.TryParse(text, out var order))
        {
            entry.Order = null;
        }
        else
        {
            entry.Order = Math.Clamp(order, 0, 999);
        }

        Settings.Save();
    }

    private bool IsPluginEnabled(PluginDescriptor plugin) => Prefs.FindEntry(plugin.Id)?.Enabled ?? true;

    private bool InSidebar(PluginDescriptor plugin) => Prefs.FindEntry(plugin.Id)?.InSidebar ?? true;

    private bool InComposer(PluginDescriptor plugin) => Prefs.FindEntry(plugin.Id)?.InComposer ?? true;

    private bool InMessage(PluginDescriptor plugin) => Prefs.FindEntry(plugin.Id)?.InMessage ?? true;

    /// <summary>侧栏能不能用：插件本身要有侧栏入口，而且输入框入口得开着（侧栏会进入预选插件的会话）。</summary>
    private bool CanUseSidebar(PluginDescriptor plugin) =>
        HasSidebar(plugin) && HasComposer(plugin) && InComposer(plugin);

    /// <summary>生效值：输入框入口关闭时侧栏跟着灰掉；存储值不动，重新打开输入框会恢复。</summary>
    private bool IsSidebarOn(PluginDescriptor plugin) => InComposer(plugin) && InSidebar(plugin);

    private string SidebarHint(PluginDescriptor plugin)
    {
        if (!HasComposer(plugin))
        {
            return "这个插件没有输入框入口，侧栏入口不可用";
        }

        if (!InComposer(plugin))
        {
            return "输入框入口关闭时侧栏也不可用（侧栏会进入预选插件的会话）";
        }

        if (!HasSidebar(plugin))
        {
            return "这个插件没有侧栏入口";
        }

        return "在侧栏显示入口";
    }

    private int OrderOf(PluginDescriptor plugin) => Prefs.FindEntry(plugin.Id)?.Order ?? plugin.Order;

    private static bool HasSidebar(PluginDescriptor plugin) =>
        plugin.Mounts.Any(mount => mount.IsUsable && mount.Surface == PluginSurface.Sidebar);

    private static bool HasComposer(PluginDescriptor plugin) =>
        plugin.Mounts.Any(mount => mount.IsUsable && mount.Surface == PluginSurface.Composer);

    private static bool HasMessage(PluginDescriptor plugin) =>
        plugin.Mounts.Any(mount => mount.IsUsable && mount.Surface == PluginSurface.Message);

    private static string SurfaceSummary(PluginDescriptor plugin)
    {
        var parts = new List<string>();
        if (plugin.UsableMounts(PluginSurface.Sidebar).Count > 0)
        {
            parts.Add("侧栏");
        }

        if (plugin.UsableMounts(PluginSurface.Composer).Count > 0)
        {
            parts.Add("输入框");
        }

        if (plugin.UsableMounts(PluginSurface.Message).Count > 0)
        {
            parts.Add("气泡");
        }

        return parts.Count == 0 ? "无可用入口" : string.Join(" / ", parts);
    }

    private static IEnumerable<PluginIssue> AllIssues(PluginDescriptor plugin)
    {
        foreach (var issue in plugin.Issues)
        {
            yield return issue;
        }

        // 能力与入口的问题各带一行来源，避免一堆「skill 文件不存在」分不清是谁的。
        foreach (var capability in plugin.Capabilities)
        {
            foreach (var issue in capability.Issues)
            {
                yield return issue with { Message = $"[能力 {capability.Name}] {issue.Message}" };
            }
        }

        foreach (var mount in plugin.Mounts)
        {
            foreach (var issue in mount.Issues)
            {
                yield return issue with { Message = $"[入口 {mount.Id}] {issue.Message}" };
            }
        }
    }
}
