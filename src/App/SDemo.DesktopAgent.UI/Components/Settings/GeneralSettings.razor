@inject IThemeService ThemeService
@inject ISettingsService Settings
@inject IAppEnvironmentService Environment

@* 通用设置：外观 / 语言 / 版本信息。上下文相关设置已移到「上下文」分区（P2）。 *@
<div class="settings-pane">
    <section class="settings-section">
        <h2 class="settings-section-title">外观</h2>
        <p class="settings-section-hint">选择「跟随系统」时，应用会随 Windows 的「应用模式」自动切换。</p>

        <div class="theme-options">
            @foreach (var option in ThemeOptions)
            {
                <button type="button"
                        class="theme-option @(ThemeService.Preference == option.Value ? "is-active" : null)"
                        @onclick="() => ThemeService.SetPreference(option.Value)">
                    <span class="theme-swatch theme-swatch--@option.Key"></span>
                    <span class="theme-label">@option.Label</span>
                    <span class="theme-desc">@option.Description</span>
                </button>
            }
        </div>
    </section>

    <section class="settings-section">
        <h2 class="settings-section-title">语言</h2>
        <p class="settings-section-hint">界面文案目前只有简体中文；其他语言会随资源本地化一起接入。</p>

        <div class="settings-row">
            <span class="settings-row-text">
                <span class="settings-row-title">界面语言</span>
                <span class="settings-row-hint">语言资源放在 .resx 中，切换后重新渲染界面。</span>
            </span>

            <select class="field-input field-input--select" value="@_language" @onchange="HandleLanguageChanged">
                <option value="zh-CN">简体中文</option>
                <option value="en-US" disabled>English（即将支持）</option>
            </select>
        </div>
    </section>

    <section class="settings-section">
        <h2 class="settings-section-title">对话</h2>
        <p class="settings-section-hint">控制切换聊天室时正在生成的回复如何处理。</p>

        <label class="settings-row settings-row--toggle">
            <span class="settings-row-text">
                <span class="settings-row-title">切换聊天室时继续生成</span>
                <span class="settings-row-hint">打开后切走不会中断，回复在后台继续，左侧列表保持「推理中…」；关闭则切走即中断。</span>
            </span>
            <input type="checkbox" class="switch" checked="@_continueOnSwitch" @onchange="HandleContinueOnSwitchChanged" />
        </label>

        <div class="settings-row">
            <span class="settings-row-text">
                <span class="settings-row-title">过程展示</span>
                <span class="settings-row-hint">
                    控制「思考 / 工具」这些过程记录的显隐；最终答案永远显示。
                    @ProcessModeHint
                </span>
            </span>

            <select class="field-input field-input--select" value="@_processMode" @onchange="HandleProcessModeChanged">
                @foreach (var option in ProcessModeOptions)
                {
                    <option value="@option.Value">@option.Label</option>
                }
            </select>
        </div>

        <div class="settings-row">
            <span class="settings-row-text">
                <span class="settings-row-title">过程收起时机</span>
                <span class="settings-row-hint">「下一条输入」会保留刚结束那一轮的过程，方便回看它想了什么。</span>
            </span>

            <select class="field-input field-input--select" value="@_collapseTiming" @onchange="HandleCollapseTimingChanged">
                @foreach (var option in CollapseTimingOptions)
                {
                    <option value="@option.Value">@option.Label</option>
                }
            </select>
        </div>
    </section>

    <section class="settings-section">
        <h2 class="settings-section-title">版本信息</h2>
        <p class="settings-section-hint">排查问题时把这几项一起发过来即可。</p>

        <dl class="info-list">
            <div class="info-row">
                <dt>应用版本</dt>
                <dd>@Environment.Version</dd>
            </div>
            <div class="info-row">
                <dt>.NET 运行时</dt>
                <dd>@Environment.RuntimeDescription</dd>
            </div>
            <div class="info-row">
                <dt>操作系统</dt>
                <dd>@Environment.OsDescription</dd>
            </div>
            <div class="info-row">
                <dt>宿主</dt>
                <dd>@Environment.HostName</dd>
            </div>
            <div class="info-row">
                <dt>WebView</dt>
                <dd>@Environment.WebViewVersion</dd>
            </div>
        </dl>
    </section>
</div>

@code {
    private string _language = "zh-CN";
    private bool _continueOnSwitch;
    private string _processMode = "Standard";
    private string _collapseTiming = "Completion";

    private static readonly (ThemePreference Value, string Key, string Label, string Description)[] ThemeOptions =
    [
        (ThemePreference.System, "system", "跟随系统", "随 Windows 应用模式"),
        (ThemePreference.Light, "light", "浅色", "始终使用浅色"),
        (ThemePreference.Dark, "dark", "深色", "始终使用深色")
    ];

    private static readonly (string Value, string Label, string Hint)[] ProcessModeOptions =
    [
        ("Compact", "简洁", "只留答案和一行过程摘要"),
        ("Standard", "标准", "完成的过程收成一行，点开才看细节"),
        ("Detailed", "详细", "过程逐行可见，仍可手动收起"),
        ("Expanded", "完全展开", "不分过程组，按真实顺序平铺")
    ];

    private static readonly (string Value, string Label)[] CollapseTimingOptions =
    [
        ("Completion", "生成结束即收起"),
        ("NextInput", "等下一条输入")
    ];

    private string ProcessModeHint =>
        ProcessModeOptions.FirstOrDefault(option => option.Value == _processMode).Hint ?? string.Empty;

    protected override void OnInitialized()
    {
        _language = Settings.Current.Language;
        _continueOnSwitch = Settings.Current.ContinueGenerationOnChatSwitch;
        _processMode = Settings.Current.Chat.ProcessMode.ToString();
        _collapseTiming = Settings.Current.Chat.CollapseTiming.ToString();
    }

    private void HandleProcessModeChanged(ChangeEventArgs args)
    {
        var value = args.Value?.ToString() ?? nameof(ProcessDisplayMode.Standard);

        if (!Enum.TryParse<ProcessDisplayMode>(value, ignoreCase: true, out var mode))
        {
            _processMode = Settings.Current.Chat.ProcessMode.ToString();
            return;
        }

        _processMode = mode.ToString();
        Settings.Current.Chat.ProcessMode = mode;
        Settings.Save();
    }

    private void HandleCollapseTimingChanged(ChangeEventArgs args)
    {
        var value = args.Value?.ToString() ?? nameof(ProcessCollapseTiming.Completion);

        if (!Enum.TryParse<ProcessCollapseTiming>(value, ignoreCase: true, out var timing))
        {
            _collapseTiming = Settings.Current.Chat.CollapseTiming.ToString();
            return;
        }

        _collapseTiming = timing.ToString();
        Settings.Current.Chat.CollapseTiming = timing;
        Settings.Save();
    }

    private void HandleContinueOnSwitchChanged(ChangeEventArgs args)
    {
        _continueOnSwitch = args.Value is true;

        if (Settings.Current.ContinueGenerationOnChatSwitch == _continueOnSwitch)
        {
            return;
        }

        Settings.Current.ContinueGenerationOnChatSwitch = _continueOnSwitch;
        Settings.Save();
    }

    private void HandleLanguageChanged(ChangeEventArgs args)
    {
        var value = args.Value?.ToString() ?? "zh-CN";

        // 目前只支持简体中文，其他语言先不落库。
        if (!string.Equals(value, "zh-CN", StringComparison.Ordinal))
        {
            _language = Settings.Current.Language;
            return;
        }

        _language = value;
        Settings.Current.Language = value;
        Settings.Save();
    }
}
