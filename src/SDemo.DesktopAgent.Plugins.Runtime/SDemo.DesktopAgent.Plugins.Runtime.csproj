<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- 插件运行时：扫描、校验、注册表、提示词组装、分段解析。
         只依赖契约与插件契约，不依赖 Core / UI / AI SDK。 -->
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>SDemo.DesktopAgent</RootNamespace>
    <AssemblyName>SDemo.DesktopAgent.Plugins.Runtime</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.12" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SDemo.DesktopAgent.Contracts\SDemo.DesktopAgent.Contracts.csproj" />
    <ProjectReference Include="..\SDemo.DesktopAgent.Plugins.Abstractions\SDemo.DesktopAgent.Plugins.Abstractions.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="SDemo.DesktopAgent.Core.Tests" />
  </ItemGroup>

</Project>
