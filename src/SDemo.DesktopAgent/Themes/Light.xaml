<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- 浅色主题：与 wwwroot/css/app.css 中的浅色变量保持一致 -->
    <SolidColorBrush x:Key="AppBackgroundBrush" Color="#F6F7F9" />
    <SolidColorBrush x:Key="TitleBarBackgroundBrush" Color="#F6F7F9" />
    <SolidColorBrush x:Key="TitleBarForegroundBrush" Color="#7A8394" />
    <SolidColorBrush x:Key="WindowBorderBrush" Color="#E0E3E9" />
    <SolidColorBrush x:Key="ChromeBorderBrush" Color="#E0E3E9" />
    <SolidColorBrush x:Key="CaptionButtonForegroundBrush" Color="#4A5161" />
    <SolidColorBrush x:Key="CaptionButtonHoverBrush" Color="#E9EBF0" />
    <SolidColorBrush x:Key="CloseButtonHoverBrush" Color="#C42B1C" />
    <SolidColorBrush x:Key="StatusBarBackgroundBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="StatusBarForegroundBrush" Color="#5F6B7A" />
    <SolidColorBrush x:Key="StatusBarMutedBrush" Color="#8A93A5" />
    <SolidColorBrush x:Key="StatusAccentBrush" Color="#1F9D63" />

</ResourceDictionary>
