<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <!-- Windows 10 2004+：WebView2 组合渲染控件依赖 Windows SDK 投影（Microsoft.Windows.SDK.NET） -->
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <!-- 托盘图标用 WinForms 的 NotifyIcon（两端同时开启时共享 Microsoft.WindowsDesktop.App） -->
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>SDemo.DesktopAgent</RootNamespace>
    <AssemblyName>SDemo.DesktopAgent</AssemblyName>
    <OutputType>WinExe</OutputType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <SatelliteResourceLanguages>en;zh-Hans</SatelliteResourceLanguages>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <!-- 只借用 WinForms 的 NotifyIcon，DPI 仍由 WPF 和 app.manifest 管理 -->
    <NoWarn>$(NoWarn);WFO0003</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\app.ico" />
  </ItemGroup>

  <!-- UseWindowsForms 会注入这两个全局 using，WPF 侧 Application / MessageBox 会冲突，去掉 -->
  <ItemGroup>
    <Using Remove="System.Drawing" />
    <Using Remove="System.Windows.Forms" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebView.Wpf" Version="10.0.110" />
  </ItemGroup>

  <ItemGroup>
    <!-- 界面与服务都来自共享工程，本工程只保留 WPF 宿主（窗口、托盘、主题资源、平台实现） -->
    <ProjectReference Include="..\SDemo.DesktopAgent.Core\SDemo.DesktopAgent.Core.csproj" />
    <ProjectReference Include="..\SDemo.DesktopAgent.UI\SDemo.DesktopAgent.UI.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- 内置插件：仓库根 plugins/ 随构建复制到输出目录的同级 plugins\ 下，
         运行时由 PluginCatalog 从 AppContext.BaseDirectory\plugins 只读加载。 -->
    <None Include="..\..\plugins\**\*"
          Link="plugins\%(RecursiveDir)%(Filename)%(Extension)"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
