@using SDemo.DesktopAgent.Services
@implements IDisposable
@inject IToolApprovalService Approvals

@* 顶层审批宿主：挂在 AppShell，切换会话时审批框不会消失；同一时间只显示一个请求。 *@
@if (Approvals.Current is { } request)
{
    <div class="modal-backdrop">
        <div class="modal modal--approval" role="dialog" aria-modal="true" aria-labelledby="approval-title">
            <h2 class="modal-title" id="approval-title">@request.Title</h2>
            <p class="modal-sub">@KindHint(request.Kind)</p>

            <div class="approval-meta">
                <span class="approval-risk approval-risk--@RiskClass(request.Risk)">风险：@RiskText(request.Risk)</span>
                <span class="modal-path">@request.Summary</span>
            </div>

            @if (request.Kind == ToolApprovalKind.FileEdit)
            {
                <div class="modal-preview approval-diff" role="group" aria-label="补丁预览">
                    @foreach (var line in DiffLines(request.Detail))
                    {
                        <div class="diff-line @DiffClass(line)">@line</div>
                    }
                </div>
            }
            else
            {
                <pre class="modal-preview modal-preview--script">@DetailText(request)</pre>
            }

            <div class="modal-actions">
                <button type="button" class="ghost-button" @onclick="() => Resolve(ToolApprovalDecision.Deny)">
                    拒绝
                </button>

                @if (request.AllowSessionRemember)
                {
                    <button type="button"
                            class="ghost-button"
                            @onclick="() => Resolve(ToolApprovalDecision.ApproveForSession)">
                        本会话允许
                    </button>
                }

                <button type="button" class="primary-button" @onclick="() => Resolve(ToolApprovalDecision.ApproveOnce)">
                    仅本次
                </button>
            </div>
        </div>
    </div>
}

@code {
    protected override void OnInitialized() => Approvals.Changed += OnChanged;

    public void Dispose() => Approvals.Changed -= OnChanged;

    private void OnChanged() => _ = InvokeAsync(StateHasChanged);

    private void Resolve(ToolApprovalDecision decision) => Approvals.Resolve(decision);

    private static string KindHint(ToolApprovalKind kind) => kind switch
    {
        ToolApprovalKind.FileWrite => "模型请求写入文件，确认后才会落盘。",
        ToolApprovalKind.FileEdit => "模型请求修改工作区文件；下方是统一 diff，确认后才会落盘。",
        ToolApprovalKind.ProcessExecution =>
            "脚本将在一个没有网络、只能访问工作区副本的沙箱中运行。请确认脚本内容与实际执行一致。",
        ToolApprovalKind.ApplyChanges => "将把沙箱内的改动写回真实工作区。",
        _ => string.Empty
    };

    private static string RiskText(AgentToolRisk risk) => risk switch
    {
        AgentToolRisk.High => "高",
        AgentToolRisk.Medium => "中",
        _ => "低"
    };

    private static string RiskClass(AgentToolRisk risk) => risk switch
    {
        AgentToolRisk.High => "high",
        AgentToolRisk.Medium => "medium",
        _ => "low"
    };

    /// <summary>
    /// diff 只显示前 200 行，但实际应用的是完整补丁；文件头 / hunk 头单独着色。
    /// </summary>
    private static IReadOnlyList<string> DiffLines(string detail)
    {
        var lines = detail.Replace("\r\n", "\n").Replace('\r', '\n').Split('\n');
        if (lines.Length <= 200)
        {
            return lines;
        }

        var shown = lines.Take(200).ToList();
        shown.Add($"…（共 {lines.Length} 行，已截断显示；实际应用完整补丁）");
        return shown;
    }

    private static string DiffClass(string line)
    {
        if (line.StartsWith("+++", StringComparison.Ordinal) || line.StartsWith("---", StringComparison.Ordinal))
        {
            return "diff-file";
        }

        if (line.StartsWith("@@", StringComparison.Ordinal))
        {
            return "diff-hunk";
        }

        if (line.StartsWith("+", StringComparison.Ordinal))
        {
            return "diff-add";
        }

        return line.StartsWith("-", StringComparison.Ordinal) ? "diff-del" : string.Empty;
    }

    /// <summary>
    /// 脚本完整展示（工具层已把上限压到 64KB）；文件内容可能很大，界面只截断显示，
    /// 但真正写入的仍是审批请求里的完整内容。
    /// </summary>
    private static string DetailText(ToolApprovalRequest request)
    {
        if (request.Kind == ToolApprovalKind.ProcessExecution)
        {
            return request.Detail;
        }

        const int maximum = 8000;
        return request.Detail.Length <= maximum
            ? request.Detail
            : string.Concat(request.Detail.AsSpan(0, maximum), "\n…（内容过长，仅显示前 8000 字符）");
    }
}
