@using SDemo.DesktopAgent.Plugins

@* 插件图标：只渲染 SVG path 数据（加载时已按白名单校验），没有 path 时退回首字。
   不接受整段 SVG 标记，详见设计文档 §13。 *@
@if (Plugin.Icon is { Paths.Count: > 0 } icon)
{
    <svg class="icon plugin-icon-svg" viewBox="0 0 24 24" aria-hidden="true">
        @foreach (var data in icon.Paths)
        {
            <path d="@data"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.5"
                  stroke-linecap="round"
                  stroke-linejoin="round" />
        }
    </svg>
}
else
{
    <span class="plugin-icon-text">@Plugin.Initial</span>
}

@code {
    [Parameter, EditorRequired]
    public PluginDescriptor Plugin { get; set; } = default!;
}
