@inject IThemeService ThemeService
@inject ISettingsService Settings
@inject IAppEnvironmentService Environment
@inject TokenCalibrationStore Calibration

@* 通用设置：外观 / 语言 / 版本信息 *@
<div class="settings-pane">
    <section class="settings-section">
        <h2 class="settings-section-title">外观</h2>
        <p class="settings-section-hint">选择「跟随系统」时，应用会随 Windows 的「应用模式」自动切换。</p>

        <div class="theme-options">
            @foreach (var option in ThemeOptions)
            {
                <button type="button"
                        class="theme-option @(ThemeService.Preference == option.Value ? "is-active" : null)"
                        @onclick="() => ThemeService.SetPreference(option.Value)">
                    <span class="theme-swatch theme-swatch--@option.Key"></span>
                    <span class="theme-label">@option.Label</span>
                    <span class="theme-desc">@option.Description</span>
                </button>
            }
        </div>
    </section>

    <section class="settings-section">
        <h2 class="settings-section-title">语言</h2>
        <p class="settings-section-hint">界面文案目前只有简体中文；其他语言会随资源本地化一起接入。</p>

        <div class="settings-row">
            <span class="settings-row-text">
                <span class="settings-row-title">界面语言</span>
                <span class="settings-row-hint">语言资源放在 .resx 中，切换后重新渲染界面。</span>
            </span>

            <select class="field-input field-input--select" value="@_language" @onchange="HandleLanguageChanged">
                <option value="zh-CN">简体中文</option>
                <option value="en-US" disabled>English（即将支持）</option>
            </select>
        </div>
    </section>

    <section class="settings-section">
        <h2 class="settings-section-title">上下文</h2>
        <p class="settings-section-hint">
            每次请求都会先估算 token 并按预算裁剪；原始消息不会被删除，只是不发送。
            这里只展示当前生效的参数，细项在 docs/context-budget.md 中有说明。
        </p>

        <label class="settings-row settings-row--toggle">
            <span class="settings-row-text">
                <span class="settings-row-title">启用上下文预算</span>
                <span class="settings-row-hint">关闭后等价于旧行为（直通），仍会记录报告。</span>
            </span>
            <input type="checkbox" class="switch" checked="@Context.Enabled" @onchange="ToggleEnabled" />
        </label>

        <label class="settings-row settings-row--toggle">
            <span class="settings-row-text">
                <span class="settings-row-title">显示占用环</span>
                <span class="settings-row-hint">输入框右下角的估算 token 占用；点开可看分段明细。</span>
            </span>
            <input type="checkbox" class="switch" checked="@Context.ShowContextMeter" @onchange="ToggleMeter" />
        </label>

        <dl class="info-list">
            <div class="info-row">
                <dt>预算占窗口</dt>
                <dd>@($"{Context.BudgetRatio:P0}")</dd>
            </div>
            <div class="info-row">
                <dt>保留最近轮次</dt>
                <dd>@Context.KeepRecentTurns 轮（小模型 @Context.SmallModelKeepRecentTurns 轮）</dd>
            </div>
            <div class="info-row">
                <dt>工具轨迹预算</dt>
                <dd>@Context.ToolTraceTokenBudget token / 条消息</dd>
            </div>
            <div class="info-row">
                <dt>附件内联上限</dt>
                <dd>@Context.AttachmentInlineTokens token（超出只留文件名与路径）</dd>
            </div>
            <div class="info-row">
                <dt>校准条目</dt>
                <dd>@_calibrationCount 个模型已学习过估算系数</dd>
            </div>
        </dl>

        <div class="settings-row">
            <span class="settings-row-text">
                <span class="settings-row-title">重置 token 校准</span>
                <span class="settings-row-hint">
                    用服务端返回的 usage 修正估算系数；怀疑偏差过大或换了模型时可重置。
                </span>
            </span>
            <button type="button" class="ghost-button" @onclick="ResetCalibration">重置校准</button>
        </div>
    </section>

    <section class="settings-section">
        <h2 class="settings-section-title">版本信息</h2>
        <p class="settings-section-hint">排查问题时把这几项一起发过来即可。</p>

        <dl class="info-list">
            <div class="info-row">
                <dt>应用版本</dt>
                <dd>@Environment.Version</dd>
            </div>
            <div class="info-row">
                <dt>.NET 运行时</dt>
                <dd>@Environment.RuntimeDescription</dd>
            </div>
            <div class="info-row">
                <dt>操作系统</dt>
                <dd>@Environment.OsDescription</dd>
            </div>
            <div class="info-row">
                <dt>宿主</dt>
                <dd>@Environment.HostName</dd>
            </div>
            <div class="info-row">
                <dt>WebView</dt>
                <dd>@Environment.WebViewVersion</dd>
            </div>
        </dl>
    </section>
</div>

@code {
    private string _language = "zh-CN";
    private int _calibrationCount;

    private ContextSettings Context => Settings.Current.Context;

    private static readonly (ThemePreference Value, string Key, string Label, string Description)[] ThemeOptions =
    [
        (ThemePreference.System, "system", "跟随系统", "随 Windows 应用模式"),
        (ThemePreference.Light, "light", "浅色", "始终使用浅色"),
        (ThemePreference.Dark, "dark", "深色", "始终使用深色")
    ];

    protected override void OnInitialized()
    {
        _language = Settings.Current.Language;
        _calibrationCount = Calibration.Snapshot().Count;
    }

    private void ToggleEnabled(ChangeEventArgs args)
    {
        Context.Enabled = args.Value is true;
        Settings.Save();
    }

    private void ToggleMeter(ChangeEventArgs args)
    {
        Context.ShowContextMeter = args.Value is true;
        Settings.Save();
    }

    private void ResetCalibration()
    {
        Calibration.ResetAll();
        _calibrationCount = 0;
    }

    private void HandleLanguageChanged(ChangeEventArgs args)
    {
        var value = args.Value?.ToString() ?? "zh-CN";

        // 目前只支持简体中文，其他语言先不落库。
        if (!string.Equals(value, "zh-CN", StringComparison.Ordinal))
        {
            _language = Settings.Current.Language;
            return;
        }

        _language = value;
        Settings.Current.Language = value;
        Settings.Save();
    }
}
