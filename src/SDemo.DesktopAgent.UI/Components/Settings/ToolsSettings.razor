@using SDemo.DesktopAgent.Models
@using SDemo.DesktopAgent.Sandbox
@inject ISettingsService Settings
@inject ISearchService Search
@inject ISandboxJobService Sandbox
@inject AgentToolRegistry ToolRegistry

@* 工具设置：联网搜索后端 + 文件写入确认 *@
<div class="settings-pane">
    <section class="settings-section">
        <h2 class="settings-section-title">联网搜索</h2>
        <p class="settings-section-hint">默认使用必应 RSS（免密钥）；也可以填自己的搜索接口地址与 Key。</p>

        <div class="segmented">
            <button type="button"
                    class="segmented-item @(Settings.Current.Search.Backend == SearchBackend.Bing ? "is-active" : null)"
                    @onclick="() => SetBackend(SearchBackend.Bing)">
                必应 RSS
            </button>
            <button type="button"
                    class="segmented-item @(Settings.Current.Search.Backend == SearchBackend.Custom ? "is-active" : null)"
                    @onclick="() => SetBackend(SearchBackend.Custom)">
                自定义 API
            </button>
        </div>

        @if (Settings.Current.Search.Backend == SearchBackend.Custom)
        {
            <div class="field field--wide">
                <span class="field-label">接口地址</span>
                <input class="field-input"
                       @bind="_endpoint"
                       @bind:event="oninput"
                       placeholder="https://open.feedcoopapi.com/search_api/global_search" />
                <span class="field-hint">按 POST 提交 JSON（query / top_k），返回 JSON 即可。</span>
            </div>

            <div class="field field--wide">
                <span class="field-label">API Key</span>
                <span class="field-secret">
                    <input class="field-input"
                           type="@(_showKey ? "text" : "password")"
                           @bind="_apiKey"
                           @bind:event="oninput"
                           autocomplete="off"
                           placeholder="可留空" />
                    <button type="button" class="field-secret-toggle" @onclick="() => _showKey = !_showKey">
                        @(_showKey ? "隐藏" : "显示")
                    </button>
                </span>
            </div>

            <div class="editor-footer">
                <button type="button" class="ghost-button" disabled="@_isTesting" @onclick="TestSearchAsync">
                    @(_isTesting ? "测试中…" : "测试搜索")
                </button>
                <button type="button" class="primary-button" @onclick="SaveSearch">保存</button>
            </div>
        }
        else
        {
            <div class="editor-footer">
                <button type="button" class="ghost-button" disabled="@_isTesting" @onclick="TestSearchAsync">
                    @(_isTesting ? "测试中…" : "测试搜索")
                </button>
            </div>
        }

        @if (_message is not null)
        {
            <p class="settings-message">@_message</p>
        }

        @if (_searchResult is not null)
        {
            <pre class="search-preview">@_searchResult</pre>
        }
    </section>

    <section class="settings-section">
        <h2 class="settings-section-title">文件写入</h2>
        <p class="settings-section-hint">工作区里的文件由模型读写；写入前可以要求确认。</p>

        <label class="settings-row settings-row--toggle">
            <span class="settings-row-text">
                <span class="settings-row-title">写入前需要确认</span>
                <span class="settings-row-hint">关闭后模型可以直接覆盖工作区文件。</span>
            </span>
            <input type="checkbox"
                   class="switch"
                   checked="@Settings.Current.ConfirmFileWrite"
                   @onchange="ToggleConfirmWrite" />
        </label>
    </section>

    @if (PowerShellDescriptor is not null)
    {
        <section class="settings-section">
            <h2 class="settings-section-title">PowerShell</h2>
            <p class="settings-section-hint">
                PowerShell 只在 AppContainer 沙箱内执行：无网络，只能读写工作区副本；改动需要你在变更面板确认后才写回。
                沙箱不可用时工具直接不可用，不会退回无沙箱直跑。
            </p>

        <label class="settings-row settings-row--toggle">
            <span class="settings-row-text">
                <span class="settings-row-title">启用 PowerShell 工具（默认关闭）</span>
                <span class="settings-row-hint">
                    @(PowerShellAvailable
                        ? "启用后还需要在输入框里打开工具 chip 才会交给模型。"
                        : PowerShellUnavailableReason)
                </span>
            </span>
            <input type="checkbox"
                   class="switch"
                   checked="@PowerShellEnabled"
                   disabled="@(!PowerShellAvailable)"
                   @onchange="TogglePowerShell" />
        </label>

        <div class="settings-grid">
            <label class="field">
                <span class="field-label">超时（秒）</span>
                <input class="field-input"
                       type="number"
                       min="1"
                       max="120"
                       value="@Settings.Current.Sandbox.TimeoutSeconds"
                       @onchange="ChangeTimeout" />
                <span class="field-hint">1–120；模型请求的超时也受这个范围约束。</span>
            </label>

            <label class="field">
                <span class="field-label">内存上限（MB）</span>
                <input class="field-input"
                       type="number"
                       min="64"
                       max="8192"
                       value="@Settings.Current.Sandbox.MemoryLimitMB"
                       @onchange="ChangeMemory" />
                <span class="field-hint">单个沙箱进程的上限；整个 Job 另有 2 倍上限。</span>
            </label>
        </div>

        <div class="settings-subsection">
            <span class="field-label">沙箱模式</span>
            <div class="segmented">
                <button type="button"
                        class="segmented-item @(IsSandboxMode(SandboxRequirement.Preferred) ? "is-active" : null)"
                        @onclick="() => SetSandboxMode(SandboxRequirement.Preferred)">
                    自动
                </button>
                <button type="button"
                        class="segmented-item @(IsSandboxMode(SandboxRequirement.Required) ? "is-active" : null)"
                        @onclick="() => SetSandboxMode(SandboxRequirement.Required)">
                    强制
                </button>
                @if (IsDebugBuild && !Settings.Current.Sandbox.Enabled)
                {
                    <button type="button" class="segmented-item is-active is-danger" disabled>
                        关闭（仅开发）
                    </button>
                }
            </div>
            <span class="field-hint">
                自动 = 首选沙箱不可用时允许换用其他可用沙箱；强制 = 只用首选沙箱，首选不可用就拒绝。
                两者都不会回退到无沙箱执行。
            </span>
        </div>

        <label class="settings-row settings-row--toggle">
            <span class="settings-row-text">
                <span class="settings-row-title">每次执行都需要确认（固定开启）</span>
                <span class="settings-row-hint">
                    审批框会展示完整脚本；批准一次只对这一次执行有效，不支持“同脚本本会话自动批准”。
                </span>
            </span>
            <input type="checkbox" class="switch" checked disabled />
        </label>

        @if (IsDebugBuild)
        {
            <div class="editor-footer">
                <button type="button"
                        class="ghost-button"
                        @onclick="() => SetSandboxEnabled(!Settings.Current.Sandbox.Enabled)">
                    @(Settings.Current.Sandbox.Enabled ? "关闭执行沙箱（仅开发）" : "重新启用执行沙箱")
                </button>
            </div>

            @if (!Settings.Current.Sandbox.Enabled)
            {
                <p class="settings-message is-danger">
                    执行沙箱已关闭：PowerShell 完全不可用，不会退回无沙箱执行。此选项只在调试构建里提供。
                </p>
            }
        }
        </section>
    }

    <section class="settings-section">
        <h2 class="settings-section-title">执行沙箱</h2>
        <p class="settings-section-hint">
            PowerShell 与 PDF 解析都在 AppContainer 中运行；沙箱不可用时直接拒绝执行，不会退回无沙箱直跑。
        </p>

        <div class="sandbox-status">
            <span class="sandbox-badge @SandboxBadgeClass">@SandboxBadgeText</span>
            <span class="settings-message">@_availability?.Reason</span>
        </div>

        <div class="editor-footer">
            <button type="button" class="ghost-button" disabled="@_isSandboxTesting" @onclick="RunSandboxSelfTestAsync">
                @(_isSandboxTesting ? "自检中…（会启动真实进程）" : "执行沙箱自检")
            </button>
        </div>

        @if (_sandboxMessage is not null)
        {
            <p class="settings-message">@_sandboxMessage</p>
        }

        @if (_sandboxReport is not null)
        {
            <ul class="sandbox-checks">
                <li class="@CheckClass(_sandboxReport.CmdOk)">基本进程：能在沙箱内启动 cmd</li>
                <li class="@CheckClass(_sandboxReport.PowerShellOk)">PowerShell：能执行脚本并正确输出 UTF-8 中文</li>
                <li class="@CheckClass(_sandboxReport.CannotReadUserProfile)">隔离：不能读取用户目录里的文件</li>
                <li class="@CheckClass(_sandboxReport.CannotWriteWorkspace)">隔离：不能写入工作区</li>
                <li class="@CheckClass(_sandboxReport.NoNetwork)">隔离：没有网络访问</li>
                <li class="@CheckClass(_sandboxReport.SubprocessOk)">子进程：允许在 Job 内启动</li>
                <li class="@CheckClass(_sandboxReport.TimeoutOk)">超时：到点终止整棵进程树</li>
            </ul>

            @if (!string.IsNullOrWhiteSpace(_sandboxReport.Detail))
            {
                <pre class="search-preview">@_sandboxReport.Detail</pre>
            }
        }
    </section>
</div>

@code {
    private string _endpoint = string.Empty;
    private string _apiKey = string.Empty;
    private bool _showKey;
    private bool _isTesting;
    private string? _message;
    private string? _searchResult;
    private SandboxAvailability? _availability;
    private SandboxProbeReport? _sandboxReport;
    private string? _sandboxMessage;
    private bool _isSandboxTesting;

    protected override async Task OnInitializedAsync()
    {
        _endpoint = Settings.Current.Search.Endpoint;
        _apiKey = Settings.Current.Search.ApiKey;
        _availability = await Sandbox.GetAvailabilityAsync();
    }

    private string SandboxBadgeClass => _availability switch
    {
        { Available: true, Verified: true } => "sandbox-badge--ok",
        { Available: true } => "sandbox-badge--warn",
        _ => "sandbox-badge--off"
    };

    private AgentToolPackDescriptor? PowerShellDescriptor => ToolRegistry.Find("powershell");

    /// <summary>PowerShell 工具包的用户开关；没有记录时按描述里的默认值（关闭）。</summary>
    private bool PowerShellEnabled => Settings.Current.Tools.IsPackEnabled(
        "powershell",
        PowerShellDescriptor?.DefaultEnabled ?? false);

    /// <summary>可用 = 沙箱总开关打开，并且 AppContainer + PowerShell 都通过实测。</summary>
    private bool PowerShellAvailable =>
        Settings.Current.Sandbox.Enabled && _availability is { Available: true, Verified: true };

    private string PowerShellUnavailableReason => !Settings.Current.Sandbox.Enabled
        ? "执行沙箱已在设置中关闭。"
        : _availability switch
        {
            null => "正在检测沙箱…",
            { Available: false } => _availability.Reason ?? "沙箱不可用。",
            { Verified: false } => _availability.Reason ?? "PowerShell 尚未通过沙箱自检。",
            _ => "沙箱可用。"
        };

    private bool IsSandboxMode(SandboxRequirement requirement) =>
        Settings.Current.Sandbox.Enabled && Settings.Current.Sandbox.Requirement == requirement;

#if DEBUG
    private const bool IsDebugBuild = true;
#else
    private const bool IsDebugBuild = false;
#endif

    private void TogglePowerShell(ChangeEventArgs args)
    {
        Settings.Current.Tools.SetPackEnabled("powershell", args.Value is true);
        Settings.Save();
    }

    private void ChangeTimeout(ChangeEventArgs args)
    {
        if (int.TryParse(args.Value?.ToString(), out var seconds))
        {
            Settings.Current.Sandbox.TimeoutSeconds = Math.Clamp(seconds, 1, 120);
            Settings.Save();
        }
    }

    private void ChangeMemory(ChangeEventArgs args)
    {
        if (int.TryParse(args.Value?.ToString(), out var megabytes))
        {
            Settings.Current.Sandbox.MemoryLimitMB = Math.Clamp(megabytes, 64, 8192);
            Settings.Current.Sandbox.JobMemoryLimitMB = Math.Max(1024, Settings.Current.Sandbox.MemoryLimitMB * 2);
            Settings.Save();
        }
    }

    private void SetSandboxMode(SandboxRequirement requirement)
    {
        Settings.Current.Sandbox.Enabled = true;
        Settings.Current.Sandbox.Requirement = requirement;
        Settings.Save();
    }

    private void SetSandboxEnabled(bool enabled)
    {
        Settings.Current.Sandbox.Enabled = enabled;
        Settings.Save();
    }

    private string SandboxBadgeText => _availability switch
    {
        { Available: true, Verified: true } => "已就绪",
        { Available: true } => "仅基本进程可用",
        _ => "不可用"
    };

    private static string CheckClass(bool passed) => passed ? "sandbox-check is-pass" : "sandbox-check is-fail";

    private async Task RunSandboxSelfTestAsync()
    {
        _isSandboxTesting = true;
        _sandboxReport = null;
        _sandboxMessage = null;

        try
        {
            _sandboxReport = await Sandbox.RunSelfTestAsync();
            _availability = await Sandbox.GetAvailabilityAsync();
            _sandboxMessage = _sandboxReport.AllPassed ? "自检全部通过。" : "自检未全部通过，详见下方。";
        }
        catch (Exception ex)
        {
            _sandboxMessage = $"自检执行失败：{ex.Message}";
        }
        finally
        {
            _isSandboxTesting = false;
        }
    }

    private void SetBackend(SearchBackend backend)
    {
        Settings.Current.Search.Backend = backend;
        Settings.Save();
        _message = null;
        _searchResult = null;
    }

    private void SaveSearch()
    {
        Settings.Current.Search.Endpoint = _endpoint.Trim();
        Settings.Current.Search.ApiKey = _apiKey.Trim();
        Settings.Save();
        _message = "已保存。";
    }

    private async Task TestSearchAsync()
    {
        // 测试前先落库，确保测的是当前填写的配置。
        SaveSearch();

        _isTesting = true;
        _searchResult = null;
        _message = null;

        try
        {
            _searchResult = await Search.SearchAsync("火山方舟");
        }
        finally
        {
            _isTesting = false;
        }
    }

    private void ToggleConfirmWrite(ChangeEventArgs args)
    {
        Settings.Current.ConfirmFileWrite = args.Value is true;
        Settings.Save();
    }
}
