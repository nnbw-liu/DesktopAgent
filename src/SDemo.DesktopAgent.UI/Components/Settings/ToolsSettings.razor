@using SDemo.DesktopAgent.Models
@using SDemo.DesktopAgent.Sandbox
@inject ISettingsService Settings
@inject ISearchService Search
@inject ISandboxJobService Sandbox

@* 工具设置：联网搜索后端 + 文件写入确认 *@
<div class="settings-pane">
    <section class="settings-section">
        <h2 class="settings-section-title">联网搜索</h2>
        <p class="settings-section-hint">默认使用必应 RSS（免密钥）；也可以填自己的搜索接口地址与 Key。</p>

        <div class="segmented">
            <button type="button"
                    class="segmented-item @(Settings.Current.Search.Backend == SearchBackend.Bing ? "is-active" : null)"
                    @onclick="() => SetBackend(SearchBackend.Bing)">
                必应 RSS
            </button>
            <button type="button"
                    class="segmented-item @(Settings.Current.Search.Backend == SearchBackend.Custom ? "is-active" : null)"
                    @onclick="() => SetBackend(SearchBackend.Custom)">
                自定义 API
            </button>
        </div>

        @if (Settings.Current.Search.Backend == SearchBackend.Custom)
        {
            <div class="field field--wide">
                <span class="field-label">接口地址</span>
                <input class="field-input"
                       @bind="_endpoint"
                       @bind:event="oninput"
                       placeholder="https://open.feedcoopapi.com/search_api/global_search" />
                <span class="field-hint">按 POST 提交 JSON（query / top_k），返回 JSON 即可。</span>
            </div>

            <div class="field field--wide">
                <span class="field-label">API Key</span>
                <span class="field-secret">
                    <input class="field-input"
                           type="@(_showKey ? "text" : "password")"
                           @bind="_apiKey"
                           @bind:event="oninput"
                           autocomplete="off"
                           placeholder="可留空" />
                    <button type="button" class="field-secret-toggle" @onclick="() => _showKey = !_showKey">
                        @(_showKey ? "隐藏" : "显示")
                    </button>
                </span>
            </div>

            <div class="editor-footer">
                <button type="button" class="ghost-button" disabled="@_isTesting" @onclick="TestSearchAsync">
                    @(_isTesting ? "测试中…" : "测试搜索")
                </button>
                <button type="button" class="primary-button" @onclick="SaveSearch">保存</button>
            </div>
        }
        else
        {
            <div class="editor-footer">
                <button type="button" class="ghost-button" disabled="@_isTesting" @onclick="TestSearchAsync">
                    @(_isTesting ? "测试中…" : "测试搜索")
                </button>
            </div>
        }

        @if (_message is not null)
        {
            <p class="settings-message">@_message</p>
        }

        @if (_searchResult is not null)
        {
            <pre class="search-preview">@_searchResult</pre>
        }
    </section>

    <section class="settings-section">
        <h2 class="settings-section-title">文件写入</h2>
        <p class="settings-section-hint">工作区里的文件由模型读写；写入前可以要求确认。</p>

        <label class="settings-row settings-row--toggle">
            <span class="settings-row-text">
                <span class="settings-row-title">写入前需要确认</span>
                <span class="settings-row-hint">关闭后模型可以直接覆盖工作区文件。</span>
            </span>
            <input type="checkbox"
                   class="switch"
                   checked="@Settings.Current.ConfirmFileWrite"
                   @onchange="ToggleConfirmWrite" />
        </label>
    </section>

    <section class="settings-section">
        <h2 class="settings-section-title">执行沙箱</h2>
        <p class="settings-section-hint">
            PowerShell 与 PDF 解析都在 AppContainer 中运行；沙箱不可用时直接拒绝执行，不会退回无沙箱直跑。
        </p>

        <div class="sandbox-status">
            <span class="sandbox-badge @SandboxBadgeClass">@SandboxBadgeText</span>
            <span class="settings-message">@_availability?.Reason</span>
        </div>

        <div class="editor-footer">
            <button type="button" class="ghost-button" disabled="@_isSandboxTesting" @onclick="RunSandboxSelfTestAsync">
                @(_isSandboxTesting ? "自检中…（会启动真实进程）" : "执行沙箱自检")
            </button>
        </div>

        @if (_sandboxMessage is not null)
        {
            <p class="settings-message">@_sandboxMessage</p>
        }

        @if (_sandboxReport is not null)
        {
            <ul class="sandbox-checks">
                <li class="@CheckClass(_sandboxReport.CmdOk)">基本进程：能在沙箱内启动 cmd</li>
                <li class="@CheckClass(_sandboxReport.PowerShellOk)">PowerShell：能执行脚本并正确输出 UTF-8 中文</li>
                <li class="@CheckClass(_sandboxReport.CannotReadUserProfile)">隔离：不能读取用户目录里的文件</li>
                <li class="@CheckClass(_sandboxReport.CannotWriteWorkspace)">隔离：不能写入工作区</li>
                <li class="@CheckClass(_sandboxReport.NoNetwork)">隔离：没有网络访问</li>
                <li class="@CheckClass(_sandboxReport.SubprocessOk)">子进程：允许在 Job 内启动</li>
                <li class="@CheckClass(_sandboxReport.TimeoutOk)">超时：到点终止整棵进程树</li>
            </ul>

            @if (!string.IsNullOrWhiteSpace(_sandboxReport.Detail))
            {
                <pre class="search-preview">@_sandboxReport.Detail</pre>
            }
        }
    </section>
</div>

@code {
    private string _endpoint = string.Empty;
    private string _apiKey = string.Empty;
    private bool _showKey;
    private bool _isTesting;
    private string? _message;
    private string? _searchResult;
    private SandboxAvailability? _availability;
    private SandboxProbeReport? _sandboxReport;
    private string? _sandboxMessage;
    private bool _isSandboxTesting;

    protected override async Task OnInitializedAsync()
    {
        _endpoint = Settings.Current.Search.Endpoint;
        _apiKey = Settings.Current.Search.ApiKey;
        _availability = await Sandbox.GetAvailabilityAsync();
    }

    private string SandboxBadgeClass => _availability switch
    {
        { Available: true, Verified: true } => "sandbox-badge--ok",
        { Available: true } => "sandbox-badge--warn",
        _ => "sandbox-badge--off"
    };

    private string SandboxBadgeText => _availability switch
    {
        { Available: true, Verified: true } => "已就绪",
        { Available: true } => "仅基本进程可用",
        _ => "不可用"
    };

    private static string CheckClass(bool passed) => passed ? "sandbox-check is-pass" : "sandbox-check is-fail";

    private async Task RunSandboxSelfTestAsync()
    {
        _isSandboxTesting = true;
        _sandboxReport = null;
        _sandboxMessage = null;

        try
        {
            _sandboxReport = await Sandbox.RunSelfTestAsync();
            _availability = await Sandbox.GetAvailabilityAsync();
            _sandboxMessage = _sandboxReport.AllPassed ? "自检全部通过。" : "自检未全部通过，详见下方。";
        }
        catch (Exception ex)
        {
            _sandboxMessage = $"自检执行失败：{ex.Message}";
        }
        finally
        {
            _isSandboxTesting = false;
        }
    }

    private void SetBackend(SearchBackend backend)
    {
        Settings.Current.Search.Backend = backend;
        Settings.Save();
        _message = null;
        _searchResult = null;
    }

    private void SaveSearch()
    {
        Settings.Current.Search.Endpoint = _endpoint.Trim();
        Settings.Current.Search.ApiKey = _apiKey.Trim();
        Settings.Save();
        _message = "已保存。";
    }

    private async Task TestSearchAsync()
    {
        // 测试前先落库，确保测的是当前填写的配置。
        SaveSearch();

        _isTesting = true;
        _searchResult = null;
        _message = null;

        try
        {
            _searchResult = await Search.SearchAsync("火山方舟");
        }
        finally
        {
            _isTesting = false;
        }
    }

    private void ToggleConfirmWrite(ChangeEventArgs args)
    {
        Settings.Current.ConfirmFileWrite = args.Value is true;
        Settings.Save();
    }
}
