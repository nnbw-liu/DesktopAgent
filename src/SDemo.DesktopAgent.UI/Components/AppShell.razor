@using System.IO
@implements IDisposable
@inject IThemeService ThemeService
@inject IJSRuntime Js
@inject ISettingsService Settings
@inject WorkspaceContext WorkspaceContext
@inject IFolderPickerService FolderPicker
@inject ChatStore ChatStore

<div class="app-shell">
    <Sidebar Workspaces="Workspaces"
             Sessions="SortedSessions"
             ActiveSessionId="@(_view == MainView.Chat ? _activeSession?.Id : null)"
             ActiveWorkspaceId="@(_view == MainView.Chat ? _activeSession?.WorkspaceId : null)"
             ActiveSessionIsEmpty="@(_view == MainView.Chat && _activeSession is { Messages.Count: 0 })"
             IsSettingsActive="@(_view == MainView.Settings)"
             OnNewChat="StartNewChat"
             OnOpenSession="OpenSession"
             OnOpenSettings="OpenSettings"
             OnNewChatInWorkspace="NewChatInWorkspace"
             OnAddWorkspace="AddWorkspace"
             OnTogglePin="TogglePin"
             OnDeleteSession="DeleteSession"
             OnRenameSession="RenameSession"
             OnDeleteWorkspace="DeleteWorkspace"
             OnRenameWorkspace="RenameWorkspace" />

    <main class="main-area">
        @if (_view == MainView.Settings)
        {
            <SettingsView InitialSection="_settingsSection" />
        }
        else if (_activeSession is null)
        {
            <div class="landing">
                <div class="empty-state">
                    <span class="empty-mark">D</span>
                    <h1>开始新的对话</h1>
                    <p>在左侧「新建聊天室」，或从历史会话中选择一个继续。</p>
                </div>
            </div>
        }
        else
        {
            <ChatRoom Session="_activeSession"
                      Workspaces="Workspaces"
                      OnSend="HandleSendMessage"
                      OnSessionChanged="PersistSession"
                      OnBranch="BranchSession"
                      OnGeneratingChanged="SetGenerating"
                      OnOpenModelSettings="OpenModelSettings"
                      OnWorkspaceChanged="ChangeWorkspace"
                      OnPickWorkspace="PickWorkspace" />
        }
    </main>
</div>

@code {
    private enum MainView
    {
        Chat,
        Settings
    }

    private List<ChatSession> _sessions = [];

    // 启动后默认就是一个新建的空聊天室（尚不进入历史列表，等有内容才加入）。
    private ChatSession? _activeSession;

    private MainView _view = MainView.Chat;

    private SettingsSection _settingsSection = SettingsSection.General;

    private IReadOnlyList<Workspace> Workspaces => Settings.Current.Workspaces;

    private IReadOnlyList<ChatSession> SortedSessions =>
        _sessions
            .OrderByDescending(session => session.IsPinned)
            .ThenByDescending(session => session.UpdatedAt)
            .ToList();

    protected override async Task OnInitializedAsync()
    {
        // 启动时从各个 SQLite 库恢复历史会话（工作区 DB + 历史聊天 DB）。
        _sessions = (await ChatStore.LoadAllAsync(Workspaces)).ToList();
        _activeSession = ChatSession.CreateEmpty();
        UpdateWorkspaceRoot();
    }

    /// <summary>新建聊天室：默认不归属任何工作区，进「历史聊天」。</summary>
    private void StartNewChat()
    {
        _view = MainView.Chat;
        _activeSession = ChatSession.CreateEmpty();
        UpdateWorkspaceRoot();
    }

    /// <summary>在指定工作区里新建聊天室。</summary>
    private void NewChatInWorkspace(Workspace workspace)
    {
        _view = MainView.Chat;
        _activeSession = ChatSession.CreateEmpty(workspace.Id);
        UpdateWorkspaceRoot();
    }

    /// <summary>打开聊天室（历史聊天或工作区里的都可以）。</summary>
    private void OpenSession(ChatSession session)
    {
        _view = MainView.Chat;
        _activeSession = session;
        UpdateWorkspaceRoot();
    }

    /// <summary>打开设置：右侧整页显示。</summary>
    private void OpenSettings()
    {
        _settingsSection = SettingsSection.General;
        _view = MainView.Settings;
    }

    /// <summary>直接打开设置里的「模型设置」分区。</summary>
    private void OpenModelSettings()
    {
        _settingsSection = SettingsSection.Models;
        _view = MainView.Settings;
    }

    private async Task TogglePin(ChatSession session)
    {
        session.IsPinned = !session.IsPinned;
        await ChatStore.SaveSessionAsync(session);
    }

    private async Task DeleteSession(ChatSession session)
    {
        _sessions.Remove(session);
        await ChatStore.DeleteSessionAsync(session);

        if (ReferenceEquals(_activeSession, session))
        {
            _view = MainView.Chat;
            _activeSession = ChatSession.CreateEmpty(session.WorkspaceId);
            UpdateWorkspaceRoot();
        }
    }

    /// <summary>添加工作区：选一个本地文件夹。</summary>
    private async Task AddWorkspace()
    {
        var workspace = await PickOrCreateWorkspaceAsync();
        if (workspace is null)
        {
            return;
        }

        UpdateWorkspaceRoot();
    }

    private async Task RenameSession((ChatSession Session, string Title) args)
    {
        args.Session.Title = args.Title;
        await ChatStore.SaveSessionAsync(args.Session);
    }

    private void RenameWorkspace((Workspace Workspace, string Name) args)
    {
        args.Workspace.Name = args.Name;
        Settings.Save();
    }

    private async Task DeleteWorkspace(Workspace workspace)
    {
        var affected = _sessions
            .Where(session => session.WorkspaceId == workspace.Id)
            .ToList();

        // 先把该工作区 DB 里的会话搬到历史聊天 DB，再删工作区记录和 DB 文件。
        await ChatStore.DeleteWorkspaceStoreAsync(workspace.Id);

        Settings.Current.Workspaces.Remove(workspace);
        Settings.Save();

        // 内存里的会话跟着回到历史聊天（同时把尚未落库的最新内容补写进历史库）。
        foreach (var session in affected)
        {
            session.WorkspaceId = null;
            await ChatStore.SaveSessionAsync(session);
        }

        if (_activeSession?.WorkspaceId == workspace.Id)
        {
            _activeSession.WorkspaceId = null;
        }

        UpdateWorkspaceRoot();
    }

    /// <summary>聊天室里切换工作区：空会话只改归属，已有内容的会话要把行搬到目标库。</summary>
    private async Task ChangeWorkspace(Workspace workspace)
    {
        if (_activeSession is null)
        {
            return;
        }

        if (_activeSession.Messages.Count == 0)
        {
            _activeSession.WorkspaceId = workspace.Id;
        }
        else
        {
            await ChatStore.MoveSessionAsync(_activeSession, workspace.Id);
        }

        UpdateWorkspaceRoot();
    }

    /// <summary>下拉框最底部的「选择工作区」：选文件夹 → 建工作区 → 归到当前会话。</summary>
    private async Task PickWorkspace()
    {
        var workspace = await PickOrCreateWorkspaceAsync();
        if (workspace is null)
        {
            return;
        }

        await ChangeWorkspace(workspace);
    }

    /// <summary>弹出文件夹选择框，并按路径复用 / 新建工作区。</summary>
    private async Task<Workspace?> PickOrCreateWorkspaceAsync()
    {
        string? path;
        try
        {
            path = await FolderPicker.PickFolderAsync("选择工作区文件夹", WorkspaceContext.RootPath);
        }
        catch (Exception)
        {
            // 对话框异常（或被系统拒绝）不影响主流程。
            return null;
        }

        if (string.IsNullOrWhiteSpace(path))
        {
            return null;
        }

        var existing = Workspaces.FirstOrDefault(workspace =>
            string.Equals(workspace.Path, path, StringComparison.OrdinalIgnoreCase));

        if (existing is not null)
        {
            return existing;
        }

        var name = Path.GetFileName(path.TrimEnd(Path.DirectorySeparatorChar, Path.AltDirectorySeparatorChar));
        var created = new Workspace
        {
            Id = Guid.NewGuid().ToString("N"),
            Name = string.IsNullOrWhiteSpace(name) ? path : name,
            Path = path
        };

        Settings.Current.Workspaces.Add(created);
        Settings.Save();
        return created;
    }

    private void UpdateWorkspaceRoot()
    {
        // 没有工作区的会话（历史聊天）用默认文档目录当文件工具的根。
        var workspace = Workspaces.FirstOrDefault(item => item.Id == _activeSession?.WorkspaceId);

        WorkspaceContext.RootPath = workspace?.Path ?? WorkspaceContext.DefaultRootPath;
    }

    /// <summary>
    /// 发送一条用户消息：写入会话（含附件）→ 首次有内容时补标题并落到对应的 SQLite 库。
    /// 聊天室随之从「空态居中」切到「有记录布局」。
    /// </summary>
    private async Task HandleSendMessage(ComposerSubmission submission)
    {
        if (_activeSession is null || (string.IsNullOrWhiteSpace(submission.Text) && submission.Attachments.Count == 0))
        {
            return;
        }

        var session = _activeSession;
        session.Messages.Add(new ChatMessage(ChatMessageRole.User, submission.Text)
        {
            Attachments = submission.Attachments.ToList()
        });
        session.UpdatedAt = DateTime.Now;

        if (session.Messages.Count == 1)
        {
            session.Title = BuildTitle(submission.Text, submission.Attachments);
            session.Meta = DateTime.Now.ToString("HH:mm");
        }

        // 新建的聊天室要有内容才出现在左侧历史列表里。
        if (!_sessions.Contains(session))
        {
            _sessions.Insert(0, session);
        }

        await ChatStore.SaveSessionAsync(session);
    }

    /// <summary>助手消息生成结束（或失败 / 停止）后由 ChatRoom 回调，把最新内容写回数据库。</summary>
    private async Task PersistSession(ChatSession session)
    {
        session.UpdatedAt = DateTime.Now;
        await ChatStore.SaveSessionAsync(session);
    }

    /// <summary>生成开始 / 结束时更新会话状态，左侧列表据此显示“推理中”。</summary>
    private void SetGenerating((ChatSession Session, bool IsGenerating) args) =>
        args.Session.IsGenerating = args.IsGenerating;

    /// <summary>从某条助手消息创建分支：复制到这条消息为止的上下文，打开新会话。</summary>
    private async Task BranchSession(ChatMessage message)
    {
        if (_activeSession is null)
        {
            return;
        }

        var source = _activeSession;
        var index = source.Messages.IndexOf(message);
        if (index < 0)
        {
            return;
        }

        var branch = new ChatSession
        {
            Id = Guid.NewGuid().ToString("N"),
            Title = $"{Truncate(source.Title)} · 分支",
            Meta = "刚刚",
            WorkspaceId = source.WorkspaceId,
            UpdatedAt = DateTime.Now,
            Messages = source.Messages
                .Take(index + 1)
                .Select(CloneMessage)
                .ToList()
        };

        _sessions.Insert(0, branch);
        await ChatStore.SaveSessionAsync(branch);

        _view = MainView.Chat;
        _activeSession = branch;
        UpdateWorkspaceRoot();
    }

    private static ChatMessage CloneMessage(ChatMessage message) => new(message.Role, message.Content)
    {
        Id = Guid.NewGuid().ToString("N"),
        Reasoning = message.Reasoning,
        Attachments = [.. message.Attachments],
        CreatedAt = message.CreatedAt,
        DurationMs = message.DurationMs,
        InputTokens = message.InputTokens,
        OutputTokens = message.OutputTokens,
        ToolCalls = new Dictionary<string, int>(message.ToolCalls, StringComparer.OrdinalIgnoreCase)
    };

    private static string BuildTitle(string text, IReadOnlyList<ChatAttachment> attachments)
    {
        var firstLine = text
            .Split('\n', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
            .FirstOrDefault();

        if (string.IsNullOrWhiteSpace(firstLine))
        {
            if (attachments.Count == 0)
            {
                return "新聊天室";
            }

            // 只发了附件的会话：用第一个文件名当标题。
            return Truncate(attachments[0].FileName);
        }

        return Truncate(firstLine);
    }

    private static string Truncate(string value) =>
        value.Length <= 18 ? value : string.Concat(value.AsSpan(0, 18), "…");

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        // 首帧渲染后把 WPF 侧的主题同步给 WebView，避免两侧配色不一致。
        await ApplyThemeAsync(ThemeService.Current);
        ThemeService.ThemeChanged += OnThemeChanged;
    }

    private async void OnThemeChanged(object? sender, AppTheme theme)
    {
        try
        {
            await InvokeAsync(() => ApplyThemeAsync(theme));
        }
        catch (JSDisconnectedException)
        {
            // WebView 已释放，无需再同步。
        }
    }

    private ValueTask ApplyThemeAsync(AppTheme theme) =>
        Js.InvokeVoidAsync("sdTheme.apply", theme == AppTheme.Dark ? "dark" : "light");

    public void Dispose() => ThemeService.ThemeChanged -= OnThemeChanged;
}
