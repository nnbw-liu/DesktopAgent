@using System.Diagnostics
@using System.IO
@using SDemo.DesktopAgent.Models
@using SDemo.DesktopAgent.Sandbox
@using Microsoft.AspNetCore.Components
@inject IJSRuntime Js
@inject ISettingsService Settings
@inject IAgentChatService Agent
@inject IToolApprovalService Approvals
@inject AgentToolRegistry ToolRegistry
@inject ISandboxJobService Sandbox
@inject SkillCatalog SkillCatalog
@inject PluginRegistry Registry
@inject PluginParameterResolver ParameterResolver
@inject IPluginRunner PluginRunner
@implements IDisposable

@* 聊天室：空会话（欢迎语 + 输入框，垂直居中）与有记录会话（标题 / 消息区 / 输入框）共用本组件 *@
<section class="chat @(IsEmpty ? "chat--empty" : null)">
    @if (IsEmpty)
    {
        <div class="welcome">
            <h1>你好，我是 SDemo DesktopAgent</h1>
            <p>描述你的任务，我会在本地工作区里帮你完成。</p>
        </div>
    }
    else
    {
        <header class="chat-header">
            <h1 class="chat-title">@Session.Title</h1>
        </header>

        <div class="chat-scroll" @ref="_scrollElement">
            <div class="chat-messages">
                @foreach (var message in Session.Messages)
                {
                    var isUser = message.Role == ChatMessageRole.User;

                    <article class="msg @(isUser ? "msg--user" : "msg--assistant")">
                        <span class="msg-role">@RoleLabel(message)</span>

                        @if (!string.IsNullOrWhiteSpace(message.Reasoning))
                        {
                            <div class="msg-reasoning">
                                <button type="button"
                                        class="reasoning-toggle"
                                        @onclick="() => ToggleReasoning(message.Id)">
                                    <span class="reasoning-caret @(IsReasoningOpen(message.Id) ? "is-open" : null)">▸</span>
                                    <span>思考过程 · @message.Reasoning.Length 字</span>
                                </button>

                                @if (IsReasoningOpen(message.Id))
                                {
                                    <pre class="reasoning-body">@message.Reasoning</pre>
                                }
                            </div>
                        }

                        @if (message.Plugin is { Segments.Count: > 0 } messagePlugin)
                        {
                            @* 插件生成的回答：段落结构存在 PluginJson 里，可切换对照 / 纯译文（纯渲染，不发请求）*@
                            <div class="msg-body msg-body--segments">
                                <SegmentedOutput Segments="messagePlugin.Segments!" Mode="@ModeFor(messagePlugin.PluginId)" />
                            </div>
                        }
                        else if (!string.IsNullOrWhiteSpace(message.Content))
                        {
                            <div class="msg-body @(isUser ? null : "msg-body--markdown")">
                                @if (isUser)
                                {
                                    @message.Content
                                }
                                else
                                {
                                    @((MarkupString)MarkdownRenderer.ToHtml(message.Content))
                                }
                            </div>
                        }

                        @if (message.Attachments.Count > 0)
                        {
                            <div class="msg-attachments">
                                @foreach (var attachment in message.Attachments)
                                {
                                    <span class="attachment-chip attachment-chip--static" title="@attachment.FilePath">
                                        <svg class="attachment-icon" viewBox="0 0 16 16" aria-hidden="true">
                                            <path d="M9.9 4.2 5.3 8.8a1.6 1.6 0 0 0 2.3 2.3l4.9-4.9a2.6 2.6 0 0 0-3.7-3.7L3.7 7.6a4 4 0 0 0 5.7 5.7l4-4"
                                                  fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round" />
                                        </svg>
                                        <span class="attachment-name">@attachment.FileName</span>
                                        <span class="attachment-size">@AttachmentStore.FormatSize(attachment.Size)</span>
                                        @if (attachment.PageCount is int pageCount)
                                        {
                                            <span class="attachment-size" title="PDF 页数">@pageCount 页</span>
                                        }
                                    </span>
                                }
                            </div>
                        }

                        <div class="msg-meta">
                            <span class="msg-time">@message.CreatedAt.ToString("HH:mm")</span>

                            @if (!isUser)
                            {
                                @if (message.TotalTokens > 0)
                                {
                                    <span class="msg-stat" title="输入 @message.InputTokens.ToString("N0") / 输出 @message.OutputTokens.ToString("N0")">
                                        @message.TotalTokens.ToString("N0") tokens（输入 @message.InputTokens.ToString("N0")）
                                    </span>
                                }

                                @if (message.ToolCalls.Count > 0)
                                {
                                    <span class="msg-stat" title="@ToolTip(message)">工具 @message.ToolCalls.Values.Sum() 次</span>
                                }

                                @if (message.DurationMs > 0)
                                {
                                    <span class="msg-stat">耗时 @FormatDuration(message.DurationMs)</span>
                                }

                                @if (message.Plugin is { Segments.Count: > 0 } modePlugin)
                                {
                                    <span class="msg-mode" role="group" aria-label="呈现方式">
                                        <button type="button"
                                                class="mode-chip @(ModeFor(modePlugin.PluginId) == PluginOutputMode.Bilingual ? "is-active" : null)"
                                                @onclick="() => SetOutputModeAsync(modePlugin.PluginId, PluginOutputMode.Bilingual)">
                                            对照
                                        </button>
                                        <button type="button"
                                                class="mode-chip @(ModeFor(modePlugin.PluginId) == PluginOutputMode.Translation ? "is-active" : null)"
                                                @onclick="() => SetOutputModeAsync(modePlugin.PluginId, PluginOutputMode.Translation)">
                                            译文
                                        </button>
                                    </span>
                                }

                                @* 插件按钮排在复制之前；无参数点一下直接跑，有参数展开面板 *@
                                <PluginActionBar Entries="BuildMessagePluginActions()"
                                                 Busy="_isGenerating"
                                                 LimitReached="@(message.Derived.Count >= MaxArtifactsPerMessage)"
                                                 RunningMountKey="_runningMountKey"
                                                 OnRun="@(entry => RunArtifactAsync(message, entry))" />
                            }

                            <button type="button"
                                    class="msg-action"
                                    title="@(_copiedMessageId == message.Id ? "已复制" : "复制")"
                                    @onclick="() => CopyMessage(message)"
                                    @onclick:stopPropagation="true">
                                @if (_copiedMessageId == message.Id)
                                {
                                    <svg class="msg-action-icon" viewBox="0 0 16 16" aria-hidden="true">
                                        <path d="M3.2 8.4 6.3 11.4 12.8 4.6" fill="none" stroke="currentColor"
                                              stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
                                    </svg>
                                }
                                else
                                {
                                    <svg class="msg-action-icon" viewBox="0 0 16 16" aria-hidden="true">
                                        <rect x="5.6" y="5.6" width="7.8" height="7.8" rx="1.5" fill="none"
                                              stroke="currentColor" stroke-width="1.2" />
                                        <path d="M10.4 5.6V4.1A1.5 1.5 0 0 0 8.9 2.6H4.1A1.5 1.5 0 0 0 2.6 4.1v4.8a1.5 1.5 0 0 0 1.5 1.5h1.5"
                                              fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" />
                                    </svg>
                                }
                            </button>

                            @if (!isUser)
                            {
                                <button type="button"
                                        class="msg-action"
                                        title="从此消息创建分支"
                                        @onclick="() => OnBranch.InvokeAsync(message)"
                                        @onclick:stopPropagation="true">
                                    <svg class="msg-action-icon" viewBox="0 0 16 16" aria-hidden="true">
                                        <circle cx="4.4" cy="3.4" r="1.5" fill="none" stroke="currentColor" stroke-width="1.2" />
                                        <circle cx="4.4" cy="12.6" r="1.5" fill="none" stroke="currentColor" stroke-width="1.2" />
                                        <circle cx="11.6" cy="6.4" r="1.5" fill="none" stroke="currentColor" stroke-width="1.2" />
                                        <path d="M4.4 4.9v6.2M11.6 7.9c0 2.6-1.9 4.2-4.4 4.4"
                                              fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" />
                                    </svg>
                                </button>
                            }
                        </div>

                        @* 派生卡片：挂在原消息下，不新增对话轮，也不进入后续上下文 *@
                        @if (message.Derived.Count > 0)
                        {
                            <div class="derived-list">
                                @foreach (var artifact in message.Derived.ToList())
                                {
                                    <DerivedCard Artifact="artifact"
                                                 PluginName="@PluginDisplayName(artifact.PluginId)"
                                                 Mode="@ModeFor(artifact.PluginId)"
                                                 SegmentsExpected="@SegmentsExpected(artifact)"
                                                 OnToggleMode="@(mode => SetOutputModeAsync(artifact.PluginId, mode))"
                                                 OnRetry="@(() => RetryArtifactAsync(message, artifact))"
                                                 OnDelete="@(() => DeleteArtifactAsync(message, artifact))" />
                                }
                            </div>
                        }
                    </article>
                }
            </div>
        </div>
    }

    <SandboxChangesPanel SessionId="@Session.Id" />

    <div class="chat-composer-area">
        @if (_pluginNotice is { } notice)
        {
            <p class="plugin-notice">@notice</p>
        }

        <ChatComposer @bind-Text="_draft"
                      SessionId="@Session.Id"
                      IsGenerating="_isGenerating"
                      Skills="_skills"
                      SelectedSkill="@_selectedSkill"
                      OnSelectSkill="SelectSkill"
                      ToolPacks="_toolPacks"
                      OnToggleToolPack="ToggleToolPack"
                      PluginMounts="_composerMounts"
                      PluginById="_composerPlugins"
                      MaxVisiblePlugins="@Registry.MaxFor(PluginSurface.Composer)"
                      ActivePlugin="_activePlugin"
                      ActiveMount="_activeMount"
                      ParameterValues="_parameterValues"
                      OnSelectMount="SelectMount"
                      OnParameterChanged="ChangeParameter"
                      OnSend="HandleSend"
                      OnStop="HandleStop">
            <HeaderContent>
                @* 新聊天室（空会话）才需要归属工作区：放在 Header 里，贴左对齐输入文字 *@
                @if (IsEmpty)
                {
                    <WorkspacePicker Workspaces="Workspaces"
                                     SelectedId="@Session.WorkspaceId"
                                     OnSelect="SelectWorkspace"
                                     OnPick="() => OnPickWorkspace.InvokeAsync()" />
                }
            </HeaderContent>
            <FooterContent>
                @if (_modelOptions.Count > 0)
                {
                    <div class="model-picker">
                        <select class="model-picker-select"
                                title="选择模型"
                                value="@_selectedKey"
                                disabled="@_isGenerating"
                                @onchange="HandleModelChanged">
                            @foreach (var option in _modelOptions)
                            {
                                <option value="@option.Key">@option.Text</option>
                            }
                        </select>
                    </div>
                }
                else
                {
                    <button type="button" class="model-picker-empty" @onclick="() => OnOpenModelSettings.InvokeAsync()">
                        未配置模型 · 去设置
                    </button>
                }
            </FooterContent>
        </ChatComposer>
    </div>

    @* 文件写入 / PowerShell 执行的确认框已移到 AppShell 顶层的 ToolApprovalHost，切换会话不会消失。 *@

    @* 隐私提示：privacy.sendsText 的插件首次使用确认一次 *@
    @if (_privacyPlugin is { } privacyPlugin)
    {
        <div class="modal-backdrop">
            <div class="modal" role="dialog" aria-modal="true">
                <h2 class="modal-title">「@privacyPlugin.Name」会把文本发送给模型服务商</h2>
                <p class="modal-sub">
                    这个插件需要把待处理的文本发给你配置的模型；插件本身只产出文本，不会读写本地文件。
                    确认后不会再提示。
                </p>
                <div class="modal-actions">
                    <button type="button" class="ghost-button" @onclick="CancelPrivacy">取消</button>
                    <button type="button" class="primary-button" @onclick="ContinueAfterPrivacyAsync">继续</button>
                </div>
            </div>
        </div>
    }
</section>

@code {
    /// <summary>每条消息最多挂 5 张派生卡片。</summary>
    private const int MaxArtifactsPerMessage = 5;

    /// <summary>单张卡片的文本上限，超过就截断。</summary>
    private const int MaxArtifactTextChars = 32_000;

    private sealed record ModelOption(string Key, string Text, ModelProvider Provider, string ModelId);

    [Parameter, EditorRequired]
    public ChatSession Session { get; set; } = default!;

    /// <summary>发送：由外层把消息写入会话并落库。</summary>
    [Parameter]
    public EventCallback<ComposerSubmission> OnSend { get; set; }

    /// <summary>会话内容变化（助手消息生成结束 / 失败 / 停止）后回调，由外层持久化。</summary>
    [Parameter]
    public EventCallback<ChatSession> OnSessionChanged { get; set; }

    /// <summary>助手消息上的「分支」：由外层复制会话并打开。</summary>
    [Parameter]
    public EventCallback<ChatMessage> OnBranch { get; set; }

    /// <summary>开始 / 结束生成时通知外层（左侧列表据此显示“推理中”）。</summary>
    [Parameter]
    public EventCallback<(ChatSession Session, bool IsGenerating)> OnGeneratingChanged { get; set; }

    /// <summary>直接跳到设置的「模型设置」分区。</summary>
    [Parameter]
    public EventCallback OnOpenModelSettings { get; set; }

    /// <summary>当前聊天室可选的工作区。</summary>
    [Parameter]
    public IReadOnlyList<Workspace> Workspaces { get; set; } = [];

    /// <summary>切换当前聊天室的工作区。</summary>
    [Parameter]
    public EventCallback<Workspace> OnWorkspaceChanged { get; set; }

    /// <summary>下拉框最底部的「选择工作区」（打开系统文件夹选择框）。</summary>
    [Parameter]
    public EventCallback OnPickWorkspace { get; set; }

    private string _draft = string.Empty;
    private bool _isGenerating;
    private string? _sessionId;
    private ElementReference _scrollElement;

    private List<ModelOption> _modelOptions = [];
    private string? _selectedKey;
    private CancellationTokenSource? _cts;

    /// <summary>常用技能（本地技能库）。</summary>
    private IReadOnlyList<SkillInfo> _skills = [];

    /// <summary>当前选中的技能名（为空表示不套用技能）。</summary>
    private string? _selectedSkill;

    /// <summary>本轮启用的工具包 id（多选；最终仍以 chip 的可用性为准）。</summary>
    private readonly HashSet<string> _enabledToolPacks = new(StringComparer.Ordinal);

    /// <summary>输入框里的工具 chip：注册表描述 + 设置开关 + 沙箱可用性。</summary>
    private IReadOnlyList<ToolPackChip> _toolPacks = [];

    /// <summary>最近一次沙箱可用性（异步探测 + 设置变更后刷新）。</summary>
    private SandboxAvailability? _sandboxAvailability;

    /// <summary>AppContainer 单独的可用性：PDF 解析固定在 AppContainer 里跑，和首选沙箱无关。</summary>
    private SandboxAvailability? _appContainerAvailability;

    private bool _toolPackAvailabilityLoading;

    /// <summary>输入框可用的插件入口（composer 界面、可用且 show）。</summary>
    private IReadOnlyList<PluginMount> _composerMounts = [];

    /// <summary>上面这些入口对应的插件：给 chip 画图标用。</summary>
    private IReadOnlyDictionary<string, PluginDescriptor> _composerPlugins =
        new Dictionary<string, PluginDescriptor>(StringComparer.Ordinal);

    /// <summary>当前选中的插件入口组合键（<c>&lt;pluginId&gt;/&lt;mountId&gt;</c>）。</summary>
    private string? _activeMountKey;

    private PluginDescriptor? _activePlugin;

    private PluginMount? _activeMount;

    /// <summary>本轮参数值（按会话记忆解析；用户改了就写回会话记忆）。</summary>
    private Dictionary<string, string> _parameterValues = new(StringComparer.Ordinal);

    /// <summary>正在运行的派生卡片对应的入口组合键（按钮上显示转圈）。</summary>
    private string? _runningMountKey;

    /// <summary>插件被停用 / 入口被关掉时，输入框上方的一句提示。</summary>
    private string? _pluginNotice;

    /// <summary>待用户确认「文本会发给模型服务商」的插件。</summary>
    private PluginDescriptor? _privacyPlugin;

    /// <summary>确认隐私提示后要继续执行的动作。</summary>
    private Func<Task>? _pendingAfterPrivacy;

    /// <summary>刚刚复制过的消息 Id（用于短暂显示对勾）。</summary>
    private string? _copiedMessageId;

    private bool _disposed;

    /// <summary>展开了思维链的消息 Id。</summary>
    private readonly HashSet<string> _openReasoning = [];

    private bool IsEmpty => Session.Messages.Count == 0;

    protected override void OnInitialized()
    {
        _skills = SkillCatalog.List();
        RefreshPluginMounts();
        RefreshModelOptions();
        RefreshToolPacks();
        Settings.Changed += OnSettingsChanged;
        Registry.Changed += OnRegistryChanged;

        // 沙箱探测可能要启动一次进程：先按“未验证”渲染 chip，后台刷新后再更新。
        _ = RefreshSandboxAvailabilityAsync();
    }

    protected override void OnParametersSet()
    {
        // 切换到另一个聊天室时清空草稿、取消上一轮生成；插件状态按会话恢复（不能一律清空）。
        if (_sessionId != Session.Id)
        {
            _sessionId = Session.Id;
            _draft = string.Empty;
            _selectedSkill = null;
            _enabledToolPacks.Clear();
            _copiedMessageId = null;
            _cts?.Cancel();
            _isGenerating = false;
            ApplyActiveMount(Session.ActiveMountId);
            RefreshToolPacks();
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // 有消息后滚到底部（空态没有消息区，跳过）。
        if (Session.Messages.Count > 0)
        {
            await Js.InvokeVoidAsync("sdChat.scrollToBottom", _scrollElement);
        }
    }

    private void OnSettingsChanged(object? sender, EventArgs args) =>
        _ = InvokeAsync(() =>
        {
            RefreshModelOptions();
            RefreshToolPacks();
            _ = RefreshSandboxAvailabilityAsync();
            StateHasChanged();
        });

    private bool IsReasoningOpen(string messageId) => _openReasoning.Contains(messageId);

    private void ToggleReasoning(string messageId)
    {
        if (!_openReasoning.Remove(messageId))
        {
            _openReasoning.Add(messageId);
        }
    }

    private Task SelectWorkspace(Workspace workspace) => OnWorkspaceChanged.InvokeAsync(workspace);

    private void RefreshModelOptions()
    {
        var options = new List<ModelOption>();

        foreach (var provider in Settings.Current.Providers)
        {
            foreach (var model in provider.Models)
            {
                options.Add(new ModelOption(
                    $"{provider.Id}|{model.Id}",
                    $"{provider.Name} · {model.Name}",
                    provider,
                    model.Id));
            }
        }

        _modelOptions = options;

        if (_selectedKey is not null && options.Any(option => option.Key == _selectedKey))
        {
            return;
        }

        // 优先恢复上次使用的 provider + model，其次用第一个可用模型。
        var remembered = options.FirstOrDefault(option =>
            string.Equals(option.Provider.Id, Settings.Current.LastProviderId, StringComparison.Ordinal) &&
            string.Equals(option.ModelId, Settings.Current.LastModelId, StringComparison.Ordinal));

        _selectedKey = remembered?.Key ?? options.FirstOrDefault()?.Key;
    }

    private void HandleModelChanged(ChangeEventArgs args)
    {
        _selectedKey = args.Value?.ToString();
        RememberSelection();
    }

    /// <summary>选择技能：再次点击同一个则取消。</summary>
    private void SelectSkill(string? name) => _selectedSkill = name;

    /// <summary>开关一个工具包（只有可用时才允许；不可用的 chip 在 UI 上已禁用）。</summary>
    private void ToggleToolPack(string packId)
    {
        var chip = _toolPacks.FirstOrDefault(item => string.Equals(item.Id, packId, StringComparison.Ordinal));
        if (chip is null || !chip.Available)
        {
            return;
        }

        if (!_enabledToolPacks.Remove(packId))
        {
            _enabledToolPacks.Add(packId);
        }

        RefreshToolPacks();
    }

    /// <summary>
    /// 按注册表 + 设置 + 沙箱可用性重建 chip。PowerShell 需要 <c>Available &amp;&amp; Verified</c>：
    /// 只有 cmd 能跑不算可用，否则模型会拿到一个必然失败的工具。
    /// </summary>
    private void RefreshToolPacks()
    {
        var settings = Settings.Current;
        var chips = new List<ToolPackChip>();

        foreach (var descriptor in ToolRegistry.Descriptors)
        {
            var masterEnabled = settings.Tools.IsPackEnabled(descriptor.Id, descriptor.DefaultEnabled);
            string? unavailableReason = null;

            if (!masterEnabled)
            {
                unavailableReason = "在「设置 → 工具设置」中启用";
            }
            else if (descriptor.Id == "powershell")
            {
                if (!settings.Sandbox.Enabled)
                {
                    unavailableReason = "执行沙箱已在设置中关闭";
                }
                else if (_sandboxAvailability is not { Available: true, Verified: true })
                {
                    unavailableReason = _toolPackAvailabilityLoading
                        ? "正在检测沙箱…"
                        : _sandboxAvailability?.Reason ?? "沙箱不可用或未验证";
                }
            }
            else if (descriptor.Id == "pdf")
            {
                // PDF helper 只在 AppContainer 里跑；不要求 PowerShell 的 Verified。
                if (!settings.Sandbox.Enabled)
                {
                    unavailableReason = "执行沙箱已在设置中关闭";
                }
                else if (_appContainerAvailability is not { Available: true })
                {
                    unavailableReason = _toolPackAvailabilityLoading
                        ? "正在检测沙箱…"
                        : _appContainerAvailability?.Reason ?? "AppContainer 沙箱不可用";
                }
            }

            var available = unavailableReason is null;

            chips.Add(new ToolPackChip(
                descriptor.Id,
                descriptor.Name,
                descriptor.Description,
                descriptor.Glyph,
                available && _enabledToolPacks.Contains(descriptor.Id),
                available,
                unavailableReason));
        }

        _toolPacks = chips;

        // 包在设置里被关掉 / 沙箱失效时，把本轮的选择也清掉，避免继续传给模型。
        _enabledToolPacks.RemoveWhere(id => chips.FirstOrDefault(chip => chip.Id == id) is not { Available: true });
    }

    private async Task RefreshSandboxAvailabilityAsync()
    {
        if (_disposed)
        {
            return;
        }

        _toolPackAvailabilityLoading = true;

        try
        {
            // 两个查询分开：PowerShell 看策略选出的沙箱，PDF 固定看 AppContainer。
            _sandboxAvailability = await Sandbox.GetAvailabilityAsync();
            _appContainerAvailability = await Sandbox.GetAvailabilityAsync(SandboxKind.AppContainer);
        }
        catch (Exception ex) when (ex is IOException or InvalidOperationException or SystemException)
        {
            var failure = new SandboxAvailability(
                SandboxKind.None,
                Available: false,
                Verified: false,
                $"沙箱状态检测失败：{ex.Message}",
                Detail: null);
            _sandboxAvailability = failure;
            _appContainerAvailability = failure;
        }
        finally
        {
            _toolPackAvailabilityLoading = false;
        }

        await InvokeAsync(() =>
        {
            RefreshToolPacks();
            StateHasChanged();
        });
    }

    /// <summary>刷新输入框可用的插件入口（启动、重新扫描 / 设置改动后调用）。</summary>
    private void RefreshPluginMounts()
    {
        _composerMounts = Registry.Mounts(PluginSurface.Composer);
        _composerPlugins = _composerMounts
            .Select(mount => mount.PluginId)
            .Distinct(StringComparer.Ordinal)
            .Select(id => Registry.Find(id))
            .OfType<PluginDescriptor>()
            .ToDictionary(plugin => plugin.Id, StringComparer.Ordinal);
    }

    /// <summary>
    /// 按组合键恢复插件选择。插件被停用 / 删除 / 入口被关掉时退回全局模式并提示一句，
    /// 但 <see cref="ChatSession.ActiveMountId"/> 原样保留——重新启用后仍能恢复。
    /// </summary>
    private void ApplyActiveMount(string? mountKey)
    {
        _activeMountKey = mountKey;

        var mount = string.IsNullOrWhiteSpace(mountKey) ? null : Registry.FindMount(mountKey);

        if (mount?.Capability is not { } capability)
        {
            _activeMount = null;
            _activePlugin = null;
            _parameterValues = new Dictionary<string, string>(StringComparer.Ordinal);

            if (!string.IsNullOrWhiteSpace(mountKey))
            {
                var pluginId = mountKey.Split('/')[0];
                _pluginNotice = $"插件「{Registry.DisplayName(pluginId)}」当前不可用（已停用或被删除），已回到普通对话。";
            }
            else
            {
                _pluginNotice = null;
            }

            return;
        }

        _pluginNotice = null;
        _activeMount = mount;
        _activePlugin = Registry.Find(mount.PluginId);
        _parameterValues = new Dictionary<string, string>(
            ParameterResolver.Resolve(capability, mount.PluginId, mount.Id, MemoryForResolve()),
            StringComparer.Ordinal);
    }

    /// <summary>设置里关掉「记住参数值」时，解析不再读会话记忆（也不会再写）。</summary>
    private IReadOnlyDictionary<string, string> MemoryForResolve() =>
        Registry.Preferences.RememberParameterValues
            ? Session.PluginMemory
            : new Dictionary<string, string>(StringComparer.Ordinal);

    /// <summary>选中 / 取消插件入口（生成中禁止切换，避免半途换 prompt）。</summary>
    private async Task SelectMount(string? mountKey)
    {
        if (_isGenerating)
        {
            return;
        }

        _pluginNotice = null;
        Session.ActiveMountId = mountKey;
        ApplyActiveMount(mountKey);
        StateHasChanged();
        await PersistSelectionAsync();
    }

    /// <summary>参数变化：写回内存值 + 会话记忆（重开聊天室仍记得上次选的语言）。</summary>
    private async Task ChangeParameter((string Key, string Value) change)
    {
        if (_activeMount is null)
        {
            return;
        }

        _parameterValues[change.Key] = change.Value;

        // 设置里关掉「记住参数值」时只影响本次，不写会话记忆。
        if (Registry.Preferences.RememberParameterValues)
        {
            Session.PluginMemory[
                PluginParameterResolver.MemoryKey(_activeMount.PluginId, _activeMount.Id, change.Key)] = change.Value;
        }

        StateHasChanged();
        await PersistSelectionAsync();
    }

    /// <summary>空会话还没落库：选择先留在内存，等首条消息保存时一起写。</summary>
    private Task PersistSelectionAsync() =>
        Session.Messages.Count > 0 ? NotifySessionChangedAsync() : Task.CompletedTask;

    /// <summary>目录重新扫描、或用户在设置里改了开关 / 上限 / 顺序。</summary>
    private void OnRegistryChanged(object? sender, EventArgs e) =>
        _ = InvokeAsync(() =>
        {
            RefreshPluginMounts();

            // 正在用的插件被停用 / 入口被关掉时，ApplyActiveMount 会回退到全局模式并给出提示。
            ApplyActiveMount(Session.ActiveMountId);
            StateHasChanged();
        });

    /// <summary>助手消息的角色名：插件生成显示「翻译 · SDemo」，普通回答仍是 SDemo。</summary>
    private string RoleLabel(ChatMessage message)
    {
        if (message.Plugin is not { } info)
        {
            return message.Role == ChatMessageRole.User ? "你" : "SDemo";
        }

        var name = Registry.DisplayName(info.PluginId);
        return string.IsNullOrWhiteSpace(name) ? $"{info.PluginId} · SDemo" : $"{name} · SDemo";
    }

    /// <summary>复制消息纯文本到剪贴板，短暂显示对勾。</summary>
    private async Task CopyMessage(ChatMessage message)
    {
        if (string.IsNullOrEmpty(message.Content))
        {
            return;
        }

        try
        {
            await Js.InvokeVoidAsync("sdChat.copyText", message.Content);
        }
        catch (JSException)
        {
            // 剪贴板不可用时仍然给出复制成功的视觉反馈没有意义，直接返回。
            return;
        }

        _copiedMessageId = message.Id;
        StateHasChanged();

        await Task.Delay(1500);

        if (_disposed || _copiedMessageId != message.Id)
        {
            return;
        }

        _copiedMessageId = null;
        StateHasChanged();
    }

    /// <summary>工具调用明细（hover 时显示）。</summary>
    private static string ToolTip(ChatMessage message)
    {
        var lines = new List<string>
        {
            $"共调用 {message.ToolCalls.Values.Sum()} 次"
        };

        lines.AddRange(message.ToolCalls
            .OrderByDescending(pair => pair.Value)
            .ThenBy(pair => pair.Key, StringComparer.OrdinalIgnoreCase)
            .Select(pair => $"{pair.Key} × {pair.Value}"));

        return string.Join('\n', lines);
    }

    private static string FormatDuration(long milliseconds) =>
        milliseconds < 1000 ? $"{milliseconds} ms" : $"{milliseconds / 1000.0:0.0} s";

    private Task SetGeneratingAsync(bool isGenerating) =>
        OnGeneratingChanged.HasDelegate
            ? OnGeneratingChanged.InvokeAsync((Session, isGenerating))
            : Task.CompletedTask;

    /// <summary>把当前选择写进设置，下次启动直接选中。</summary>
    private void RememberSelection()
    {
        var option = _modelOptions.FirstOrDefault(item => item.Key == _selectedKey);
        if (option is null)
        {
            return;
        }

        if (string.Equals(Settings.Current.LastProviderId, option.Provider.Id, StringComparison.Ordinal) &&
            string.Equals(Settings.Current.LastModelId, option.ModelId, StringComparison.Ordinal))
        {
            return;
        }

        Settings.Current.LastProviderId = option.Provider.Id;
        Settings.Current.LastModelId = option.ModelId;
        Settings.Save();
    }

    private async Task HandleSend(ComposerSubmission submission)
    {
        if (_isGenerating)
        {
            return;
        }

        if (string.IsNullOrWhiteSpace(submission.Text) && submission.Attachments.Count == 0)
        {
            return;
        }

        var mount = _activeMount;

        // 插件只吃文本：只带了附件时明确提示，不产生空的 Run。
        if (mount is not null && string.IsNullOrWhiteSpace(submission.Text))
        {
            Session.Messages.Add(new ChatMessage(
                ChatMessageRole.Assistant,
                "插件模式需要输入文本；附件不会传给插件。"));
            await NotifySessionChangedAsync();
            return;
        }

        await OnSend.InvokeAsync(submission);
        _draft = string.Empty;
        RememberSelection();

        var option = _modelOptions.FirstOrDefault(item => item.Key == _selectedKey);
        if (option is null)
        {
            Session.Messages.Add(new ChatMessage(
                ChatMessageRole.Assistant,
                "还没有可用的模型。请到「设置 → 模型设置」添加模型提供商，并把模型加入目录。"));
            await NotifySessionChangedAsync();
            return;
        }

        // 插件模式下发送 = 插件 Run，不是普通对话。
        if (mount is not null)
        {
            var plugin = _activePlugin ?? Registry.Find(mount.PluginId);

            // privacy.sendsText 的插件首次使用先确认一次（只提示一次，记在设置里）。
            if (NeedsPrivacyPrompt(plugin))
            {
                _privacyPlugin = plugin;
                _pendingAfterPrivacy = () => GenerateWithPluginAsync(option, mount, submission.Text);
                StateHasChanged();
                return;
            }

            await GenerateWithPluginAsync(option, mount, submission.Text);
        }
        else
        {
            await GenerateAsync(option);
        }
    }

    /// <summary>这个插件的文本会发给模型服务商，且用户还没确认过。</summary>
    private bool NeedsPrivacyPrompt(PluginDescriptor? plugin) =>
        plugin is not null
        && plugin.Capabilities.Any(capability => capability.SendsText)
        && !Settings.Current.Plugins.PrivacyAcknowledged.Contains(plugin.Id, StringComparer.Ordinal);

    /// <summary>确认隐私提示：记住这个插件已确认，然后继续被打断的动作。</summary>
    private async Task ContinueAfterPrivacyAsync()
    {
        var plugin = _privacyPlugin;
        var action = _pendingAfterPrivacy;

        _privacyPlugin = null;
        _pendingAfterPrivacy = null;

        if (plugin is not null
            && !Settings.Current.Plugins.PrivacyAcknowledged.Contains(plugin.Id, StringComparer.Ordinal))
        {
            Settings.Current.Plugins.PrivacyAcknowledged.Add(plugin.Id);
            Settings.Save();
        }

        StateHasChanged();

        if (action is not null)
        {
            await action();
        }
    }

    private void CancelPrivacy()
    {
        _privacyPlugin = null;
        _pendingAfterPrivacy = null;
    }

    /// <summary>用 Agent Framework 流式生成回复，边生成边写入会话。</summary>
    private async Task GenerateAsync(ModelOption option)
    {
        _isGenerating = true;
        await SetGeneratingAsync(true);

        using var cts = new CancellationTokenSource();
        _cts = cts;

        var history = Session.Messages.ToList();
        var reply = new ChatMessage(ChatMessageRole.Assistant, string.Empty)
        {
            CreatedAt = DateTime.Now
        };

        // 普通推理开始：清空 LastPluginId，侧栏图标回到默认。
        Session.LastPluginId = null;

        Session.Messages.Add(reply);
        _openReasoning.Add(reply.Id);
        StateHasChanged();

        // 工具是多选的：把所有勾选的工具包一起传给模型。
        var enabledPacks = new HashSet<string>(_enabledToolPacks, StringComparer.Ordinal);
        var metrics = new AgentRunMetrics();
        var startedAt = Stopwatch.GetTimestamp();

        try
        {
            await ConsumeAsync(
                reply,
                Agent.StreamAsync(
                    option.Provider,
                    option.ModelId,
                    history,
                    enabledPacks,
                    Session.Id,
                    _selectedSkill,
                    metrics,
                    cts.Token));
        }
        finally
        {
            ApplyMetrics(reply, metrics, startedAt);
            _isGenerating = false;
            _cts = null;
            await SetGeneratingAsync(false);
            StateHasChanged();
            await NotifySessionChangedAsync();
        }
    }

    /// <summary>插件 Run：单轮、默认无历史、无全局技能；产物是一条带 Plugin 归属的普通助手消息。</summary>
    private async Task GenerateWithPluginAsync(ModelOption option, PluginMount mount, string text)
    {
        if (mount.Capability is not { } capability)
        {
            return;
        }

        var plugin = _activePlugin ?? Registry.Find(mount.PluginId);
        if (plugin is null || !plugin.IsUsable)
        {
            Session.Messages.Add(new ChatMessage(
                ChatMessageRole.Assistant,
                "这个插件当前不可用（可能被删除、禁用，或能力加载失败），请重新扫描或换一个插件。"));
            await NotifySessionChangedAsync();
            return;
        }

        _isGenerating = true;
        await SetGeneratingAsync(true);

        using var cts = new CancellationTokenSource();
        _cts = cts;

        var values = new Dictionary<string, string>(_parameterValues, StringComparer.Ordinal);
        var metrics = new AgentRunMetrics();
        var startedAt = Stopwatch.GetTimestamp();

        var reply = new ChatMessage(ChatMessageRole.Assistant, string.Empty)
        {
            CreatedAt = DateTime.Now,
            // 参数快照随消息落库：重开还能看到当时用的是什么语言。
            Plugin = new PluginMessageInfo(plugin.Id, mount.Id, capability.Id, values, null)
        };

        Session.Messages.Add(reply);
        Session.LastPluginId = plugin.Id;
        _openReasoning.Add(reply.Id);
        StateHasChanged();

        try
        {
            var request = new PluginRunRequest(
                plugin,
                mount,
                values,
                text,
                option.Provider,
                option.ModelId,
                metrics);

            await ConsumePluginAsync(reply, capability, PluginRunner.RunComposerAsync(request, cts.Token));
        }
        finally
        {
            ApplyMetrics(reply, metrics, startedAt);
            _isGenerating = false;
            _cts = null;
            await SetGeneratingAsync(false);
            StateHasChanged();
            await NotifySessionChangedAsync();
        }
    }

    /// <summary>
    /// 插件 Run 的流式收尾：<c>output = segments</c> 的能力边收边解析成段落，其余能力按纯文本累积。
    /// </summary>
    private async Task ConsumePluginAsync(
        ChatMessage reply,
        PluginCapability capability,
        IAsyncEnumerable<AgentDelta> stream)
    {
        var accumulator = capability.OutputFormat == PluginOutputFormat.Segments
            ? new SegmentedOutputAccumulator(MaxArtifactTextChars)
            : null;

        try
        {
            await foreach (var delta in stream)
            {
                if (delta.Text.Length > 0)
                {
                    if (accumulator is null)
                    {
                        reply.Content += delta.Text;
                    }
                    else
                    {
                        accumulator.Append(delta.Text);
                        ApplySegments(reply, accumulator.Parse());
                    }
                }

                if (delta.Reasoning.Length > 0)
                {
                    reply.Reasoning += delta.Reasoning;
                }

                StateHasChanged();
            }

            if (accumulator is not null)
            {
                ApplySegments(reply, accumulator.Parse(final: true));
            }

            if (accumulator is { Truncated: true })
            {
                AppendTruncationNote(reply);
            }
        }
        catch (OperationCanceledException)
        {
            // 用户点了停止：把已经解析出的段落收尾，保留部分结果。
            if (accumulator is not null)
            {
                ApplySegments(reply, accumulator.Parse(final: true));
            }
        }
        catch (Exception ex)
        {
            if (accumulator is not null)
            {
                ApplySegments(reply, accumulator.Parse(final: true));
            }

            var message = $"调用失败：{ex.Message}";

            if (reply.Plugin?.Segments is { Count: > 0 } segments)
            {
                // 有段落结构时把错误单独加成一段，两种呈现方式下都能看到。
                reply.Plugin = reply.Plugin with
                {
                    Segments = [.. segments, new OutputSegment(string.Empty, message)]
                };
                reply.Content = string.IsNullOrWhiteSpace(reply.Content)
                    ? message
                    : reply.Content + "\n\n" + message;
            }
            else
            {
                var prefix = string.IsNullOrWhiteSpace(reply.Content) ? string.Empty : "\n\n";
                reply.Content += $"{prefix}{message}";
            }
        }
    }

    /// <summary>把解析结果写回消息：正文用纯译文，段落结构随 PluginJson 落库。</summary>
    private static void ApplySegments(ChatMessage reply, SegmentedParseResult parsed)
    {
        reply.Content = parsed.Text;

        if (reply.Plugin is { } info)
        {
            reply.Plugin = info with
            {
                Segments = parsed.Segments.Count > 0 ? parsed.Segments : null
            };
        }
    }

    private static void AppendTruncationNote(ChatMessage reply)
    {
        const string note = "\n\n…（结果过长，已截断）";
        reply.Content += note;

        if (reply.Plugin?.Segments is { Count: > 0 } segments)
        {
            var last = segments[^1];
            reply.Plugin = reply.Plugin with
            {
                Segments = [.. segments.Take(segments.Count - 1), last with { Target = last.Target + note }]
            };
        }
    }

    /// <summary>普通对话的流式累积：正文原样追加，出错追加可读提示。</summary>
    private async Task ConsumeAsync(ChatMessage reply, IAsyncEnumerable<AgentDelta> stream)
    {
        try
        {
            await foreach (var delta in stream)
            {
                if (delta.Text.Length > 0)
                {
                    reply.Content += delta.Text;
                }

                if (delta.Reasoning.Length > 0)
                {
                    reply.Reasoning += delta.Reasoning;
                }

                StateHasChanged();
            }
        }
        catch (OperationCanceledException)
        {
            // 用户点了停止。
        }
        catch (Exception ex)
        {
            var prefix = string.IsNullOrWhiteSpace(reply.Content) ? string.Empty : "\n\n";
            reply.Content += $"{prefix}调用失败：{ex.Message}";
        }
    }

    private static void ApplyMetrics(ChatMessage reply, AgentRunMetrics metrics, long startedAt)
    {
        reply.DurationMs = (long)Stopwatch.GetElapsedTime(startedAt).TotalMilliseconds;
        reply.InputTokens = metrics.InputTokens;
        reply.OutputTokens = metrics.OutputTokens;

        foreach (var pair in metrics.ToolCalls)
        {
            reply.ToolCalls[pair.Key] = pair.Value;
        }
    }

    /// <summary>通知外层把最新会话写回 SQLite（取消 / 出错时也保存已生成的部分）。</summary>
    private Task NotifySessionChangedAsync() =>
        OnSessionChanged.HasDelegate ? OnSessionChanged.InvokeAsync(Session) : Task.CompletedTask;

    /// <summary>用户点停止：终止生成，并拒绝所有排队中的审批（包括沙箱执行）。</summary>
    private void HandleStop()
    {
        _cts?.Cancel();
        Approvals.CancelAll();
    }

    /// <summary>气泡上可用的插件入口（message 界面、已被用户启用），参数按会话记忆解析。</summary>
    private IReadOnlyList<PluginActionEntry> BuildMessagePluginActions()
    {
        var entries = new List<PluginActionEntry>();

        foreach (var mount in Registry.Mounts(PluginSurface.Message))
        {
            var plugin = Registry.Find(mount.PluginId);
            if (plugin is null || mount.Capability is not { } capability)
            {
                continue;
            }

            entries.Add(new PluginActionEntry(
                plugin,
                mount,
                ParameterResolver.Resolve(capability, plugin.Id, mount.Id, MemoryForResolve())));
        }

        return entries;
    }

    private string PluginDisplayName(string pluginId) => Registry.DisplayName(pluginId);

    /// <summary>气泡按钮触发：新建一张派生卡片并开始流式加工（原文 = 该条消息的正文）。</summary>
    private async Task RunArtifactAsync(ChatMessage message, PluginActionEntry entry)
    {
        if (NeedsPrivacyPrompt(entry.Plugin))
        {
            _privacyPlugin = entry.Plugin;
            _pendingAfterPrivacy = () => RunArtifactCoreAsync(message, entry);
            StateHasChanged();
            return;
        }

        await RunArtifactCoreAsync(message, entry);
    }

    private async Task RunArtifactCoreAsync(ChatMessage message, PluginActionEntry entry)
    {
        // 单飞：同一会话同一时间只允许一个 Run。
        if (_isGenerating || message.Derived.Count >= MaxArtifactsPerMessage)
        {
            return;
        }

        var option = _modelOptions.FirstOrDefault(item => item.Key == _selectedKey);
        if (option is null)
        {
            message.Derived.Add(new DerivedArtifact(
                Guid.NewGuid().ToString("N"),
                entry.Plugin.Id,
                entry.Mount.Id,
                entry.Mount.CapabilityId,
                entry.Values,
                null,
                string.Empty,
                DerivedState.Failed,
                "未配置模型：请先到「设置 → 模型设置」添加模型",
                string.Empty,
                0,
                0,
                0,
                DateTime.Now));

            StateHasChanged();
            await NotifySessionChangedAsync();
            return;
        }

        // 气泡 Run 也写会话记忆：下次再点同一个插件，语言还是上次选的。
        RememberArtifactValues(entry);

        message.Derived.Add(new DerivedArtifact(
            Guid.NewGuid().ToString("N"),
            entry.Plugin.Id,
            entry.Mount.Id,
            entry.Mount.CapabilityId,
            entry.Values,
            null,
            string.Empty,
            DerivedState.Running,
            null,
            option.ModelId,
            0,
            0,
            0,
            DateTime.Now));

        await ExecuteArtifactAsync(message, message.Derived.Count - 1, entry, option);
    }

    /// <summary>重试：沿用同一插件 / 参数，把卡片重置成 Running 再跑一次。</summary>
    private async Task RetryArtifactAsync(ChatMessage message, DerivedArtifact artifact)
    {
        if (_isGenerating)
        {
            return;
        }

        var index = message.Derived.FindIndex(item => string.Equals(item.Id, artifact.Id, StringComparison.Ordinal));
        if (index < 0)
        {
            return;
        }

        var plugin = Registry.Find(artifact.PluginId);

        // 重试是对已有卡片本身的动作：只要插件还启用就允许，不要求「气泡」开关还开着
        // （关掉气泡只是不再显示新按钮，不该让旧卡片点重试就报「不可用」）。
        var mount = plugin?.Mounts.FirstOrDefault(item =>
            item.IsUsable && string.Equals(item.Id, artifact.MountId, StringComparison.Ordinal));

        if (plugin is null || mount?.Capability is null)
        {
            message.Derived[index] = artifact with { State = DerivedState.Failed, Error = "插件已被删除或不再可用" };
            StateHasChanged();
            await NotifySessionChangedAsync();
            return;
        }

        var option = _modelOptions.FirstOrDefault(item => item.Key == _selectedKey);
        if (option is null)
        {
            message.Derived[index] = artifact with { State = DerivedState.Failed, Error = "未配置模型：请先到「设置 → 模型设置」添加模型" };
            StateHasChanged();
            await NotifySessionChangedAsync();
            return;
        }

        message.Derived[index] = artifact with
        {
            State = DerivedState.Running,
            Error = null,
            Text = string.Empty,
            DurationMs = 0,
            InputTokens = 0,
            OutputTokens = 0,
            ModelId = option.ModelId
        };

        await ExecuteArtifactAsync(message, index, new PluginActionEntry(plugin, mount, artifact.Values), option);
    }

    /// <summary>跑一次派生卡片：流式写入 Text，收尾时写状态与指标。</summary>
    private async Task ExecuteArtifactAsync(
        ChatMessage message,
        int index,
        PluginActionEntry entry,
        ModelOption option)
    {
        _isGenerating = true;
        _runningMountKey = entry.Mount.Key;

        // 插件 Run 开始：会话图标跟随这个插件。
        Session.LastPluginId = entry.Plugin.Id;
        await SetGeneratingAsync(true);

        using var cts = new CancellationTokenSource();
        _cts = cts;

        var metrics = new AgentRunMetrics();
        var startedAt = Stopwatch.GetTimestamp();
        StateHasChanged();

        var capability = entry.Mount.Capability;
        var accumulator = capability?.OutputFormat == PluginOutputFormat.Segments
            ? new SegmentedOutputAccumulator(MaxArtifactTextChars)
            : null;

        try
        {
            var request = new PluginRunRequest(
                entry.Plugin,
                entry.Mount,
                entry.Values,
                message.Content,
                option.Provider,
                option.ModelId,
                metrics);

            await foreach (var delta in PluginRunner.RunArtifactAsync(request, cts.Token))
            {
                if (delta.Text.Length == 0)
                {
                    continue;
                }

                var current = message.Derived[index];

                if (accumulator is not null)
                {
                    accumulator.Append(delta.Text);
                    var parsed = accumulator.Parse();
                    message.Derived[index] = current with
                    {
                        Text = parsed.Text,
                        Segments = parsed.Segments.Count > 0 ? parsed.Segments : null
                    };
                }
                else
                {
                    var text = current.Text + delta.Text;
                    if (text.Length > MaxArtifactTextChars)
                    {
                        text = string.Concat(text.AsSpan(0, MaxArtifactTextChars), "\n\n…（结果过长，已截断）");
                    }

                    message.Derived[index] = current with { Text = text };
                }

                StateHasChanged();
            }

            if (accumulator is not null)
            {
                FinalizeArtifactSegments(message, index, accumulator);
            }

            if (accumulator is { Truncated: true })
            {
                AppendArtifactTruncationNote(message, index);
            }

            message.Derived[index] = message.Derived[index] with { State = DerivedState.Done };
        }
        catch (OperationCanceledException)
        {
            if (accumulator is not null)
            {
                FinalizeArtifactSegments(message, index, accumulator);
            }

            message.Derived[index] = message.Derived[index] with { State = DerivedState.Canceled };
        }
        catch (Exception ex)
        {
            if (accumulator is not null)
            {
                FinalizeArtifactSegments(message, index, accumulator);
            }

            message.Derived[index] = message.Derived[index] with { State = DerivedState.Failed, Error = ex.Message };
        }
        finally
        {
            message.Derived[index] = message.Derived[index] with
            {
                DurationMs = (long)Stopwatch.GetElapsedTime(startedAt).TotalMilliseconds,
                InputTokens = metrics.InputTokens,
                OutputTokens = metrics.OutputTokens
            };

            _isGenerating = false;
            _runningMountKey = null;
            _cts = null;
            await SetGeneratingAsync(false);
            StateHasChanged();
            await NotifySessionChangedAsync();
        }
    }

    private static void FinalizeArtifactSegments(
        ChatMessage message,
        int index,
        SegmentedOutputAccumulator accumulator)
    {
        var parsed = accumulator.Parse(final: true);
        var current = message.Derived[index];
        message.Derived[index] = current with
        {
            Text = parsed.Text,
            Segments = parsed.Segments.Count > 0 ? parsed.Segments : null
        };
    }

    private static void AppendArtifactTruncationNote(ChatMessage message, int index)
    {
        const string note = "\n\n…（结果过长，已截断）";
        var current = message.Derived[index];
        var segments = current.Segments;

        if (segments is { Count: > 0 })
        {
            var last = segments[^1];
            segments = [.. segments.Take(segments.Count - 1), last with { Target = last.Target + note }];
        }

        message.Derived[index] = current with
        {
            Text = current.Text + note,
            Segments = segments
        };
    }

    private async Task DeleteArtifactAsync(ChatMessage message, DerivedArtifact artifact)
    {
        if (artifact.IsRunning)
        {
            return;
        }

        var index = message.Derived.FindIndex(item => string.Equals(item.Id, artifact.Id, StringComparison.Ordinal));
        if (index < 0)
        {
            return;
        }

        message.Derived.RemoveAt(index);
        StateHasChanged();
        await NotifySessionChangedAsync();
    }

    private void RememberArtifactValues(PluginActionEntry entry)
    {
        // 设置里关掉「记住参数值」时不写会话记忆。
        if (!Registry.Preferences.RememberParameterValues)
        {
            return;
        }

        foreach (var pair in entry.Values)
        {
            Session.PluginMemory[PluginParameterResolver.MemoryKey(entry.Plugin.Id, entry.Mount.Id, pair.Key)] = pair.Value;
        }
    }

    /// <summary>呈现方式（对照 / 纯译文）的记忆键：按插件记，三个入口共用。</summary>
    private static string ModeMemoryKey(string pluginId) =>
        $"{pluginId}/{PluginParameterResolver.OutputModeKey}";

    /// <summary>当前呈现方式：会话记忆优先，没有就用设置里的新会话默认值。</summary>
    private PluginOutputMode ModeFor(string pluginId)
    {
        if (Session.PluginMemory.TryGetValue(ModeMemoryKey(pluginId), out var value))
        {
            return string.Equals(value, "translation", StringComparison.OrdinalIgnoreCase)
                ? PluginOutputMode.Translation
                : PluginOutputMode.Bilingual;
        }

        return Registry.Preferences.DefaultOutputMode;
    }

    /// <summary>切换呈现方式：纯渲染，不重新请求模型；状态按会话记忆。</summary>
    private async Task SetOutputModeAsync(string pluginId, PluginOutputMode mode)
    {
        Session.PluginMemory[ModeMemoryKey(pluginId)] =
            mode == PluginOutputMode.Translation ? "translation" : "bilingual";

        StateHasChanged();
        await PersistSelectionAsync();
    }

    /// <summary>这个产物本来是不是要按段落返回（用来区分「纯文本能力」与「模型没按格式返回」）。</summary>
    private bool SegmentsExpected(DerivedArtifact artifact) =>
        Registry.Find(artifact.PluginId)?.FindCapability(artifact.CapabilityId)?.OutputFormat
        == PluginOutputFormat.Segments;

    public void Dispose()
    {
        _disposed = true;
        Settings.Changed -= OnSettingsChanged;
        Registry.Changed -= OnRegistryChanged;

        // 审批宿主在 AppShell 顶层，切换会话时不该取消别的会话正在等待的请求；
        // 只有本组件自己的生成被取消时，cancellationToken 会让对应请求按拒绝结束。
    }
}
