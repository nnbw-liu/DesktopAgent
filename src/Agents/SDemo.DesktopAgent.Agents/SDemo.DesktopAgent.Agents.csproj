<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- AI 接入层：Microsoft Agent Framework + OpenAI 兼容协议的唯一出入口。
         其它工程不允许直接引用 MAF / OpenAI SDK。 -->
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>SDemo.DesktopAgent</RootNamespace>
    <AssemblyName>SDemo.DesktopAgent.Agents</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.12" />
    <!-- Agent 运行时：Microsoft Agent Framework（OpenAI 兼容 provider） -->
    <PackageReference Include="Microsoft.Agents.AI" Version="1.25.0" />
    <PackageReference Include="Microsoft.Agents.AI.OpenAI" Version="1.25.0" />
    <!-- 只用到 IChatClient / AITool / ChatMessage 这些中立抽象 -->
    <PackageReference Include="Microsoft.Extensions.AI" Version="10.10.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Contracts\SDemo.DesktopAgent.Contracts\SDemo.DesktopAgent.Contracts.csproj" />
    <!-- P2b：摘要请求要复用「会话提示词 + 工具声明」这条热前缀，而这两个类型
         （SummaryChatRequest / ISummaryChatTransport）随 AI 抽象一起落在上下文引擎里
         （契约层按架构约定不许引用 AI SDK）。方向仍是上层 → 上下文引擎，无环。 -->
    <ProjectReference Include="..\..\Context\SDemo.DesktopAgent.Context\SDemo.DesktopAgent.Context.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="SDemo.DesktopAgent.Core.Tests" />
  </ItemGroup>

</Project>
