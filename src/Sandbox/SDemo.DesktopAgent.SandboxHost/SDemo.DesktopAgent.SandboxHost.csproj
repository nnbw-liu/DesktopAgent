<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- 沙箱内的 console helper。只引用契约，不引用 Core，保持自包含发布的体积最小。 -->
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <OutputType>Exe</OutputType>
    <RootNamespace>SDemo.DesktopAgent.SandboxHost</RootNamespace>
    <AssemblyName>SDemo.DesktopAgent.SandboxHost</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Contracts\SDemo.DesktopAgent.Sandbox.Contracts\SDemo.DesktopAgent.Sandbox.Contracts.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- PDF 解析只在沙箱内的 helper 进程里跑：解析器漏洞 / 崩溃不牵涉主进程。
         版本锁定，不用浮动版本。 -->
    <PackageReference Include="PdfPig" Version="0.1.16" />
  </ItemGroup>

</Project>
