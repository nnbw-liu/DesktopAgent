<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- 深色主题：与 wwwroot/css/app.css 中的深色变量保持一致 -->
    <SolidColorBrush x:Key="AppBackgroundBrush" Color="#0B0D12" />
    <SolidColorBrush x:Key="TitleBarBackgroundBrush" Color="#0B0D12" />
    <SolidColorBrush x:Key="TitleBarForegroundBrush" Color="#6E7787" />
    <SolidColorBrush x:Key="WindowBorderBrush" Color="#1B202A" />
    <SolidColorBrush x:Key="ChromeBorderBrush" Color="#1B202A" />
    <SolidColorBrush x:Key="CaptionButtonForegroundBrush" Color="#AEB7C6" />
    <SolidColorBrush x:Key="CaptionButtonHoverBrush" Color="#1A1F29" />
    <SolidColorBrush x:Key="CloseButtonHoverBrush" Color="#C42B1C" />
    <SolidColorBrush x:Key="StatusBarBackgroundBrush" Color="#0B0D12" />
    <SolidColorBrush x:Key="StatusBarForegroundBrush" Color="#8A93A5" />
    <SolidColorBrush x:Key="StatusBarMutedBrush" Color="#5B6477" />
    <SolidColorBrush x:Key="StatusAccentBrush" Color="#35C88A" />

</ResourceDictionary>
