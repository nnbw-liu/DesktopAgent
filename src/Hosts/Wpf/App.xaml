<Application x:Class="SDemo.DesktopAgent.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- 主题色画笔（Themes/Dark.xaml 或 Themes/Light.xaml）在启动时由 ThemeResources 插入 -->
                <ResourceDictionary Source="Themes/Chrome.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
