<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <!-- 目标框架：Windows 默认带上；Android 是「按需」目标。
         Android 目标要求本机同时具备 maui-android workload + JDK 17 + Android SDK，
         而 restore 会对 TargetFrameworks 里的每个 TFM 做 workload 校验——
         只要列表里有 net10.0-android，VS 的 F5 / 还原就会因为缺 Android SDK 而失败，
         哪怕当前调试的是 Windows。
         需要构建 Android 时显式打开：
           dotnet build src/SDemo.DesktopAgent.Maui -p:EnableAndroidTarget=true
         或设环境变量 SDEMO_ANDROID=1（VS 里也能读到用户级环境变量）。 -->
    <EnableAndroidTarget Condition="'$(EnableAndroidTarget)' == '' and '$(SDEMO_ANDROID)' == '1'">true</EnableAndroidTarget>
    <TargetFrameworks>net10.0-windows10.0.19041.0</TargetFrameworks>
    <TargetFrameworks Condition="'$(EnableAndroidTarget)' == 'true'">$(TargetFrameworks);net10.0-android</TargetFrameworks>
    <OutputType>Exe</OutputType>
    <RootNamespace>SDemo.DesktopAgent.Maui</RootNamespace>
    <AssemblyName>SDemo.DesktopAgent.Maui</AssemblyName>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>

    <ApplicationTitle>SDemo DesktopAgent</ApplicationTitle>
    <ApplicationId>com.sdemo.desktopagent</ApplicationId>
    <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
    <ApplicationVersion>1</ApplicationVersion>

    <!-- 免安装 exe 形态（和 WPF 端一致），不生成 MSIX -->
    <WindowsPackageType>None</WindowsPackageType>

    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">24.0</SupportedOSPlatformVersion>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</SupportedOSPlatformVersion>
    <TargetPlatformMinVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</TargetPlatformMinVersion>

    <!-- 工作负载会提供 $(_MauiVersion)；这里留一个兜底值，方便脱离 workload 查看工程结构 -->
    <MauiVersion Condition="'$(MauiVersion)' == ''">10.0.110</MauiVersion>
  </PropertyGroup>

  <ItemGroup>
    <MauiIcon Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\AppIcon\appiconfg.svg" Color="#0B0D12" />
    <MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#0B0D12" BaseSize="128,128" />
    <MauiImage Include="Resources\Images\*" />
    <MauiFont Include="Resources\Fonts\*" />
    <MauiAsset Include="Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebView.Maui" Version="$(MauiVersion)" />
    <PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="10.0.12" />
  </ItemGroup>

  <!-- DPAPI：Windows 宿主与 WPF 共用密文；Android 走 AES-GCM，不需要这个包 -->
  <ItemGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.0.8" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SDemo.DesktopAgent.Core\SDemo.DesktopAgent.Core.csproj" />
    <ProjectReference Include="..\SDemo.DesktopAgent.UI\SDemo.DesktopAgent.UI.csproj" />
  </ItemGroup>

  <!-- Windows 目标额外引用 Windows 专属实现（沙箱）；Android 只有 UnavailableSandbox，不能引用。 -->
  <ItemGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">
    <ProjectReference Include="..\SDemo.DesktopAgent.Windows\SDemo.DesktopAgent.Windows.csproj" />
  </ItemGroup>

  <!-- 内置插件：Windows 目标与 WPF 端一致，复制到输出目录的 plugins\ 下。
       Android 的输出目录不是可读的应用数据目录，内置插件要等 M5 之后再改成 MauiAsset 方案。 -->
  <ItemGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">
    <None Include="..\..\plugins\**\*"
          Link="plugins\%(RecursiveDir)%(Filename)%(Extension)"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
