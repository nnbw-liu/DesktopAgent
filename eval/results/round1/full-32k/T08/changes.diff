+public class UnParserSettings
+{
+    public bool SkipDefault { get; set; }
+    public bool GroupSwitchesOnly { get; set; }
+    public bool UseEqualTokenOnly { get; set; }
+
+    public static UnParserSettings WithGroupSwitchesOnly()
+    {
+        return new UnParserSettings { GroupSwitchesOnly = true };
+    }
+
+    public static UnParserSettings WithUseEqualTokenOnly()
+    {
+        return new UnParserSettings { UseEqualTokenOnly = true };
+    }
+
+    public static UnParserSettings WithSkipDefaultOnly()
+    {
+        return new UnParserSettings { SkipDefault = true };
+    }
+}
