+using Microsoft.VisualStudio.TestTools.UnitTesting;
+
+namespace UnParserTests
+{
+    [TestClass]
+    public class UnParserSettingsTests
+    {
+        [TestMethod]
+        public void WithSkipDefaultOnly_ShouldOnlySetSkipDefault()
+        {
+            var settings = UnParserSettings.WithSkipDefaultOnly();
+            Assert.IsTrue(settings.SkipDefault);
+            Assert.IsFalse(settings.GroupSwitchesOnly);
+            Assert.IsFalse(settings.UseEqualTokenOnly);
+        }
+    }
+}
