+        private static string TrimUnescapedQuotes(string value)
+        {
+            var start = 0;
+            var end = value.Length - 1;
+
+            while (start <= end && value[start] == '"' && !IsEscaped(value, start))
+                start++;
+
+            while (end >= start && value[end] == '"' && !IsEscaped(value, end))
+                end--;
+
+            if (start == 0 && end == value.Length - 1)
+                return value;
+
+            return start > end ? string.Empty : value.Substring(start, end - start + 1);
+        }
+
+        private static bool IsEscaped(string value, int index)
+        {
+            var backslashes = 0;
+            for (var i = index - 1; i >= 0 && value[i] == '\\'; i--)
+                backslashes++;
+
+            return backslashes % 2 == 1;
+        }
+
+        private static string UnescapeQuotes(string value)
+        {
+            return value.IndexOf('\\') < 0 ? value : value.Replace("\\\"", "\"");
+        }
