@@ -0,0 +1,50 @@
+using System;
+using Xunit;
+using Unparser;
+
+namespace Unparser.Tests
+{
+    public class UnParserSettingsTests
+    {
+        [Fact]
+        public void WithSkipDefaultOnly_ShouldSetSkipDefaultToTrue()
+        {
+            var settings = UnParserSettings.WithSkipDefaultOnly();
+            
+            Assert.True(settings.SkipDefault);
+            Assert.False(settings.GroupSwitchesOnly);
+            Assert.False(settings.UseEqualTokenOnly);
+        }
+
+        [Fact]
+        public void WithGroupSwitchesOnly_ShouldNotAffectSkipDefault()
+        {
+            var settings = UnParserSettings.WithGroupSwitchesOnly();
+            
+            Assert.True(settings.GroupSwitchesOnly);
+            Assert.False(settings.SkipDefault);
+            Assert.False(settings.UseEqualTokenOnly);
+        }
+
+        [Fact]
+        public void WithUseEqualTokenOnly_ShouldNotAffectSkipDefault()
+        {
+            var settings = UnParserSettings.WithUseEqualTokenOnly();
+            
+            Assert.True(settings.UseEqualTokenOnly);
+            Assert.False(settings.SkipDefault);
+            Assert.False(settings.GroupSwitchesOnly);
+        }
+
+        [Fact]
+        public void WithSkipDefaultOnly_ShouldNotAffectOtherSwitches()
+        {
+            var settings = UnParserSettings.WithSkipDefaultOnly();
+            
+            // 确认只设置了 SkipDefault，其他开关保持默认值（false）
+            Assert.True(settings.SkipDefault);
+            Assert.False(settings.GroupSwitchesOnly, "WithSkipDefaultOnly 不应打开 GroupSwitchesOnly");
+            Assert.False(settings.UseEqualTokenOnly, "WithSkipDefaultOnly 不应打开 UseEqualTokenOnly");
+        }
+    }
+}
