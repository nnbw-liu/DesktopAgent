+using System;
+using Unparser;
+
+namespace Unparser.Examples
+{
+    // 模拟一个带默认值的对象结构
+    public class SampleObject
+    {
+        public string Name { get; set; } = "default_name";
+        public int Value { get; set; } = 42;
+        public bool Flag { get; set; } = false;
+    }
+
+    // 模拟反解析器，演示如何使用 WithSkipDefaultOnly()
+    public class UnParserExample
+    {
+        public static void Main(string[] args)
+        {
+            Console.WriteLine("=== UnParserSettings 示例 ===\n");
+
+            // 1. 使用 WithSkipDefaultOnly() 创建设置对象
+            var settings = UnParserSettings.WithSkipDefaultOnly();
+            
+            Console.WriteLine($"设置状态:");
+            Console.WriteLine($"  SkipDefault: {settings.SkipDefault}");
+            Console.WriteLine($"  GroupSwitchesOnly: {settings.GroupSwitchesOnly}");
+            Console.WriteLine($"  UseEqualTokenOnly: {settings.UseEqualTokenOnly}\n");
+
+            // 2. 验证只设置了 SkipDefault，其他开关保持默认值（false）
+            if (settings.SkipDefault && !settings.GroupSwitchesOnly && !settings.UseEqualTokenOnly)
+            {
+                Console.WriteLine("✓ WithSkipDefaultOnly() 工作正常：只设置 SkipDefault，不影响其他开关");
+            }
+            else
+            {
+                Console.WriteLine("✗ WithSkipDefaultOnly() 工作异常");
+                Environment.Exit(1);
+            }
+
+            // 3. 模拟反解析行为（当 SkipDefault=true 时，默认值项会被省略）
+            Console.WriteLine("\n=== 模拟反解析行为 ===");
+            
+            var sampleObj = new SampleObject();
+            Console.WriteLine($"原始对象: Name={sampleObj.Name}, Value={sampleObj.Value}, Flag={sampleObj.Flag}");
+
+            // 当 SkipDefault=true 时，反解析器会省略默认值项
+            if (settings.SkipDefault)
+            {
+                Console.WriteLine("\n当 SkipDefault=true 时，反解析器将省略默认值项:");
+                Console.WriteLine("  - Name 将被省略（因为它是默认值）");
+                Console.WriteLine("  - Value 将被省略（因为它是默认值）");
+                Console.WriteLine("  - Flag 将被省略（因为它是默认值）");
+            }
+
+            // 4. 对比其他工厂方法
+            Console.WriteLine("\n=== 对比其他工厂方法 ===");
+            
+            var groupOnly = UnParserSettings.WithGroupSwitchesOnly();
+            Console.WriteLine($"WithGroupSwitchesOnly(): GroupSwitchesOnly={groupOnly.GroupSwitchesOnly}, SkipDefault={groupOnly.SkipDefault}");
+
+            var equalOnly = UnParserSettings.WithUseEqualTokenOnly();
+            Console.WriteLine($"WithUseEqualTokenOnly(): UseEqualTokenOnly={equalOnly.UseEqualTokenOnly}, SkipDefault={equalOnly.SkipDefault}");
+
+            Console.WriteLine("\n=== 完成 ===");
+        }
+    }
+}
