+        [Fact]
+        public static void AgentEval_PreferShortName_UsesShortWhenAvailable()
+        {
+            var options = new Simple_Options { ShortAndLong = "value" };
+
+            new Parser()
+                .FormatCommandLine(options, config => config.PreferShortName = true)
+                .Should().BeEquivalentTo("-s value");
+        }
+
+        [Fact]
+        public static void AgentEval_PreferShortName_FallsBackToLong()
+        {
+            var options = new Simple_Options { StringValue = "nospaces" };
+
+            new Parser()
+                .FormatCommandLine(options, config => config.PreferShortName = true)
+                .Should().BeEquivalentTo("--stringvalue nospaces");
+        }
+
+        [Fact]
+        public static void AgentEval_PreferShortName_DoesNotAffectSwitches()
+        {
+            var options = new Simple_Options { BoolValue = true, ShortAndLong = "value" };
+
+            new Parser()
+                .FormatCommandLine(options, config => config.PreferShortName = true)
+                .Should().BeEquivalentTo("-s value -x");
+        }
