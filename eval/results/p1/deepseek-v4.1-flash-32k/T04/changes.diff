+        private static string RemoveQuote(this string value)
+        {
+            if (value.Length > 0 && value[0] == '"')
+                value = value.Substring(1);
+            if (value.Length > 0 && value[value.Length - 1] == '"')
+                value = value.Substring(0, value.Length - 1);
+            return value;
+        }
