@@ -0,0 +1,29 @@
+using System;
+using Xunit;
+
+namespace Unparser.Tests
+{
+    public class UnParserSettingsTests
+    {
+        [Fact]
+        public void WithSkipDefaultOnly_ShouldSetSkipDefaultToTrue()
+        {
+            var settings = UnParserSettings.WithSkipDefaultOnly();
+            Assert.True(settings.SkipDefault); // 当 skipDefault 为 false 时，SkipDefault 属性应为 true
+        }
+
+        [Fact]
+        public void WithSkipDefaultOnly_ShouldNotSetGroupSwitchesOnly()
+        {
+            var settings = UnParserSettings.WithSkipDefaultOnly();
+            Assert.False(settings.GroupSwitchesOnly); // 不应设置 groupSwitchesOnly
+        }
+
+        [Fact]
+        public void WithSkipDefaultOnly_ShouldNotSetUseEqualTokenOnly()
+        {
+            var settings = UnParserSettings.WithSkipDefaultOnly();
+            Assert.False(settings.UseEqualTokenOnly); // 不应设置 useEqualTokenOnly
+        }
+    }
+}
