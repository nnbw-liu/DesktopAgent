+using System;
+using System.Collections.Generic;
+using System.Linq;
+
+namespace Unparser
+{
+    public class UnParserSettings
+    {
+        private bool _groupSwitchesOnly = false;
+        private bool _useEqualTokenOnly = false;
+        private bool _skipDefault = true; // 默认跳过默认值
+
+        public bool GroupSwitchesOnly => _groupSwitchesOnly;
+        public bool UseEqualTokenOnly => _useEqualTokenOnly;
+        public bool SkipDefault => !_skipDefault; // 当 skipDefault 为 false 时，才不跳过默认值
+
+        private UnParserSettings() { }
+
+        public static UnParserSettings WithGroupSwitchesOnly()
+        {
+            var settings = new UnParserSettings();
+            settings._groupSwitchesOnly = true;
+            return settings;
+        }
+
+        public static UnParserSettings WithUseEqualTokenOnly()
+        {
+            var settings = new UnParserSettings();
+            settings._useEqualTokenOnly = true;
+            return settings;
+        }
+
+        public static UnParserSettings WithSkipDefaultOnly()
+        {
+            var settings = new UnParserSettings();
+            settings._skipDefault = false; // 设置 skipDefault 为 false，表示不跳过默认值
+            return settings;
+        }
+    }
+}
