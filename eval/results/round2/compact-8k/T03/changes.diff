+using System;
+using Xunit;
+using CommandLine;
+
+namespace CommandLine.Tests.Unit.AgentEval.T03Tests
+{
+    public partial class T03Tests
+    {
+        [Fact]
+        public void HelpText_width_rejects_non_positive_values()
+        {
+            var options = new Options();
+            
+            var helpText = new HelpText();
+            Assert.Throws<ArgumentOutOfRangeException>(() => options.HelpText.MaximumDisplayWidth = 0);
+            Assert.Throws<ArgumentOutOfRangeException>(() => options.HelpText.MaximumDisplayWidth = -10);
+        }
+
+        [Fact]
+        public void HelpText_width_accepts_positive_values()
+        {
+            var options = new Options();
+            
+            var helpText = new HelpText();
+            options.HelpText.MaximumDisplayWidth = 40;
+            Assert.Equal(40, options.HelpText.MaximumDisplayWidth);
+        }
+    }
+}
