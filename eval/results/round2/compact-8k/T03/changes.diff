@@ -0,0 +1,32 @@
+using System;
+
+namespace CommandLine.Help
+{
+    public class HelpText : IEquatable<HelpText>
+    {
+        private readonly int _maximumDisplayWidth;
+
+        public int MaximumDisplayWidth
+        {
+            get => _maximumDisplayWidth;
+            set
+            {
+                if (value < 1)
+                {
+                    throw new ArgumentOutOfRangeException(nameof(MaximumDisplayWidth));
+                }
+                _maximumDisplayWidth = value;
+            }
+        }
+
+        public HelpText()
+        {
+            MaximumDisplayWidth = CalculateDefaultWidth();
+        }
+
+        private int CalculateDefaultWidth()
+        {
+            return 40;
+        }
+    }
+}
