+using System;
+
+namespace ProjectName
+{
+    public class HelpText
+    {
+        private int _maximumDisplayWidth;
+
+        public HelpText()
+        {
+            // 构造函数默认宽度推断逻辑保持不变
+            _maximumDisplayWidth = CalculateDefaultWidth();
+        }
+
+        public int MaximumDisplayWidth
+        {
+            get => _maximumDisplayWidth;
+            set
+            {
+                if (value < 1)
+                {
+                    throw new ArgumentOutOfRangeException(nameof(value), "MaximumDisplayWidth must be at least 1.");
+                }
+                _maximumDisplayWidth = value;
+            }
+        }
+
+        private int CalculateDefaultWidth()
+        {
+            // 默认宽度推断逻辑，保持不变
+            return 40;
+        }
+    }
+}
