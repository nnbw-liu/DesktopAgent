<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Windows 集成测试：S0 只测契约 / 选择策略 / DI；S1 之后加 AppContainer 真机用例。 -->
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.12" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\SDemo.DesktopAgent.Windows\SDemo.DesktopAgent.Windows.csproj" />
    <ProjectReference Include="..\..\src\SDemo.DesktopAgent.Core\SDemo.DesktopAgent.Core.csproj" />
    <ProjectReference Include="..\..\src\SDemo.DesktopAgent.Sandbox.Contracts\SDemo.DesktopAgent.Sandbox.Contracts.csproj" />
    <ProjectReference Include="..\..\src\SDemo.DesktopAgent.SandboxHost\SDemo.DesktopAgent.SandboxHost.csproj"
                      ReferenceOutputAssembly="false" />
  </ItemGroup>

  <!-- 测试 / 本地运行时把 SandboxHost 发布文件放到 sandbox-host，安装器会复制到沙箱根目录。 -->
  <Target Name="CopySandboxHostPayload" AfterTargets="Build">
    <ItemGroup>
      <SandboxHostFiles Include="$(MSBuildProjectDirectory)\..\..\src\SDemo.DesktopAgent.SandboxHost\bin\$(Configuration)\net10.0-windows10.0.19041.0\**\*.*" />
    </ItemGroup>
    <Copy SourceFiles="@(SandboxHostFiles)"
          DestinationFolder="$(OutDir)sandbox-host\%(RecursiveDir)"
          SkipUnchangedFiles="true" />
  </Target>

</Project>
